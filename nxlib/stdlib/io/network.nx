/** net: HTTP networking operations. */
import { length as str_length, substring, index_of, to_i64_raw } from "std:str"
import * as bb from "std:bytebuffer"
import { ByteBuffer } from "std:bytebuffer"
import { ssrf_is_blocked as _ssrf_is_blocked } from "std:io/network/ssrf"
import { starts_with, byte_length } from "std:str"
import * as mem from "std:runtime/mem"
import * as arena from "std:runtime/arena"
import { Coop } from "std:concurrency/coop"
import { p3_fields_new, p3_request_new, p3_set_scheme, p3_set_authority, p3_set_path,
         p3_set_method, p3_fields_append, p3_send, p3_status_code, p3_get_headers,
         p3_fields_copy_all, p3_fields_drop, p3_consume_body, p3_trailers_new,
         p3_trailers_write, p3_trailers_drop_readable, p3_trailers_drop_writable, p3_body_result_new, p3_body_new,
         p3_body_read, p3_body_write, p3_body_drop_writable, p3_body_drop_readable,
         p3_result_drop_writable, p3_result_drop_readable, p3_result_write, await_event, await_subtask,
         scratch, copy_blocked, append_bytes, lo32, hi32, i64_of, s_ptr,
         s_len } from "std:runtime/p3"
import external "nexus_net"

/** Raised when an HTTP request fails. */
export exception RequestError(url: string)

/** Raised when a server fails to bind to an address. */
export exception BindError(addr: string)

/** Raised when sending an HTTP response fails. */
export exception ResponseError(msg: string)

/**
Group covering every exception raised by network operations.
Members are RequestError, BindError, ResponseError. The group exists
so file-level callers route network errors through a stable group
name instead of the universal Exn. The cap Net and system_handler
keep their { Exn } rows: those are the public capability contract
and narrowing them ripples to every Net consumer.
*/
export exception group NetError = RequestError | BindError | ResponseError

/** An HTTP header with a name and value. */
export type Header = Header(name: string, value: string)

/** An HTTP response with a status code, headers, and body. */
export type Response = Response(status: i64, headers: string, body: string)

/** A running HTTP server handle (linear — must be stopped). */
export opaque type Server = Server(id: i64)

/** An incoming HTTP request (linear — must be answered with respond). */
export opaque type Request = Request(
  method: string,
  path: string,
  headers: string,
  body: string,
  req_id: i64
)

/**
A streaming response in progress (linear — must be terminated with
`respond_streaming_finish` after one or more `respond_streaming_write`
calls). Created by `respond_streaming_start`, which consumes the linear
`Request`.
*/
export opaque type RespondStream = RespondStream(req_id: i64)

/** Split-at-newline carrier: the head before the separator and the
 *  rest of the buffer after it. Used by the request-decoder pipeline to
 *  thread a single string through repeated `\n`-separated extractions
 *  without churning anonymous-record types at every step.
 */
type HeaderSplit = HeaderSplit(head: string, rest: string)

// These externals import from the core module `nexus_net`, which only a
// component build (--p2-component / --p3-component) provides: its adapter bridges http_request to wasi:http
// and http_listen/accept/respond/stop to wasi:sockets/tcp. A core-module build leaves them
// unresolved, so a program that uses Net does not instantiate.
/** HTTP GET/POST/etc via the p2 bridge. Params are method, url, headers, body;
 *  returns the raw encoded response string.
 */
external w_http_request = "http_request" : (
  a_method: string,
  b_url: string,
  c_headers: string,
  d_body: string
) -> string

let http_request = fn (method: string, url: string, headers: string, body: string) -> string do
  return w_http_request(a_method: method, b_url: url, c_headers: headers, d_body: body)
end

external w_http_listen = "http_listen" : (a_addr: string) -> i64
external w_http_accept = "http_accept" : (a_server_id: i64) -> string
external w_http_respond = "http_respond" : (
  a_req_id: i64,
  b_status: i64,
  c_headers: string,
  d_body: string
) -> bool
external w_http_stop = "http_stop" : (a_server_id: i64) -> bool

let http_listen = fn (addr: string) -> i64 do return w_http_listen(a_addr: addr) end
let http_accept = fn (server_id: i64) -> string do return w_http_accept(a_server_id: server_id) end
let http_respond = fn (
  req_id: i64,
  status: i64,
  headers: string,
  body: string
) -> bool do return w_http_respond(
  a_req_id: req_id,
  b_status: status,
  c_headers: headers,
  d_body: body
) end
let http_stop = fn (server_id: i64) -> bool do return w_http_stop(a_server_id: server_id) end
// Unimplemented streaming/timeout stubs — current behavior:
// respond_streaming_start and respond_streaming_finish throw ResponseError.
// respond_streaming_write returns false (signal: write failed).
// cancel_accept returns false (signal: cancel not accepted).
// request_with_timeout delegates to request when timeout_ms=0, else throws RequestError.

// ── SSRF guard (implemented in network/ssrf.nx) ───────────────────────────────
// Re-exported here so `std:network` consumers (and tests) can import
// ssrf_is_blocked from this stable public path.

/** SSRF guard: returns true if the URL target host is blocked.
 *  Checks loopback, private, link-local, metadata, ULA, multicast,
 *  broadcast, and IPv4-mapped private ranges, plus well-known
 *  localhost/cloud-metadata hostnames.
 *  Exported for testability; not part of the Net capability surface.
 */
export let ssrf_is_blocked = fn (url: string) -> bool do
  return _ssrf_is_blocked(url)
end

// ── end SSRF guard ─────────────────────────────────────────────────────────────

/** Create a Header. */
export let header = fn (name: string, value: string) -> Header do
  return Header(name, value)
end

/**
Canonical bridge headers format: 'name:value\n' per header, no space
after the colon, single-`\n` terminator, no trailing blank line. The
host bridge converts to/from HTTP/1.1 wire form ('name: value\r\n')
only at the socket boundary. Spec note: a documented wire-format spec
belongs in docs/spec/net.md; that submodule is read-only from this
worktree, so the canonical form is pinned in source comments and
tests until a doc-update issue lands.
*/
let encode_headers_go = fn (buf: %ByteBuffer, headers: [ Header ]) -> %ByteBuffer do
  match headers do
    | [] -> return buf
    | Header(name, value) :: rest ->
      let %buf = bb.push_string(%buf, s: name)
      let %buf = bb.push_string(%buf, s: ":")
      let %buf = bb.push_string(%buf, s: value)
      let %buf = bb.push_string(%buf, s: "\n")
      return encode_headers_go(%buf, headers: rest)
  end
end

let encode_headers = fn (headers: [ Header ]) -> string do
  let buf = bb.empty()
  let %buf = encode_headers_go(%buf, headers)
  let result = bb.to_string(&buf)
  bb.free(%buf)
  return result
end

let decode_response = fn (raw: string) -> Response do
  let sep1 = index_of(s: raw, sub: "\n")
  if sep1 < 0 then
    return Response(status: 0, headers: "", body: raw)
  else
    let status_s = substring(s: raw, start: 0, len: sep1)
    let status = to_i64_raw(s: status_s)
    let rest1_start = sep1 + 1
    let rest1_len = str_length(s: raw) - rest1_start
    let rest1 = substring(s: raw, start: rest1_start, len: rest1_len)
    let sep2 = index_of(s: rest1, sub: "\n")
    if sep2 < 0 then
      return Response(status, headers: "", body: rest1)
    else
      let hlen_s = substring(s: rest1, start: 0, len: sep2)
      let hlen = to_i64_raw(s: hlen_s)
      let content_start = sep2 + 1
      let headers_s = substring(s: rest1, start: content_start, len: hlen)
      let body_start = content_start + hlen
      let body_len = str_length(s: rest1) - body_start
      let body_s = substring(s: rest1, start: body_start, len: body_len)
      return Response(status, headers: headers_s, body: body_s)
    end
  end
end

let split_at_newline = fn (s: string) -> HeaderSplit do
  let sep = index_of(s, sub: "\n")
  if sep < 0 then
    return HeaderSplit(head: s, rest: "")
  else
    let head = substring(s, start: 0, len: sep)
    let rest_start = sep + 1
    let rest_len = str_length(s) - rest_start
    let rest = substring(s, start: rest_start, len: rest_len)
    return HeaderSplit(head, rest)
  end
end

let decode_request = fn (raw: string) -> %Request do
  let HeaderSplit(head: req_id_s, rest: rest1) = split_at_newline(s: raw)
  if str_length(s: req_id_s) == 0 then
    let r = Request(method: "", path: "", headers: "", body: "", req_id: -1)
    let %lr = r
    return %lr
  end
  let req_id = to_i64_raw(s: req_id_s)
  let HeaderSplit(head: method, rest: rest2) = split_at_newline(s: rest1)
  let HeaderSplit(head: path, rest: rest3) = split_at_newline(s: rest2)
  let HeaderSplit(head: headers, rest: body) = split_at_newline(s: rest3)
  let r = Request(method, path, headers, body, req_id)
  let %lr = r
  return %lr
end

/** Extract the status code from a Response. */
let response_status = fn (res: Response) -> i64 do
  let Response(status, headers: _, body: _) = res
  return status
end

/** Extract the body from a Response. */
let response_body = fn (res: Response) -> string do
  let Response(status: _, headers: _, body) = res
  return body
end

/** Extract the method from a Request (borrowed). */
export let request_method = fn (req: &Request) -> string do
  let Request(method: m, path: _, headers: _, body: _, req_id: _) = req
  return m
end

/** Extract the path from a Request (borrowed). */
export let request_path = fn (req: &Request) -> string do
  let Request(method: _, path: p, headers: _, body: _, req_id: _) = req
  return p
end

/** HTTP GET request. Returns the response body. Raises on failure.
 *  SSRF guard: blocks private/loopback/link-local/metadata hosts before connecting.
 */
let get = fn (url: string) -> string throws { RequestError } do
  if ssrf_is_blocked(url) then
    throw RequestError(url)
  else
    let res = decode_response(raw: http_request(method: "GET", url, headers: "", body: ""))
    if response_status(res) == 0 then
      throw RequestError(url)
    else
      return response_body(res)
    end
  end
end

/** HTTP request with custom method and raw header string. Raises on failure.
 *  SSRF guard: blocks private/loopback/link-local/metadata hosts before connecting.
 */
let request_raw = fn (
  method: string,
  url: string,
  headers: string,
  body: string
) -> Response throws { RequestError } do
  if ssrf_is_blocked(url) then
    throw RequestError(url)
  else
    let res = decode_response(raw: http_request(method, url, headers, body))
    if response_status(res) == 0 then
      throw RequestError(url)
    else
      return res
    end
  end
end

/** HTTP request with typed headers. Raises on failure. */
let request = fn (
  method: string,
  url: string,
  headers: [ Header ],
  body: string
) -> Response throws { RequestError } do
  let encoded = encode_headers(headers)
  return request_raw(method, url, headers: encoded, body)
end

/** Start listening on the given address. Returns a linear server handle. Raises on failure. */
let listen = fn (addr: string) -> %Server throws { BindError } do
  let id = http_listen(addr)
  if id < 0 then
    throw BindError(addr)
  else
    let s = Server(id)
    let %ls = s
    return %ls
  end
end

/**
Accept an incoming request from a server (borrows server handle).
Returns a linear Request — caller must respond to release host-side resources.
*/
let accept = fn (server: &Server) -> %Request do
  let Server(id) = server
  let raw = http_accept(server_id: id)
  return decode_request(raw)
end

/** Respond to an incoming request. Consumes the linear Request. Raises on failure. */
let respond = fn (req: %Request, status: i64, body: string) -> unit throws { ResponseError } do
  let Request(method: _, path: _, headers: _, body: _, req_id: rid) = req
  let ok = http_respond(req_id: rid, status, headers: "", body)
  if ok then
    return ()
  else
    throw ResponseError(msg: "failed to send response")
  end
end

/** Respond to an incoming request with custom headers. Consumes the linear Request. Raises on failure. */
let respond_with_headers = fn (
  req: %Request,
  status: i64,
  headers: [ Header ],
  body: string
) -> unit throws { ResponseError } do
  let Request(method: _, path: _, headers: _, body: _, req_id: rid) = req
  let encoded = encode_headers(headers)
  let ok = http_respond(req_id: rid, status, headers: encoded, body)
  if ok then
    return ()
  else
    throw ResponseError(msg: "failed to send response")
  end
end

/** Stop a server (consumes the linear handle). */
let stop = fn (server: %Server) -> unit do
  let Server(id) = server
  http_stop(server_id: id)
  return ()
end

/**
Streaming response: open a chunked response on the wire and return a
linear `RespondStream` handle. Consumes the linear `Request`. Use
`respond_streaming_write` to append chunks (any number of times), then
`respond_streaming_finish` to terminate. Raises on failure.

Not yet implemented: always raises `ResponseError`. A real implementation
requires a p2 streaming bridge (wasi:http/outgoing-handler body-stream)
that has not been built yet.
*/
let respond_streaming_start = fn (
  req: %Request,
  status: i64,
  headers: [ Header ]
) -> %RespondStream throws { ResponseError } do
  let Request(method: _, path: _, headers: _, body: _, req_id: _) = req
  throw ResponseError(msg: "not implemented: streaming responses require a p2 streaming bridge")
end

/**
Append a chunk to a streaming response (borrows the handle). Returns true
on success, false on failure (including when the stream was never opened).

Not yet implemented: always returns false. A real implementation
requires a p2 streaming bridge.
*/
let respond_streaming_write = fn (stream: &RespondStream, chunk: string) -> bool do
  let RespondStream(req_id: _) = stream
  return false
end

/**
Terminate a streaming response. Consumes the linear `RespondStream`.
Raises on failure.

Not yet implemented: always raises `ResponseError`. A real implementation
requires a p2 streaming bridge.
*/
let respond_streaming_finish = fn (stream: %RespondStream) -> unit throws { ResponseError } do
  let RespondStream(req_id: _) = stream
  throw ResponseError(msg: "not implemented: streaming responses require a p2 streaming bridge")
end

/**
HTTP request with custom method, headers, body, and a per-call
timeout (milliseconds). `timeout_ms = 0` delegates to the standard
`request` (no timeout). A non-zero `timeout_ms` always raises `RequestError`
because per-call timeout support requires a host bridge that has not been
implemented yet (wasi:http/outgoing-handler options). Raises `RequestError`
on failure. SSRF guard: blocks private/loopback/link-local/metadata hosts
before connecting.
*/
let request_with_timeout = fn (
  method: string,
  url: string,
  headers: [ Header ],
  body: string,
  timeout_ms: i64
) -> Response throws { RequestError } do
  if ssrf_is_blocked(url) then
    throw RequestError(url)
  else
    return request_with_timeout_go(method, url, headers, body, timeout_ms)
  end
end

let request_with_timeout_go = fn (
  method: string,
  url: string,
  headers: [ Header ],
  body: string,
  timeout_ms: i64
) -> Response throws { RequestError } do
  if timeout_ms == 0 then
    return request(method, url, headers, body)
  else
    throw RequestError(url)
  end
end

/**
Cancel a running server's blocking `accept`. Borrows the server handle
(does not consume it; the linear `Server` must still be released by
`stop`). Idempotent. Returns true if the cancel was accepted.

Not yet implemented: always returns false. A real implementation requires
a p2 socket bridge with a cancel/interrupt mechanism.
*/
let cancel_accept = fn (server: &Server) -> bool do
  let Server(id: _) = server
  return false
end

export cap Net do
  fn get(url: string) -> string throws { RequestError }
  fn request(
    method: string,
    url: string,
    headers: [ Header ],
    body: string
  ) -> Response throws { RequestError }
  fn listen(addr: string) -> %Server throws { BindError }
  fn accept(server: &Server) -> %Request
  fn respond(req: %Request, status: i64, body: string) -> unit throws { ResponseError }
  fn respond_with_headers(
    req: %Request,
    status: i64,
    headers: [ Header ],
    body: string
  ) -> unit throws { ResponseError }
  fn stop(server: %Server) -> unit
  fn respond_streaming_start(
    req: %Request,
    status: i64,
    headers: [ Header ]
  ) -> %RespondStream throws { ResponseError }
  fn respond_streaming_write(stream: &RespondStream, chunk: string) -> bool
  fn respond_streaming_finish(stream: %RespondStream) -> unit throws { ResponseError }
  fn request_with_timeout(
    method: string,
    url: string,
    headers: [ Header ],
    body: string,
    timeout_ms: i64
  ) -> Response throws { RequestError }
  fn cancel_accept(server: &Server) -> bool
end

/** Default Net handler — delegates to direct-call API. */
export let system_handler = handler Net require { PermNet } do
  fn get(url: string) -> string throws { RequestError } do
    return get(url)
  end
  fn request(
    method: string,
    url: string,
    headers: [ Header ],
    body: string
  ) -> Response throws { RequestError } do
    return request(method, url, headers, body)
  end
  fn listen(addr: string) -> %Server throws { BindError } do
    return listen(addr)
  end
  fn accept(server: &Server) -> %Request do
    return accept(server)
  end
  fn respond(req: %Request, status: i64, body: string) -> unit throws { ResponseError } do
    return respond(req, status, body)
  end
  fn respond_with_headers(
    req: %Request,
    status: i64,
    headers: [ Header ],
    body: string
  ) -> unit throws { ResponseError } do
    return respond_with_headers(req, status, headers, body)
  end
  fn stop(server: %Server) -> unit do
    return stop(server)
  end
  fn respond_streaming_start(
    req: %Request,
    status: i64,
    headers: [ Header ]
  ) -> %RespondStream throws { ResponseError } do
    return respond_streaming_start(req, status, headers)
  end
  fn respond_streaming_write(stream: &RespondStream, chunk: string) -> bool do
    return respond_streaming_write(stream, chunk)
  end
  fn respond_streaming_finish(stream: %RespondStream) -> unit throws { ResponseError } do
    return respond_streaming_finish(stream)
  end
  fn request_with_timeout(
    method: string,
    url: string,
    headers: [ Header ],
    body: string,
    timeout_ms: i64
  ) -> Response throws { RequestError } do
    return request_with_timeout(method, url, headers, body, timeout_ms)
  end
  fn cancel_accept(server: &Server) -> bool do
    return cancel_accept(server)
  end
end

// ── Cooperative client (--p3-component) ──────────────────────────────────────
// `coop_handler`'s client methods send through wasi:http/client@0.3.0 and wait
// with std:runtime/p3, so the requests of different std:concurrency/coop tasks
// overlap. Its server methods are `system_handler`'s.

type UrlParts = UrlParts(https: bool, authority: string, path: string)

let split_url = fn (url: string) -> UrlParts throws { RequestError } do
  let https = starts_with(s: url, prefix: "https://")
  if !https && !starts_with(s: url, prefix: "http://") then throw RequestError(url) end
  let start = if https then 8 else 7 end
  let rest = substring(s: url, start, len: byte_length(s: url) - start)
  let slash = index_of(s: rest, sub: "/")
  if slash < 0 then return UrlParts(https, authority: rest, path: "/") end
  return UrlParts(
    https,
    authority: substring(s: rest, start: 0, len: slash),
    path: substring(s: rest, start: slash, len: byte_length(s: rest) - slash)
  )
end

/** Case index of `method` in wasi:http's `method` variant (9 = other). */
let method_case = fn (method: string) -> i64 do
  if method == "GET" then return 0 end
  if method == "HEAD" then return 1 end
  if method == "POST" then return 2 end
  if method == "PUT" then return 3 end
  if method == "DELETE" then return 4 end
  if method == "CONNECT" then return 5 end
  if method == "OPTIONS" then return 6 end
  if method == "TRACE" then return 7 end
  if method == "PATCH" then return 8 end
  return 9
end

let append_headers = fn (fields: i32, headers: [ Header ]) -> unit do
  match headers do
    | [] -> return ()
    | Header(name, value) :: rest ->
      p3_fields_append(
        a_fields: fields,
        b_name_ptr: s_ptr(s: name),
        c_name_len: s_len(s: name),
        d_value_ptr: s_ptr(s: value),
        e_value_len: s_len(s: value),
        f_ret: lo32(x: scratch(n: 4))
      )
      return append_headers(fields, headers: rest)
  end
end

/** Write `n` bytes at `p` to body stream `s`; false if the reader dropped it. */
let write_body = fn (s: i64, p: i64, n: i64) -> bool require { Coop } do
  if n <= 0 then return true end
  let r = i64_of(x: p3_body_write(a_s: lo32(x: s), b_ptr: lo32(x: p), c_len: lo32(x: n)))
  let payload = if r == copy_blocked() then await_event(h: s) else r end
  let k = payload >> 4
  if (payload & 15) != 0 && k < n then return false end
  return write_body(s, p: p + k, n: n - k)
end

let read_body = fn (s: i64, chunk: i64, buf: %ByteBuffer) -> %ByteBuffer require { Coop } do
  let r = i64_of(x: p3_body_read(a_s: lo32(x: s), b_ptr: lo32(x: chunk), c_len: lo32(x: 4096)))
  let payload = if r == copy_blocked() then await_event(h: s) else r end
  let %buf = append_bytes(buf: %buf, p: chunk, n: payload >> 4)
  if (payload & 15) != 0 then return %buf end
  return read_body(s, chunk, buf: %buf)
end

/** Encode `count` (name, value) entries at `p` as `name:value\n` lines. */
let encode_fields = fn (buf: %ByteBuffer, p: i64, count: i64) -> %ByteBuffer do
  if count <= 0 then return %buf end
  let %buf = append_bytes(buf: %buf, p: mem.load_i32(addr: p), n: mem.load_i32(addr: p + 4))
  let %buf = bb.push_string(%buf, s: ":")
  let %buf = append_bytes(buf: %buf, p: mem.load_i32(addr: p + 8), n: mem.load_i32(addr: p + 12))
  let %buf = bb.push_string(%buf, s: "\n")
  return encode_fields(buf: %buf, p: p + 16, count: count - 1)
end

let response_headers = fn (resp: i64) -> string do
  let h = p3_get_headers(a_resp: lo32(x: resp))
  let ret = scratch(n: 1)
  p3_fields_copy_all(a_fields: h, b_ret: lo32(x: ret))
  let %buf = encode_fields(
    buf: bb.empty(),
    p: mem.load_i32(addr: ret),
    count: mem.load_i32(addr: ret + 4)
  )
  p3_fields_drop(a_fields: h)
  let out = bb.to_string(&buf)
  bb.free(%buf)
  return out
end

let coop_request = fn (
  method: string,
  url: string,
  headers: [ Header ],
  body: string
) -> Response require { Coop } throws { RequestError } do
  if ssrf_is_blocked(url) then throw RequestError(url) end
  let UrlParts(https, authority, path) = split_url(url)
  let fields = p3_fields_new()
  append_headers(fields, headers)
  let has_body = byte_length(s: body) > 0
  let bs = if has_body then p3_body_new() else 0 end
  // The trailers future carries Ok(None): a zeroed payload.
  let tr = p3_trailers_new()
  let tw = i64_of(x: p3_trailers_write(a_w: hi32(x: tr), b_ptr: lo32(x: scratch(n: 16))))
  let ret = scratch(n: 2)
  p3_request_new(
    a_headers: fields,
    b_contents_some: lo32(x: if has_body then 1 else 0 end),
    c_contents: lo32(x: bs),
    d_trailers: lo32(x: tr),
    e_options_some: lo32(x: 0),
    f_options: lo32(x: 0),
    g_ret: lo32(x: ret)
  )
  let req = lo32(x: mem.load_i32(addr: ret))
  let case = method_case(method)
  let _ignored = p3_set_method(
    a_req: req,
    b_method: lo32(x: case),
    c_ptr: if case == 9 then s_ptr(s: method) else lo32(x: 0) end,
    d_len: if case == 9 then s_len(s: method) else lo32(x: 0) end
  )
  let _ignored = p3_set_scheme(
    a_req: req,
    b_some: lo32(x: 1),
    c_scheme: lo32(x: if https then 1 else 0 end),
    d_ptr: lo32(x: 0),
    e_len: lo32(x: 0)
  )
  let _ignored = p3_set_authority(
    a_req: req,
    b_some: lo32(x: 1),
    c_ptr: s_ptr(s: authority),
    d_len: s_len(s: authority)
  )
  let _ignored = p3_set_path(
    a_req: req,
    b_some: lo32(x: 1),
    c_ptr: s_ptr(s: path),
    d_len: s_len(s: path)
  )
  let res = scratch(n: 16)
  let st = i64_of(x: p3_send(a_req: req, b_ret: lo32(x: res)))
  if has_body then
    let _ignored = write_body(
      s: i64_of(x: hi32(x: bs)),
      p: i64_of(x: s_ptr(s: body)),
      n: i64_of(x: s_len(s: body))
    )
    p3_body_drop_writable(a_s: hi32(x: bs))
  end
  await_subtask(st)
  if tw == copy_blocked() then
    let _ignored = await_event(h: i64_of(x: hi32(x: tr)))
  end
  p3_trailers_drop_writable(a_f: hi32(x: tr))
  p3_result_drop_readable(a_f: lo32(x: mem.load_i32(addr: ret + 4)))
  if mem.load_u8(addr: res) != 0 then throw RequestError(url) end
  let resp = mem.load_i32(addr: res + 8)
  let status = i64_of(x: p3_status_code(a_resp: lo32(x: resp)))
  let hdrs = response_headers(resp)
  let rf = p3_body_result_new()
  let cret = scratch(n: 1)
  p3_consume_body(a_resp: lo32(x: resp), b_res: lo32(x: rf), c_ret: lo32(x: cret))
  let s = mem.load_i32(addr: cret)
  let %buf = read_body(s, chunk: arena.alloc_raw(size: 4096), buf: bb.empty())
  p3_body_drop_readable(a_s: lo32(x: s))
  p3_trailers_drop_readable(a_f: lo32(x: mem.load_i32(addr: cret + 4)))
  // Report Ok for the body to the host, then release the write end.
  let w = p3_result_write(a_w: hi32(x: rf), b_ptr: lo32(x: scratch(n: 8)))
  if i64_of(x: w) == copy_blocked() then
    let _ignored = await_event(h: i64_of(x: hi32(x: rf)))
  end
  p3_result_drop_writable(a_f: hi32(x: rf))
  let out = bb.to_string(&buf)
  bb.free(%buf)
  return Response(status, headers: hdrs, body: out)
end

/**
Net handler whose use makes the build a p3 component: `get`, `request` and
`request_with_timeout` (timeout 0) let other std:concurrency/coop tasks run
while the request is in flight, so requests of different tasks overlap. Inject
it inside a `std:concurrency/coop` scheduler. The server methods behave as in
`system_handler`.
*/
export let coop_handler = handler Net require { Coop, PermNet } do
  fn get(url: string) -> string throws { RequestError } do
    let res = coop_request(method: "GET", url, headers: [], body: "")
    return response_body(res)
  end
  fn request(
    method: string,
    url: string,
    headers: [ Header ],
    body: string
  ) -> Response throws { RequestError } do
    return coop_request(method, url, headers, body)
  end
  fn listen(addr: string) -> %Server throws { BindError } do
    return listen(addr)
  end
  fn accept(server: &Server) -> %Request do
    return accept(server)
  end
  fn respond(req: %Request, status: i64, body: string) -> unit throws { ResponseError } do
    return respond(req, status, body)
  end
  fn respond_with_headers(
    req: %Request,
    status: i64,
    headers: [ Header ],
    body: string
  ) -> unit throws { ResponseError } do
    return respond_with_headers(req, status, headers, body)
  end
  fn stop(server: %Server) -> unit do
    return stop(server)
  end
  fn respond_streaming_start(
    req: %Request,
    status: i64,
    headers: [ Header ]
  ) -> %RespondStream throws { ResponseError } do
    return respond_streaming_start(req, status, headers)
  end
  fn respond_streaming_write(stream: &RespondStream, chunk: string) -> bool do
    return respond_streaming_write(stream, chunk)
  end
  fn respond_streaming_finish(stream: %RespondStream) -> unit throws { ResponseError } do
    return respond_streaming_finish(stream)
  end
  fn request_with_timeout(
    method: string,
    url: string,
    headers: [ Header ],
    body: string,
    timeout_ms: i64
  ) -> Response throws { RequestError } do
    if timeout_ms != 0 then throw RequestError(url) end
    return coop_request(method, url, headers, body)
  end
  fn cancel_accept(server: &Server) -> bool do
    return cancel_accept(server)
  end
end
