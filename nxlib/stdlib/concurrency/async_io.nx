/**
 * std:concurrency/async_io: a sleep that suspends only the calling cooperative
 * task (`std:concurrency/coop`), so sleeps in different tasks overlap, and a
 * `Clock` handler built on it. Available only in a --p3-component build: the
 * sleep starts `wasi:clocks/monotonic-clock@0.3.0#wait-for` as an async
 * subtask and waits for it through std:runtime/p3.
 */
import { Clock, now_ms } from "std:clock"
import { Coop } from "std:concurrency/coop"
import { p3_wait_for, await_subtask, i64_of } from "std:runtime/p3"

/** Sleep `ms` milliseconds, letting other cooperative tasks run meanwhile. */
export let sleep = fn (ms: i64) -> unit require { Coop } do
  if ms <= 0 then return () end
  return await_subtask(st: i64_of(x: p3_wait_for(a_ns: ms * 1000000)))
end

/** Clock handler whose `sleep` lets other cooperative tasks run. Inject it
 *  inside a `std:concurrency/coop` scheduler. */
export let clock_handler = handler Clock require { Coop, PermClock } do
  fn sleep(ms: i64) -> unit do
    // `sleep` raises nothing, but its Coop.yield call is a cap call, which the
    // no-throw analysis does not see through; Clock.sleep's row is closed.
    try
      sleep(ms)
    catch _ ->
      ()
    end
    return ()
  end
  fn now() -> i64 do
    return now_ms()
  end
end
