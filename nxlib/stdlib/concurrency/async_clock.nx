/**
 * std:concurrency/async_clock: a sleep that suspends only the calling
 * cooperative task (`std:concurrency/coop`), so sleeps in different tasks
 * overlap. Available only in a --p3-component build: it starts
 * `wasi:clocks/monotonic-clock@0.3.0#wait-for` as an async subtask through the
 * `nexus_p3` core instance and waits for it in a shared waitable set.
 *
 * While its subtask is pending, a sleeping task yields to the other ready
 * tasks. When every queued task is itself waiting on a subtask, it blocks in
 * `waitable-set.wait`, records the subtask that finished, and yields so that
 * task's owner resumes.
 */
import external "nexus_p3"
external p3_wait_for = "wait-for" : (a_ns: i64) -> i32
external p3_ws_new = "ws-new" : () -> i32
external p3_ws_wait = "ws-wait" : (a_ws: i32, b_ptr: i32) -> i32
external p3_join = "join" : (a_w: i32, b_ws: i32) -> unit
external p3_subtask_drop = "st-drop" : (a_st: i32) -> unit

import * as mem from "std:runtime/mem"
import * as cast from "std:runtime/cast"
import * as arena from "std:runtime/arena"
import { sched_runq_len } from "std:runtime/sched"
import { Coop } from "std:concurrency/coop"

// Fixed cells in page 13, next to std:runtime/sched's run-queue cells.
let ws_cell = fn () -> i64 do return 851984 end       // waitable set + 1 (0 = unset)
let waiting_cell = fn () -> i64 do return 851992 end  // tasks waiting on a subtask
let ready_cell = fn () -> i64 do return 852000 end    // finished, not yet resumed
let done_cell = fn () -> i64 do return 852008 end     // done-flag table base (0 = unset)
let event_cell = fn () -> i64 do return 852016 end    // waitable-set.wait event out (8 bytes)

// ponytail: flag table indexed by handle, 4096 entries; grow it if handles exceed that.
let done_cap = fn () -> i64 do return 4096 end

let subtask_returned = fn () -> i64 do return 2 end
let event_subtask = fn () -> i64 do return 1 end

let waitable_set = fn () -> i64 do
  let c = mem.load_i64(addr: ws_cell())
  if c != 0 then return c - 1 end
  let ws = cast.i64_of(x: p3_ws_new())
  mem.store_i64(addr: ws_cell(), val: ws + 1)
  return ws
end

let zero = fn (addr: i64, n: i64) -> unit do
  if n <= 0 then return () end
  mem.store_i64(addr, val: 0)
  return zero(addr: addr + 8, n: n - 1)
end

let done_slot = fn (h: i64) -> i64 do
  let b = mem.load_i64(addr: done_cell())
  if b != 0 then return b + h * 8 end
  let nb = arena.alloc_raw(size: done_cap() * 8)
  zero(addr: nb, n: done_cap())
  mem.store_i64(addr: done_cell(), val: nb)
  return nb + h * 8
end

let bump = fn (cell: i64, by: i64) -> unit do
  mem.store_i64(addr: cell, val: mem.load_i64(addr: cell) + by)
  return ()
end

/** Block until some subtask in the set changes state; record a returned one. */
let block_once = fn (ws: i64) -> unit do
  let ev = event_cell()
  let code = cast.i64_of(x: p3_ws_wait(a_ws: cast.i32_of(x: ws), b_ptr: cast.i32_of(x: ev)))
  if code == event_subtask() && mem.load_i32(addr: ev + 4) == subtask_returned() then
    mem.store_i64(addr: done_slot(h: mem.load_i32(addr: ev)), val: 1)
    bump(cell: ready_cell(), by: 1)
  end
  return ()
end

let wait_loop = fn (h: i64, ws: i64) -> unit require { Coop } do
  if mem.load_i64(addr: done_slot(h)) != 0 then return () end
  // Queued tasks that are neither waiting nor finished can run now.
  let parked = mem.load_i64(addr: waiting_cell()) - 1 - mem.load_i64(addr: ready_cell())
  if sched_runq_len() <= parked then block_once(ws) end
  if mem.load_i64(addr: done_slot(h)) != 0 then return () end
  Coop.yield()
  return wait_loop(h, ws)
end

/** Sleep `ms` milliseconds, letting other cooperative tasks run meanwhile. */
export let sleep = fn (ms: i64) -> unit require { Coop } do
  if ms <= 0 then return () end
  let st = cast.i64_of(x: p3_wait_for(a_ns: ms * 1000000))
  if (st & 15) == subtask_returned() then return () end
  let h = st >> 4
  let ws = waitable_set()
  p3_join(a_w: cast.i32_of(x: h), b_ws: cast.i32_of(x: ws))
  bump(cell: waiting_cell(), by: 1)
  wait_loop(h, ws)
  bump(cell: waiting_cell(), by: -1)
  bump(cell: ready_cell(), by: -1)
  mem.store_i64(addr: done_slot(h), val: 0)
  p3_subtask_drop(a_st: cast.i32_of(x: h))
  return ()
end
