/**
 * runtime/force: helpers the compiler calls when `@e` forces every thunk in a
 * list (`[@T]`) or an array (`[| @T |]`). Both work on the i64 machine
 * representation of the elements, so neither is generic.
 *
 * `force-closure` is the codegen intrinsic behind a single `@x` force: it
 * invokes a 0-arg closure pointer and returns its i64 result.
 */
import external "nexus:intrinsic"

import * as mem from "std:runtime/mem"

/** Invoke `a_p` as a 0-arg closure and return its value. */
external force_closure = "force_closure" : (a_p: i64) -> i64

/** Force every element of `xs` in order and return the forced values in the
 *  same order. */
export let force_list = fn (xs: [ i64 ]) -> [ i64 ] do
  return reverse_onto(xs: force_rev(xs, acc: []), acc: [])
end

let force_rev = fn (xs: [ i64 ], acc: [ i64 ]) -> [ i64 ] do
  match xs do
    | [] -> return acc
    | h :: t -> return force_rev(xs: t, acc: force_closure(a_p: h) :: acc)
  end
end

let reverse_onto = fn (xs: [ i64 ], acc: [ i64 ]) -> [ i64 ] do
  match xs do
    | [] -> return acc
    | h :: t -> return reverse_onto(xs: t, acc: h :: acc)
  end
end

/** Force every element of the array `arr` (its packed `(ptr << 32) | len`
 *  value) in index order, overwriting each slot with the forced value, and
 *  return `arr`. Slot `i` lives at `ptr + (i + 1) * 8`. */
export let force_array = fn (arr: i64) -> i64 do
  force_slots(base: arr >> 32, i: 0, n: arr & 4294967295)
  return arr
end

let force_slots = fn (base: i64, i: i64, n: i64) -> unit do
  if i >= n then return () end
  let slot = base + (i + 1) * 8
  mem.store_i64(addr: slot, val: force_closure(a_p: mem.load_i64(addr: slot)))
  return force_slots(base, i: i + 1, n)
end
