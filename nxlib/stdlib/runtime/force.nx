/**
 * runtime/force: helpers the compiler calls when `@e` forces every thunk in a
 * list (`[@T]`) or an array (`[| @T |]`). A forced thunk returns its value in
 * the value channel (a scalar boxed). List elements stay in the channel;
 * `force_array_unboxed` unboxes each forced scalar into its raw array slot.
 *
 * `force-closure` is the codegen intrinsic behind a single `@x` force: it
 * invokes a 0-arg closure pointer and returns its i64 result.
 */
import external "nexus:intrinsic"

import * as mem from "std:runtime/mem"

/** Invoke `a_p` as a 0-arg closure and return its value. */
external force_closure = "force_closure" : <T>(a_p: T) -> T

/** Force every element of `xs` in order and return the forced values in the
 *  same order. */
export let force_list = fn <T>(xs: [ T ]) -> [ T ] do
  return reverse_onto(xs: force_rev(xs, acc: []), acc: [])
end

let force_rev = fn <T>(xs: [ T ], acc: [ T ]) -> [ T ] do
  match xs do
    | [] -> return acc
    | h :: t -> return force_rev(xs: t, acc: force_closure(a_p: h) :: acc)
  end
end

let reverse_onto = fn <T>(xs: [ T ], acc: [ T ]) -> [ T ] do
  match xs do
    | [] -> return acc
    | h :: t -> return reverse_onto(xs: t, acc: h :: acc)
  end
end

/** Force every element of the array `arr` (its packed `(ptr << 32) | len`
 *  value) in index order, overwriting each slot with the forced value, and
 *  return `arr`. Slot `i` lives at `ptr + (i + 1) * 8`. */
export let force_array = fn (arr: i64) -> i64 do
  force_slots(base: arr >> 32, i: 0, n: arr & 4294967295)
  return arr
end

let force_slots = fn (base: i64, i: i64, n: i64) -> unit do
  if i >= n then return () end
  let slot = base + (i + 1) * 8
  let thunk: i64 = mem.load_i64(addr: slot)
  let forced: i64 = force_closure(a_p: thunk)
  mem.store_i64(addr: slot, val: forced)
  return force_slots(base, i: i + 1, n)
end

/** `force_array` for thunks of a scalar: each forced value is a box, and the
 *  slot receives the 64 bits it holds (word 1 of the box). */
export let force_array_unboxed = fn (arr: i64) -> i64 do
  force_slots_unboxed(base: arr >> 32, i: 0, n: arr & 4294967295)
  return arr
end

let force_slots_unboxed = fn (base: i64, i: i64, n: i64) -> unit do
  if i >= n then return () end
  let slot = base + (i + 1) * 8
  let thunk: i64 = mem.load_i64(addr: slot)
  let boxed: i64 = force_closure(a_p: thunk)
  mem.store_i64(addr: slot, val: mem.load_i64(addr: (boxed & 4294967295) + 8))
  return force_slots_unboxed(base, i: i + 1, n)
end
