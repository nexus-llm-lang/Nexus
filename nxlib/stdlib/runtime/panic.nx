/**
 * runtime/panic: exceptions compiled code raises for arithmetic and index
 * errors. Codegen calls these before an integer division or remainder whose
 * divisor is zero (or `i64::MIN / -1`), and before an out-of-bounds array
 * access. Each raises a `RuntimeError`, which a `try`/`catch` can observe.
 *
 * `report_uncaught_named` prints an exception that escaped `main` to stderr;
 * the synthesized main wrapper (src/ir/main_wrap.nx) calls it before exiting.
 */

import * as sysio from "std:runtime/sysio"
import * as exn from "std:exn"

/** Raise the error for an integer division or remainder by zero. */
export let division_by_zero = fn () -> unit throws { Exn } do
  throw RuntimeError(val: "division by zero")
end

/** Raise the error for an integer division whose result does not fit. */
export let integer_overflow = fn () -> unit throws { Exn } do
  throw RuntimeError(val: "integer overflow")
end

/** Raise the error for an array index outside the array. */
export let index_out_of_bounds = fn () -> unit throws { Exn } do
  throw RuntimeError(val: "index out of bounds")
end

/** Print an exception that escaped `main` to stderr. */
export let report_uncaught = fn (e: Exn) -> unit do
  return report_uncaught_named(e, name: "")
end

/** Print an exception that escaped `main` to stderr. `name` is its
 *  constructor name (supplied by the main wrapper); it is printed when
 *  `exn.to_string` has no description for the exception. */
export let report_uncaught_named = fn (e: Exn, name: string) -> unit do
  let described = exn.to_string(exn: e)
  let shown = if described == "<exception>" && name != "" then name else described end
  sysio.eprint_str(s: "uncaught exception: " ++ shown ++ "\n")
  return ()
end
