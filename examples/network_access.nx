// Network capability demo: a live HTTP GET via the Net cap.
//
// `std:network` HTTP primitives are wasm imports that only a component
// build satisfies (`wasi:http` via the p2 bridge). A plain core build of a
// program that uses Net fails to instantiate, so build and run it as a
// preview2 component:
//
//   nexus build examples/network_access.nx --p2-component -o net.wasm
//   wasmtime run -W component-model=y,exceptions=y -S http -S inherit-network net.wasm
//
// `Net.get` raises `RequestError(url)` when the request fails.

import { Net, RequestError }, * as net_mod from "std:network"
import { Console }, * as stdio from "std:stdio"

let main = fn () -> unit require { PermConsole, PermNet } do
  inject net_mod.system_handler, stdio.system_handler do
    try
      let url = "https://httpbin.org/get"
      Console.print(val: "Fetching URL: ")
      Console.println(val: url)

      let response = Net.get(url: url)
      Console.print(val: "Received response:\n")
      Console.print(val: response)
    catch e ->
      match e do
        | RequestError(url) ->
          Console.print(val: "Request failed for ")
          Console.println(val: url)
        | _ ->
          Console.println(val: "Unexpected exception in network_access example")
      end
    end
  end

  return ()
end
