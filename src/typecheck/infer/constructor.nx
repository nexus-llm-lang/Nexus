/**
 * typecheck/infer/constructor: variant-field sorting, enum-type building, and
 * constructor / ctor-arg inference.
 *
 * Leaf cluster (no infer_expr calls):
 *   - Variant-field insertion-sort by label (`sort_variant_fields`,
 *     `insert_variant_field`, `tc_str_lt`).
 *   - Enum-type builder (`build_enum_type`, `build_type_args`).
 *   - Named-type / variant-name collection helpers (`named_type_names`,
 *     `all_variant_names`): used by infer_constructor for error suggestions.
 *   - Ctor field-label check (`check_ctor_field_label`,
 *     `ctor_label_in_singleton`): T-Ctor {ℓ} = {ℓ'} premise.
 *
 * Callback cluster (receive infer_expr as a parameter):
 *   - `infer_constructor`: looks up the variant, freshens type params,
 *     delegates to `check_ctor_args`.
 *   - `check_ctor_args`: walks constructor field list, calling
 *     `infer_expr_fn` for each argument expression.
 *
 * Extracted from src/typecheck/infer.nx.
 */

import { Span } from "src/types/span.nx"
import { Sigil } from "src/types/vocab.nx"
import {
  TypeExpr,
  TyVar,
  TyArrow,
  TyList,
  TyArray,
  TyIntLit,
  TyFloatLit,
  TyUserDefined,
  TyUnit,
  TyRecord,
  VariantField,
  NamedType,
  VariantDef,
  EnumDef
} from "src/types/type_expr.nx"
import { HirExpr } from "src/ir/hir/types.nx"
import {
  Subst, Scheme, EnumEntry, CheckState,
  InferExprResult, InferExprOk, InferExprErr,
  UnifyOk, UnifyErr,
  EnumVariantInfo
}, * as tctypes from "src/typecheck/types.nx"
import * as subst from "src/typecheck/subst.nx"
import * as unify from "src/typecheck/unify.nx"
import { FreshenResult, freshen_type_params } from "src/typecheck/infer/literals.nx"
import { TypeError, UnknownConstructor } from "src/typecheck/errors.nx"
import {
  check_stored_fn_caps_covered, CapArgMismatch, CapArgOk
} from "src/typecheck/infer/control_flow.nx"
import { suggest_names } from "src/diagnostics/levenshtein.nx"
import * as list from "std:list"
import * as str from "std:str"
import { resolve_import_source } from "src/typecheck/import_index.nx"
import { Option, Some, None } from "std:option"

let variant_field_name = fn (f: VariantField) -> string throws { TypeError } do
  match f do
    | VariantField(name: Some(val: n), typ: _) -> return n
    | VariantField(name: None, typ: _) -> return ""
  end
end

export let insert_variant_field = fn (
  f: VariantField,
  sorted: [ VariantField ]
) -> [ VariantField ] throws { TypeError } do
  return insert_variant_field_go(f, sorted, acc: [])
end

let insert_variant_field_go = fn (
  f: VariantField,
  sorted: [ VariantField ],
  acc: [ VariantField ]
) -> [ VariantField ] throws { TypeError } do
  match sorted do
    | [] -> return list.concat(xs: list.reverse(xs: acc), ys: [ f ])
    | head :: rest ->
      if tc_str_lt(a: variant_field_name(f), b: variant_field_name(f: head)) then
        return list.concat(xs: list.reverse(xs: acc), ys: f :: sorted)
      else
        return insert_variant_field_go(f, sorted: rest, acc: head :: acc)
      end
  end
end

export let sort_variant_fields = fn (fields: [ VariantField ]) -> [ VariantField ] throws { TypeError } do
  match fields do
    | [] -> return []
    | f :: rest -> return insert_variant_field(f, sorted: sort_variant_fields(fields: rest))
  end
end

export let tc_str_lt = fn (a: string, b: string) -> bool do
  return a < b
end

export let build_enum_type = fn (
  name: string,
  params: [ string ],
  param_subst: Subst
) -> TypeExpr throws { TypeError } do
  let args = build_type_args(params, param_subst)
  return TyUserDefined(name, args)
end

/** Module-qualified name (`<module>#<enum>`, the form nominal_id produces for
 *  annotations) of the enum named `enum_name` that declares constructor
 *  `variant`. Like nominal_id, only a name declared by two or more modules is
 *  qualified. The declaring module is, in order: the current module, the
 *  module `variant` is imported from, the module `enum_name` is imported from,
 *  or the only module whose `enum_name` declares `variant`; otherwise the name stays bare (the unifier treats a
 *  bare name as matching any module). */
export let ctor_enum_name = fn (state: CheckState, enum_name: string, variant: string) -> string do
  if str.contains(s: enum_name, sub: "#") then return enum_name end
  let decls = list.filter(xs: tctypes.state_full_enums(state), p: fn (val: EnumEntry) -> bool do
    let EnumEntry(
      name: _,
      def: EnumDef(
        name: n,
        is_public: _,
        is_opaque: _,
        type_params: _,
        variants: _,
        layout_variants: _,
        module: m
      )
    ) = val
    return n == enum_name && m != ""
  end)
  let all_mods = list.fold_left(xs: decls, init: [], f: fn (acc: [ string ], val: EnumEntry) -> [ string ] do
    let m = entry_module(e: val)
    return if list.str_member(xs: acc, s: m) then acc else m :: acc end
  end)
  if list.length(xs: all_mods) < 2 then return enum_name end
  let with_variant = list.fold_left(xs: decls, init: [], f: fn (acc: [ string ], val: EnumEntry) -> [ string ] do
    let m = entry_module(e: val)
    if list.str_member(xs: acc, s: m) || !entry_has_variant(e: val, variant) then return acc end
    return m :: acc
  end)
  let cur = tctypes.state_current_module(state)
  if list.str_member(xs: with_variant, s: cur) then return cur ++ "#" ++ enum_name end
  let idx = tctypes.state_module_import_index(state)
  match resolve_import_source(idx, importer: cur, name: bare_ctor(name: variant)) do
    | Some(val: src) ->
      if list.str_member(xs: with_variant, s: src) then return src ++ "#" ++ enum_name end
    | None -> ()
  end
  match resolve_import_source(idx, importer: cur, name: enum_name) do
    | Some(val: src) ->
      if list.str_member(xs: with_variant, s: src) then return src ++ "#" ++ enum_name end
    | None -> ()
  end
  match with_variant do
    | [ m ] -> return m ++ "#" ++ enum_name
    | _ -> return enum_name
  end
end

let entry_module = fn (e: EnumEntry) -> string do
  let EnumEntry(
    name: _,
    def: EnumDef(
      name: _,
      is_public: _,
      is_opaque: _,
      type_params: _,
      variants: _,
      layout_variants: _,
      module: m
    )
  ) = e
  return m
end

let entry_has_variant = fn (e: EnumEntry, variant: string) -> bool do
  let EnumEntry(
    name: _,
    def: EnumDef(
      name: _,
      is_public: _,
      is_opaque: _,
      type_params: _,
      variants: vs,
      layout_variants: _,
      module: _
    )
  ) = e
  return list.any(xs: vs, p: fn (val: VariantDef) -> bool do
    let VariantDef(name: vn, fields: _) = val
    // A constructor colliding across modules is stored renamed
    // (`<module>#<Ctor>`), and `variant` may be such a renamed name of
    // another module's constructor; compare the bare constructor names.
    return bare_ctor(name: vn) == bare_ctor(name: variant)
  end)
end

let bare_ctor = fn (name: string) -> string do
  let i = last_hash(s: name, at: str.byte_length(s: name) - 1)
  if i < 0 then return name end
  return str.byte_substring(s: name, start: i + 1, len: str.byte_length(s: name) - i - 1)
end

let last_hash = fn (s: string, at: i64) -> i64 do
  if at < 0 then return -1 end
  if str.byte_at(s, idx: at) == '#' then return at end
  return last_hash(s, at: at - 1)
end

export let build_type_args = fn (
  params: [ string ],
  param_subst: Subst
) -> [ TypeExpr ] throws { TypeError } do
  return build_type_args_go(params, param_subst, acc: [])
end

let build_type_args_go = fn (
  params: [ string ],
  param_subst: Subst,
  acc: [ TypeExpr ]
) -> [ TypeExpr ] throws { TypeError } do
  match params do
    | [] -> return list.reverse(xs: acc)
    | p :: rest ->
      let resolved = subst.subst_apply(subst: param_subst, typ: TyVar(name: p))
      return build_type_args_go(params: rest, param_subst, acc: resolved :: acc)
  end
end

/** Collect field names from a [NamedType] list (for UnknownField suggestions). */
export let named_type_names = fn (nts: [ NamedType ]) -> [ string ] do
  return named_type_names_go(nts, acc: [])
end

let named_type_names_go = fn (nts: [ NamedType ], acc: [ string ]) -> [ string ] do
  match nts do
    | [] -> return acc
    | NamedType(name: n, typ: _) :: rest -> return named_type_names_go(nts: rest, acc: n :: acc)
  end
end

/** Collect all variant names from the enum definitions in state (for suggestions). */
export let all_variant_names = fn (state: CheckState) -> [ string ] do
  return all_variant_names_go(entries: tctypes.state_enums(state), acc: [])
end

let all_variant_names_go = fn (entries: [ EnumEntry ], acc: [ string ]) -> [ string ] do
  match entries do
    | [] -> return acc
    | EnumEntry(name: _, def: ed) :: rest ->
      let EnumDef(name: _, is_public: _, is_opaque: _, type_params: _, variants: vs) = ed
      let acc2 = all_variant_names_variants(vs, acc)
        return all_variant_names_go(entries: rest, acc: acc2)
  end
end

let all_variant_names_variants = fn (vs: [ VariantDef ], acc: [ string ]) -> [ string ] do
  match vs do
    | [] -> return acc
    | VariantDef(
      name: n,
      fields: _
    ) :: rest -> return all_variant_names_variants(vs: rest, acc: n :: acc)
  end
end

export let check_ctor_field_label = fn (
  user_labels: [ string ], vfname_opt: Option<string>
) -> Option<string> do
  match user_labels do
    | [] -> return None
    | fname :: _ ->
      match vfname_opt do
        | None -> return None
        | Some(val: vfname) ->
          if ctor_label_in_singleton(label: fname, expected: vfname) then
            return None
          else
            return Some(val: "constructor argument label `" ++ fname
              ++ "` does not match the declared field label `" ++ vfname
              ++ "` at this position; T-Ctor requires {ℓ} = {ℓ'}")
          end
      end
  end
end

export let ctor_label_in_singleton = fn (label: string, expected: string) -> bool do
  return ctor_label_in_singleton_go(label, haystack: expected :: [])
end

let ctor_label_in_singleton_go = fn (label: string, haystack: [ string ]) -> bool do
  match haystack do
    | [] -> return false
    | h :: rest ->
      if h == label then return true
      else return ctor_label_in_singleton_go(label, haystack: rest)
      end
  end
end

/** Infer the type of a constructor expression. Calls `infer_expr_fn` for each
 *  constructor argument. */
export let infer_constructor = fn (
  state: CheckState, variant: string, args: [ HirExpr ], labels: [ string ], sigil: Sigil, span: Span,
  infer_expr_fn: (
    state: CheckState,
    expr: HirExpr,
    ret_type: TypeExpr
  ) -> InferExprResult throws { TypeError }
) -> InferExprResult throws { TypeError } do
  sigil
  match tctypes.find_variant_in_state(state, variant) do
    | None ->
      let sugs = suggest_names(typo: variant, candidates: all_variant_names(state))
      throw UnknownConstructor(name: variant, suggestions: sugs, span)
    | Some(val: EnumVariantInfo(enum_name: ename, type_params: tps, fields)) ->
      let fr = freshen_type_params(state, params: tps)
      let FreshenResult(state: st1, param_subst: psubst) = fr
      let sorted_fields = sort_variant_fields(fields)
      let enum_type = build_enum_type(
        name: ctor_enum_name(state: st1, enum_name: ename, variant),
        params: tps,
        param_subst: psubst
      )
      return check_ctor_args(
        state: st1,
        fields: sorted_fields,
        args,
        labels,
        param_subst: psubst,
        enum_type,
        subst: subst.subst_empty(),
        span,
        infer_expr_fn
      )
  end
end

let check_ctor_args = fn (
  state: CheckState, fields: [ VariantField ], args: [ HirExpr ], labels: [ string ],
  param_subst: Subst, enum_type: TypeExpr, subst: Subst, span: Span,
  infer_expr_fn: (
    state: CheckState,
    expr: HirExpr,
    ret_type: TypeExpr
  ) -> InferExprResult throws { TypeError }
) -> InferExprResult throws { TypeError } do
  match fields do
    | [] ->
      match args do
        | [] -> return InferExprOk(state, subst, typ: subst.subst_apply(subst, typ: enum_type))
        | _ -> return InferExprErr(message: "too many constructor arguments", span)
      end
    | VariantField(name: vfname_opt, typ: ftyp) :: rf ->
      match args do
        | [] -> return InferExprErr(message: "missing constructor argument", span)
        | arg :: ra ->
          match check_ctor_field_label(user_labels: labels, vfname_opt: vfname_opt) do
            | Some(val: err) -> return InferExprErr(message: err, span)
            | None -> ()
          end
          let labels_tail = match labels do | [] -> [] | _ :: tl -> tl end
          match infer_expr_fn(state, expr: arg, ret_type: TyUnit) do
            | InferExprErr(message: m, span: espan) -> return InferExprErr(message: m, span: espan)
            | InferExprOk(state: st1, subst: s1, typ: at) ->
              let sm = subst.subst_compose(s1: subst, s2: s1)
              let expected = subst.subst_apply(
                subst: subst.subst_compose(s1: param_subst, s2: sm),
                typ: ftyp
              )
              let tdefs = tctypes.state_typedefs(state: st1)
              if declared_field_may_carry_cap_arrow(typ: ftyp) then
                match check_stored_fn_caps_covered(
                  declared_resolved: expected,
                  arg_typ: subst.subst_apply(subst: sm, typ: at),
                  ambient_row: tctypes.state_require_row(state: st1),
                  tdefs
                ) do
                  | CapArgMismatch(cap_name: _, message: cm) ->
                    return InferExprErr(message: "ctor field: " ++ cm, span)
                  | CapArgOk(subst: _) -> ()
                end
              end
              match unify.unify(t1: at, t2: expected, tdefs) do
                | UnifyOk(subst: s2) ->
                  return check_ctor_args(
                    state: st1, fields: rf, args: ra, labels: labels_tail,
                    param_subst, enum_type,
                    subst: subst.subst_compose(s1: sm, s2), span, infer_expr_fn
                  )
                | UnifyErr(message: m) -> return InferExprErr(message: "ctor field: " ++ m, span)
              end
          end
      end
  end
end

/** Cheap syntactic gate on the RAW declared field type: true only when the
 *  field could hold a cap-bearing closure — i.e. its declared shape is (or, under
 *  list/array layers, contains) a function arrow. For the overwhelmingly common
 *  fields (scalars, records, and the `Cons` spine fields `v: T` / `rest: List<T>`
 *  whose element is a bare type variable) this returns false WITHOUT applying any
 *  substitution or entering the coverage helper, keeping the deep `check_ctor_args`
 *  walk over long list literals at its original per-frame stack footprint. The
 *  full element-covering check runs only for genuine function-valued slots. */
let declared_field_may_carry_cap_arrow = fn (typ: TypeExpr) -> bool do
  match typ do
    | TyArrow(params: _, ret: _, requires: _, throw_row: _) -> return true
    | TyList(elem: e) -> return declared_field_may_carry_cap_arrow(typ: e)
    | TyArray(elem: e) -> return declared_field_may_carry_cap_arrow(typ: e)
    // A STRUCTURAL record whose field is (or, under list/array layers, contains)
    // a cap-bearing closure launders the element commitment just as a direct
    // arrow field or list element does: a ctor field declared
    // `rec: { g: (..) -> .. require { Box } }` admits a record VALUE built under
    // the wrong handler, erasing a concrete `Box<i64>` element commitment at the
    // construction boundary. Descend the fields so `check_stored_fn_caps_covered`
    // (whose `cap_arrow_require_row` already has the matching TyRecord arm) is
    // invoked for such fields.
    | TyRecord(fields: fs) -> return record_field_may_carry_cap_arrow(fields: fs)
    | TyUserDefined(name: n, args: targs) ->
      if n == "List" || n == "Array" then
        match targs do
          | e :: _ -> return declared_field_may_carry_cap_arrow(typ: e)
          | [] -> return false
        end
      end
      return false
    | _ -> return false
  end
end

/** True when any field of a structural-record declared field type is (or, under
 *  list/array layers / nested records, contains) a cap-bearing arrow. Mirrors
 *  control_flow.nx's `record_field_cap_require_row` so the cheap ctor-field gate
 *  and the coverage helper agree on which record shapes carry a commitment. */
let record_field_may_carry_cap_arrow = fn (fields: [ NamedType ]) -> bool do
  match fields do
    | [] -> return false
    | NamedType(name: _, typ: ft) :: rest ->
      if declared_field_may_carry_cap_arrow(typ: ft) then return true end
      return record_field_may_carry_cap_arrow(fields: rest)
  end
end
