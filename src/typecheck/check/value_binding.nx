/**
 * typecheck/check/value_binding: top-level value-binding types.
 *
 * A top-level `let x = <expr>` (a value binding, not a `fn`) is lowered to a
 * nullary HirFunction `HirFunction(params: [], ret_type: rt, body:
 * [Return(<expr>)])` and registered by `register_functions` with the nullary
 * arrow `() -> rt`. MIR lowers a bare reference `x` to a read of the value, so
 * this pass re-publishes each binding's scheme as its value type before any
 * body is checked.
 *
 * When the binding has no annotation and its initializer is not a literal,
 * HIR build cannot infer `rt` (the env is not populated yet) and stores the
 * `vb_inferred` placeholder (src/types/type_expr.nx). Those initializers are
 * inferred here under a fixpoint, since one binding's initializer may
 * reference another, and their types are generalized over free type
 * variables (top-level bindings are immutable).
 *
 * Runs after register_functions / register_caps / register_enum_constructors
 * and before body checking.
 */

import * as list from "std:list"
import { Option, Some, None }, * as option from "std:option"
import {
  TypeExpr,
  TyArrow,
  TyI64,
  TyUserDefined,
  TyRecord,
  TyList,
  TyArray,
  TyRow,
  is_vb_inferred
} from "src/types/type_expr.nx"
import { HirFunction, HirBody, EagerBody, LazyBody, HirStmt, HirExpr } from "src/ir/hir/types.nx"
import {
  CheckState,
  Scheme,
  EnvEntry,
  SubstEntry,
  InferExprOk,
  InferExprErr
}, * as tctypes from "src/typecheck/types.nx"
import * as subst from "src/typecheck/subst.nx"
import { alias_src_name } from "src/typecheck/check/registration.nx"
import { collect_tyvars } from "src/typecheck/linearity/borrow_types.nx"
import * as infer from "src/typecheck/infer.nx"
import { TypeError } from "src/typecheck/errors.nx"

/** Give every top-level value binding its value type in the env. A binding is
 *  registered as the nullary arrow `() -> T`; afterwards its scheme is `T`,
 *  so a bare reference denotes the value (MIR lowers it to a value read).
 *    - annotated / literal bindings: `T` is the declared type;
 *    - unannotated non-literal bindings (`vb_inferred` return): `T` is the
 *      initializer's inferred type, generalized over its free variables,
 *      found by a fixpoint because initializers may reference each other;
 *    - aliases `let g = f`: the final scheme of `f`.
 *  A binding whose initializer fails to infer keeps its arrow scheme; its own
 *  body check reports the error. */
export let resolve_value_binding_types = fn (
  state: CheckState,
  funcs: [ HirFunction ],
  vb_names: [ string ]
) -> CheckState do
  let vbs = list.filter(xs: funcs, p: fn (val: HirFunction) -> bool do
    return list.str_member(xs: vb_names, s: fn_name(f: val))
  end)
  let st1 = unthunk_declared(state, vbs)
  let participants = list.filter(xs: vbs, p: is_participant)
  let n = list.length(xs: participants)
  let st2 = resolve_fixpoint(state: st1, participants, fuel: n + 4)
  let aliases = list.filter(xs: vbs, p: fn (val: HirFunction) -> bool do
    return option.is_some(opt: alias_src_name(func: val))
  end)
  return resolve_aliases(state: resolve_aliases(state: st2, aliases), aliases)
end

let fn_name = fn (f: HirFunction) -> string do
  let HirFunction(name, type_params: _, params: _, ret_type: _, _) = f
  return name
end

/** Re-publish each non-alias binding with a declared (non-placeholder) return
 *  type `R` as the scheme `R`. */
let unthunk_declared = fn (state: CheckState, vbs: [ HirFunction ]) -> CheckState do
  match vbs do
    | [] -> return state
    | f :: rest ->
      let HirFunction(name, type_params: _, params: _, ret_type: ret, _) = f
      if is_vb_inferred(typ: ret) || option.is_some(opt: alias_src_name(func: f)) then
        return unthunk_declared(state, vbs: rest)
      end
      let st1 = match tctypes.state_lookup_scheme(state, name) do
        | Some(val: Scheme(vars, typ: TyArrow(params: [], ret: r, requires: _, throw_row: _))) ->
          tctypes.state_put_global(state, name, scheme: Scheme(vars, typ: r))
        | _ -> state
      end
      return unthunk_declared(state: st1, vbs: rest)
  end
end

/** Copy each alias's source scheme onto the alias. */
let resolve_aliases = fn (state: CheckState, aliases: [ HirFunction ]) -> CheckState do
  match aliases do
    | [] -> return state
    | f :: rest ->
      let st1 = match alias_src_name(func: f) do
        | Some(val: src) ->
          match tctypes.state_lookup_scheme(state, name: src) do
            | Some(val: sc) -> tctypes.state_put_global(state, name: fn_name(f), scheme: sc)
            | None -> state
          end
        | None -> state
      end
      return resolve_aliases(state: st1, aliases: rest)
  end
end

/** Unannotated, non-literal, non-alias eager bindings: their return type is
 *  the `vb_inferred` placeholder. */
let is_participant = fn (val: HirFunction) -> bool do
  let HirFunction(
    name: _, type_params: _, params: _, ret_type: ret, throw_row: _,
    body: fbody, span: _, file: _, requires: _
  ) = val
  if !is_vb_inferred(typ: ret) then return false end
  if option.is_some(opt: alias_src_name(func: val)) then return false end
  match fbody do
    | EagerBody(stmts: _) -> return true
    | LazyBody(_) -> return false
  end
end

/** One sweep resolves every participant from the CURRENT env (which carries the
 *  previous sweep's refined schemes). Repeat until a sweep changes nothing.
 *  `fuel` bounds iterations: each scheme moves placeholder → resolved at most
 *  once, so the participant count plus slack is a generous linear bound. */
let resolve_fixpoint = fn (
  state: CheckState,
  participants: [ HirFunction ],
  fuel: i64
) -> CheckState do
  if fuel <= 0 then return state end
  let SweepResult(state: st1, changed) = resolve_sweep(state, participants, changed: false)
  if changed then return resolve_fixpoint(state: st1, participants, fuel: fuel - 1) end
  return st1
end

type SweepResult = SweepResult(state: CheckState, changed: bool)

let resolve_sweep = fn (
  state: CheckState,
  participants: [ HirFunction ],
  changed: bool
) -> SweepResult do
  match participants do
    | [] -> return SweepResult(state, changed)
    | f :: rest ->
      let ResolveOne(state: st1, changed: c1) = resolve_one(state, func: f)
      let now = if c1 then true else changed end
      return resolve_sweep(state: st1, participants: rest, changed: now)
  end
end

type ResolveOne = ResolveOne(state: CheckState, changed: bool)

/** Infer one value binding's initializer and publish its generalized type as
 *  the binding's scheme. Inference failure keeps the existing scheme. */
let resolve_one = fn (state: CheckState, func: HirFunction) -> ResolveOne do
  let HirFunction(
    name, type_params: _, params: _, ret_type: _, throw_row: _,
    body: fbody, span: _, file: _, requires: _
  ) = func
  match init_expr(body: fbody) do
    | None -> return ResolveOne(state, changed: false)
    | Some(val: expr) ->
      match try_infer_expr(state, expr) do
        | None -> return ResolveOne(state, changed: false)
        | Some(val: real_t) ->
          if already_resolved(state, name, real_t) then return ResolveOne(state, changed: false) end
          let new_scheme = Scheme(
            vars: dedup(xs: collect_tyvars(t: real_t, acc: []), acc: []),
            typ: real_t
          )
          let st1 = tctypes.state_put_global(state, name, scheme: new_scheme)
          return ResolveOne(state: st1, changed: true)
      end
  end
end

let dedup = fn (xs: [ string ], acc: [ string ]) -> [ string ] do
  match xs do
    | [] -> return list.reverse(xs: acc)
    | x :: rest ->
      if list.str_member(xs: acc, s: x) then return dedup(xs: rest, acc) end
      return dedup(xs: rest, acc: x :: acc)
  end
end

/** The initializer expression of a value binding: its body is the single
 *  `[Return(<expr>)]` synthesised by HIR build. */
let init_expr = fn (body: HirBody) -> Option<HirExpr> do
  match body do
    | EagerBody(stmts: [ HirStmt(node: Return(expr: e), span: _) ]) -> return Some(val: e)
    | _ -> return None
  end
end

/** Infer the initializer expression, swallowing any TypeError (best-effort).
 *  Returns the inferred type resolved under the body substitution. */
let try_infer_expr = fn (state: CheckState, expr: HirExpr) -> Option<TypeExpr> do
  try
    match infer.infer_expr(state, expr, ret_type: TyI64) do
      | InferExprOk(
        state: _,
        subst: s,
        typ: t
      ) -> return Some(val: subst.subst_apply(subst: s, typ: t))
      | InferExprErr(message: _, span: _) -> return None
    end
  catch
    | _ -> return None
  end
end

/** True when the env scheme for `name` already has type `real_t` (so a
 *  re-sweep does not report a spurious change). */
let already_resolved = fn (state: CheckState, name: string, real_t: TypeExpr) -> bool do
  match tctypes.state_lookup_scheme(state, name) do
    | Some(val: Scheme(vars: _, typ: cur)) -> return types_equal(a: cur, b: real_t)
    | None -> return false
  end
end

let types_equal = fn (a: TypeExpr, b: TypeExpr) -> bool do
  return subst.type_eq(a, b)
end

/** `funcs` with each `vb_inferred` return type replaced by the binding's type
 *  in `state` (the scheme `resolve_value_binding_types` published), so later
 *  passes see the value's real type. Unresolved bindings are left as is. */
export let patch_inferred_value_binding_rets = fn (
  state: CheckState,
  funcs: [ HirFunction ]
) -> [ HirFunction ] do
  return list.map(xs: funcs, f: fn (val: HirFunction) -> HirFunction do
    let HirFunction(
      name,
      type_params,
      params,
      ret_type,
      throw_row,
      body,
      span,
      file,
      requires
    ) = val
    if !is_vb_inferred(typ: ret_type) then return val end
    match tctypes.state_lookup_scheme(state, name) do
      | Some(val: Scheme(vars: _, typ: TyArrow(params: [], ret: _, requires: _, throw_row: _))) -> return val
      | Some(val: Scheme(vars: _, typ: t)) ->
        return HirFunction(
          name,
          type_params,
          params,
          ret_type: t,
          throw_row,
          body,
          span,
          file,
          requires
        )
      | None -> return val
    end
  end)
end
