/**
 * wasm/section/cm_common: shared primitives for component-model byte emission.
 *
 * Used by the component builders under section/p2/.
 */

import { ByteBuffer }, * as bb from "std:bytebuffer"
import * as str from "std:str"

/** Wrap content bytes with a size-prefixed section header.
 *  Returns bytes: ULEB(section_id) + ULEB(size_of_content) + content.
 */
export let cm_wrap_section = fn (section_id: i64, content: %ByteBuffer) -> %ByteBuffer do
  let %hdr = bb.empty()
  let %hdr = bb.push_uleb128(buf: %hdr, val: section_id)
  let %hdr = bb.push_uleb128(buf: %hdr, val: bb.length(buf: &content))
  let %hdr = bb.push_buf(dst: %hdr, src: &content)
  bb.free(buf: %content)
  return %hdr
end

/** Push a length-prefixed name string into buf (ULEB byte_length + UTF-8 bytes). */
let cm_push_name = fn (buf: %ByteBuffer, name: string) -> %ByteBuffer do
  let %buf = bb.push_uleb128(buf: %buf, val: str.byte_length(s: name))
  return bb.push_string(%buf, s: name)
end

/** Emit one export entry for a core function in a FromExports instance. */
export let cm_emit_func_export_entry = fn (
  buf: %ByteBuffer,
  name: string,
  idx: i64
) -> %ByteBuffer do
  let %buf = cm_push_name(%buf, name)
  let %buf = bb.push_byte(buf: %buf, byte: 0)
  return bb.push_uleb128(buf: %buf, val: idx)
end
