/**
 * wasm/section/p3_http_types: the wasi:http@0.3.0 import sections a
 * --p3-component build adds when the program uses Net. The hex runs are the
 * wasm-tools encoding of the WIT; only the absolute type / instance indices
 * are computed.
 */

import { ByteBuffer }, * as bb from "std:bytebuffer"
import * as str from "std:str"
import * as cast from "std:runtime/cast"
import * as wdefs from "src/backend/wasm/defs.nx"
import { cm_wrap_section } from "src/backend/wasm/section/cm_common.nx"

let hex_digit = fn (c: i64) -> i64 do
  if c >= 97 then return c - 87 end
  return c - 48
end

/** Append the bytes spelled by the lowercase hex string `hex`. */
let push_hex = fn (buf: %ByteBuffer, hex: string) -> %ByteBuffer do
  return push_hex_at(buf: %buf, hex, i: 0, n: str.byte_length(s: hex))
end

let push_hex_at = fn (buf: %ByteBuffer, hex: string, i: i64, n: i64) -> %ByteBuffer do
  if i >= n then return %buf end
  let hi = hex_digit(c: cast.i64_of_char(x: str.byte_at(s: hex, idx: i)))
  let lo = hex_digit(c: cast.i64_of_char(x: str.byte_at(s: hex, idx: i + 1)))
  let b = hi * 16 + lo
  return push_hex_at(buf: bb.push_byte(buf: %buf, byte: b), hex, i: i + 2, n)
end

let push_section = fn (out: %ByteBuffer, id: i64, content: %ByteBuffer) -> %ByteBuffer do
  let %s = cm_wrap_section(section_id: id, content: %content)
  let %out = bb.push_buf(dst: %out, src: &s)
  bb.free(buf: %s)
  return %out
end

/** The wasi:clocks/types, wasi:http/types and wasi:http/client @0.3.0 import
 *  sections (types, imports, and the type aliases between them), with every
 *  absolute index offset by `t0` component types and `i0` component instances
 *  already defined. Defines types t0..t0+6 and instances i0..i0+2.
 *  Generated from the WIT that wasmtime 48.0.1 ships for wasi-http p3. */
export let p3_http_imports = fn (base: %ByteBuffer, t0: i64, i0: i64) -> %ByteBuffer do
  let %out = base
  let %c0 = push_hex(buf: bb.empty(), hex: "01420201770400086475726174696f6e030000")
  let %out = push_section(out: %out, id: wdefs.cm_sec_type, content: %c0)
  let %c1 = push_hex(buf: bb.empty(), hex: "010017776173693a636c6f636b732f747970657340302e332e3005")
  let %c1 = bb.push_uleb128(buf: %c1, val: t0 + 0)
  let %out = push_section(out: %out, id: wdefs.cm_sec_import, content: %c1)
  let %c2 = push_hex(buf: bb.empty(), hex: "01")
  let %c2 = push_hex(buf: %c2, hex: "0300")
  let %c2 = bb.push_uleb128(buf: %c2, val: i0 + 0)
  let %c2 = push_hex(buf: %c2, hex: "086475726174696f6e")
