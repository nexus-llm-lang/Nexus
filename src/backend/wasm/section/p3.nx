/**
 * wasm/section/p3: the WASI preview3 additions to a p2 component.
 *
 * A --p3-component build is the p2 component (preview1 adapter to WASI 0.2)
 * plus:
 *  - an import of `wasi:clocks/monotonic-clock@0.3.0` whose async `wait-for` is
 *    lowered with the `async` option, and the waitable-set / subtask builtins,
 *    passed to the nexus module as the core instance `nexus_p3`;
 *  - when the program uses Net, the wasi:http@0.3.0 imports, the request /
 *    response funcs it needs, `wasi:http/client#send` lowered `async`, and the
 *    future / stream builtins for the request trailers and response body,
 *    added to `nexus_p3`;
 *  - a `wasi:cli/run@0.3.0` export lifted `async` (stackful) over a shim module
 *    that calls the nexus run function and hands its status to `task.return`.
 *    An async task may block in `waitable-set.wait`; a sync one may not.
 *
 * The caller passes the index-space positions the p2 sections leave behind:
 *  core_func: core funcs defined before the p3 canon lowers
 *  comp_func: component funcs defined before the `wait-for` alias
 *  comp_inst: component instances defined before the clock import
 *  type_idx:  component types defined before the clock instance type
 */

import { ByteBuffer }, * as bb from "std:bytebuffer"
import * as str from "std:str"
import * as wdefs from "src/backend/wasm/defs.nx"
import { cm_wrap_section, cm_emit_func_export_entry } from "src/backend/wasm/section/cm_common.nx"
import { p3_http_imports } from "src/backend/wasm/section/p3_http_types.nx"

let push_name = fn (buf: %ByteBuffer, name: string) -> %ByteBuffer do
  let %buf = bb.push_uleb128(buf: %buf, val: str.byte_length(s: name))
  return bb.push_string(buf: %buf, s: name)
end

let push_section = fn (out: %ByteBuffer, id: i64, content: %ByteBuffer) -> %ByteBuffer do
  let %s = cm_wrap_section(section_id: id, content: %content)
  let %out = bb.push_buf(dst: %out, src: &s)
  bb.free(buf: %s)
  return %out
end

/** Index-space entries `p3_build_pre` defines, without / with the HTTP part. */
export let p3_pre_core_funcs = fn (http: bool) -> i64 do
  return if http then 31 else 5 end
end
export let p3_pre_types = fn (http: bool) -> i64 do
  return if http then 16 else 1 end
end
export let p3_pre_comp_funcs = fn (http: bool) -> i64 do
  return if http then 13 else 1 end
end
export let p3_pre_comp_insts = fn (http: bool) -> i64 do
  return if http then 4 else 1 end
end

/** Core func index of the p2 stub's `cabi_realloc` alias. */
let realloc_core_func = fn () -> i64 do
  return 4
end

let push_alias_func = fn (buf: %ByteBuffer, inst: i64, name: string) -> %ByteBuffer do
  let %buf = bb.push_bytes(buf: %buf, bytes: [ 1, 0 ])
  let %buf = bb.push_uleb128(buf: %buf, val: inst)
  return push_name(%buf, name)
end

/** canon lower of component func `f`, with memory 0 when `mem`. */
let push_lower = fn (buf: %ByteBuffer, f: i64, mem: bool) -> %ByteBuffer do
  let %buf = bb.push_bytes(buf: %buf, bytes: [ 1, 0 ])
  let %buf = bb.push_uleb128(buf: %buf, val: f)
  if mem then return bb.push_bytes(buf: %buf, bytes: [ 1, 3, 0 ]) end
  return bb.push_byte(buf: %buf, byte: 0)
end

/** The HTTP part: wasi:http imports at types t0.., instances i0..; then the
 *  `fields` alias, the trailers future / body-result future / body stream
 *  types, the func aliases (component funcs f0..f0+11), and their canon lowers
 *  and builtins (core funcs from core_func 5 on). */
let p3_build_http = fn (base: %ByteBuffer, t0: i64, i0: i64, f0: i64) -> %ByteBuffer do
  let %out = p3_http_imports(base: %base, t0, i0)
  let types_inst = i0 + 1
  let client_inst = i0 + 2
  let fields = t0 + 7
  let error_code = t0 + 5
  let %a = bb.push_bytes(buf: bb.empty(), bytes: [ 1, 3, 0 ])
  let %a = bb.push_uleb128(buf: %a, val: types_inst)
  let %a = push_name(buf: %a, name: "fields")
  let %out = push_section(out: %out, id: wdefs.cm_sec_alias, content: %a)

  // t0+8 own<fields>; +9 option; +10 result<option, error-code>; +11 future;
  // +12 result<_, error-code>; +13 future; +14 stream<u8>
  let %t = bb.push_bytes(buf: bb.empty(), bytes: [ 7, 105 ])
  let %t = bb.push_uleb128(buf: %t, val: fields)
  let %t = bb.push_byte(buf: %t, byte: 107)
  let %t = bb.push_uleb128(buf: %t, val: t0 + 8)
  let %t = bb.push_bytes(buf: %t, bytes: [ 106, 1 ])
  let %t = bb.push_uleb128(buf: %t, val: t0 + 9)
  let %t = bb.push_byte(buf: %t, byte: 1)
  let %t = bb.push_uleb128(buf: %t, val: error_code)
  let %t = bb.push_bytes(buf: %t, bytes: [ 101, 1 ])
  let %t = bb.push_uleb128(buf: %t, val: t0 + 10)
  let %t = bb.push_bytes(buf: %t, bytes: [ 106, 0, 1 ])
  let %t = bb.push_uleb128(buf: %t, val: error_code)
  let %t = bb.push_bytes(buf: %t, bytes: [ 101, 1 ])
  let %t = bb.push_uleb128(buf: %t, val: t0 + 12)
  let %t = bb.push_bytes(buf: %t, bytes: [ 102, 1, 125 ])
  let %out = push_section(out: %out, id: wdefs.cm_sec_type, content: %t)

  let %fa = bb.push_byte(buf: bb.empty(), byte: 12)
  let %fa = push_alias_func(buf: %fa, inst: types_inst, name: "[constructor]fields")
  let %fa = push_alias_func(buf: %fa, inst: types_inst, name: "[static]request.new")
  let %fa = push_alias_func(buf: %fa, inst: types_inst, name: "[method]request.set-scheme")
  let %fa = push_alias_func(buf: %fa, inst: types_inst, name: "[method]request.set-authority")
  let %fa = push_alias_func(buf: %fa, inst: types_inst, name: "[method]request.set-path-with-query")
  let %fa = push_alias_func(buf: %fa, inst: types_inst, name: "[method]response.get-status-code")
  let %fa = push_alias_func(buf: %fa, inst: types_inst, name: "[static]response.consume-body")
  let %fa = push_alias_func(buf: %fa, inst: client_inst, name: "send")
  let %fa = push_alias_func(buf: %fa, inst: types_inst, name: "[method]request.set-method")
  let %fa = push_alias_func(buf: %fa, inst: types_inst, name: "[method]fields.append")
  let %fa = push_alias_func(buf: %fa, inst: types_inst, name: "[method]response.get-headers")
  let %fa = push_alias_func(buf: %fa, inst: types_inst, name: "[method]fields.copy-all")
  let %out = push_section(out: %out, id: wdefs.cm_sec_alias, content: %fa)

  let %c = bb.push_byte(buf: bb.empty(), byte: 26)
  let %c = push_lower(buf: %c, f: f0, mem: false)
  let %c = push_lower(buf: %c, f: f0 + 1, mem: true)
  let %c = push_lower(buf: %c, f: f0 + 2, mem: true)
  let %c = push_lower(buf: %c, f: f0 + 3, mem: true)
  let %c = push_lower(buf: %c, f: f0 + 4, mem: true)
  let %c = push_lower(buf: %c, f: f0 + 5, mem: false)
  let %c = push_lower(buf: %c, f: f0 + 6, mem: true)
  // send: async, memory 0, realloc
  let %c = bb.push_bytes(buf: %c, bytes: [ 1, 0 ])
  let %c = bb.push_uleb128(buf: %c, val: f0 + 7)
  let %c = bb.push_bytes(buf: %c, bytes: [ 3, 6, 3, 0, 4 ])
  let %c = bb.push_uleb128(buf: %c, val: realloc_core_func())
  // future.new / future.write (async, memory 0) of the trailers future
  let %c = bb.push_byte(buf: %c, byte: 21)
  let %c = bb.push_uleb128(buf: %c, val: t0 + 11)
  let %c = bb.push_byte(buf: %c, byte: 23)
  let %c = bb.push_uleb128(buf: %c, val: t0 + 11)
  let %c = bb.push_bytes(buf: %c, bytes: [ 2, 6, 3, 0 ])
  // future.new of the body-result future; stream.read (async, memory 0)
  let %c = bb.push_byte(buf: %c, byte: 21)
  let %c = bb.push_uleb128(buf: %c, val: t0 + 13)
  let %c = bb.push_byte(buf: %c, byte: 15)
  let %c = bb.push_uleb128(buf: %c, val: t0 + 14)
  let %c = bb.push_bytes(buf: %c, bytes: [ 2, 6, 3, 0 ])
  // set-method (memory 0); fields.append (memory 0, realloc); response.get-headers;
  // fields.copy-all (memory 0, realloc)
  let %c = push_lower(buf: %c, f: f0 + 8, mem: true)
  let %c = bb.push_bytes(buf: %c, bytes: [ 1, 0 ])
  let %c = bb.push_uleb128(buf: %c, val: f0 + 9)
  let %c = bb.push_bytes(buf: %c, bytes: [ 2, 3, 0, 4 ])
  let %c = bb.push_uleb128(buf: %c, val: realloc_core_func())
  let %c = push_lower(buf: %c, f: f0 + 10, mem: false)
  let %c = bb.push_bytes(buf: %c, bytes: [ 1, 0 ])
  let %c = bb.push_uleb128(buf: %c, val: f0 + 11)
  let %c = bb.push_bytes(buf: %c, bytes: [ 2, 3, 0, 4 ])
  let %c = bb.push_uleb128(buf: %c, val: realloc_core_func())
  // resource.drop fields; stream.new / write (async, memory 0) /
  // drop-writable / drop-readable; body-result future drop-writable /
  // drop-readable; trailers future drop-readable
  let %c = bb.push_byte(buf: %c, byte: 3)
  let %c = bb.push_uleb128(buf: %c, val: fields)
  let %c = bb.push_byte(buf: %c, byte: 14)
  let %c = bb.push_uleb128(buf: %c, val: t0 + 14)
  let %c = bb.push_byte(buf: %c, byte: 16)
  let %c = bb.push_uleb128(buf: %c, val: t0 + 14)
  let %c = bb.push_bytes(buf: %c, bytes: [ 2, 6, 3, 0, 20 ])
  let %c = bb.push_uleb128(buf: %c, val: t0 + 14)
  let %c = bb.push_byte(buf: %c, byte: 19)
  let %c = bb.push_uleb128(buf: %c, val: t0 + 14)
  let %c = bb.push_byte(buf: %c, byte: 27)
  let %c = bb.push_uleb128(buf: %c, val: t0 + 13)
  let %c = bb.push_byte(buf: %c, byte: 26)
  let %c = bb.push_uleb128(buf: %c, val: t0 + 13)
  // trailers future drop-readable; body-result future write (async, memory 0)
  let %c = bb.push_byte(buf: %c, byte: 26)
  let %c = bb.push_uleb128(buf: %c, val: t0 + 11)
  let %c = bb.push_byte(buf: %c, byte: 23)
  let %c = bb.push_uleb128(buf: %c, val: t0 + 13)
  let %c = bb.push_bytes(buf: %c, bytes: [ 2, 6, 3, 0 ])
  // trailers future drop-writable
  let %c = bb.push_byte(buf: %c, byte: 27)
  let %c = bb.push_uleb128(buf: %c, val: t0 + 11)
  return push_section(out: %out, id: wdefs.cm_sec_canon, content: %c)
end

/** Sections placed after the p2 canon lowers: the clock instance type and
 *  import, the `wait-for` alias, and the canon lowers / builtins
 *  (core funcs core_func .. core_func+4); then, when `http`, the HTTP part. */
export let p3_build_pre = fn (
  base: %ByteBuffer,
  comp_func: i64,
  comp_inst: i64,
  type_idx: i64,
  http: bool
) -> %ByteBuffer do
  // type: instance { type 0 = async func(how-long: u64); export wait-for: func 0 }
  let %t = bb.push_bytes(buf: bb.empty(), bytes: [ 1, 66, 2, 1, 67, 1 ])
  let %t = push_name(buf: %t, name: "how-long")
  let %t = bb.push_bytes(buf: %t, bytes: [ 119, 1, 0, 4, 0 ])
  let %t = push_name(buf: %t, name: "wait-for")
  let %t = bb.push_bytes(buf: %t, bytes: [ 1, 0 ])
  let %out = push_section(out: %base, id: wdefs.cm_sec_type, content: %t)

  let %i = bb.push_bytes(buf: bb.empty(), bytes: [ 1, 0 ])
  let %i = push_name(buf: %i, name: "wasi:clocks/monotonic-clock@0.3.0")
  let %i = bb.push_byte(buf: %i, byte: 5)
  let %i = bb.push_uleb128(buf: %i, val: type_idx)
  let %out = push_section(out: %out, id: wdefs.cm_sec_import, content: %i)

  // alias: func export "wait-for" of the clock instance
  let %a = bb.push_bytes(buf: bb.empty(), bytes: [ 1, 1, 0 ])
  let %a = bb.push_uleb128(buf: %a, val: comp_inst)
  let %a = push_name(buf: %a, name: "wait-for")
  let %out = push_section(out: %out, id: wdefs.cm_sec_alias, content: %a)

  // canon: lower wait-for (async, memory 0); waitable-set.new;
  // waitable-set.wait (memory 0); waitable.join; subtask.drop
  let %c = bb.push_bytes(buf: bb.empty(), bytes: [ 5, 1, 0 ])
  let %c = bb.push_uleb128(buf: %c, val: comp_func)
  let %c = bb.push_bytes(buf: %c, bytes: [ 2, 6, 3, 0, 31, 32, 0, 0, 35, 13 ])
  let %out = push_section(out: %out, id: wdefs.cm_sec_canon, content: %c)
  if !http then return %out end
  return p3_build_http(base: %out, t0: type_idx + 1, i0: comp_inst + 1, f0: comp_func + 1)
end

/** The FromExports core-instance entry bundling the p3 core funcs; the nexus
 *  module imports it as `nexus_p3`. */
export let p3_from_exports_entry = fn (core_func: i64, http: bool) -> %ByteBuffer do
  let %e = bb.push_bytes(buf: bb.empty(), bytes: [ 1 ])
  let %e = bb.push_uleb128(buf: %e, val: p3_pre_core_funcs(http))
  let %e = cm_emit_func_export_entry(buf: %e, name: "wait-for", idx: core_func)
  let %e = cm_emit_func_export_entry(buf: %e, name: "ws-new", idx: core_func + 1)
  let %e = cm_emit_func_export_entry(buf: %e, name: "ws-wait", idx: core_func + 2)
  let %e = cm_emit_func_export_entry(buf: %e, name: "join", idx: core_func + 3)
  let %e = cm_emit_func_export_entry(buf: %e, name: "st-drop", idx: core_func + 4)
  if !http then return %e end
  let %e = cm_emit_func_export_entry(buf: %e, name: "fields-new", idx: core_func + 5)
  let %e = cm_emit_func_export_entry(buf: %e, name: "request-new", idx: core_func + 6)
  let %e = cm_emit_func_export_entry(buf: %e, name: "set-scheme", idx: core_func + 7)
  let %e = cm_emit_func_export_entry(buf: %e, name: "set-authority", idx: core_func + 8)
  let %e = cm_emit_func_export_entry(buf: %e, name: "set-path", idx: core_func + 9)
  let %e = cm_emit_func_export_entry(buf: %e, name: "status-code", idx: core_func + 10)
  let %e = cm_emit_func_export_entry(buf: %e, name: "consume-body", idx: core_func + 11)
  let %e = cm_emit_func_export_entry(buf: %e, name: "send", idx: core_func + 12)
  let %e = cm_emit_func_export_entry(buf: %e, name: "trailers-new", idx: core_func + 13)
  let %e = cm_emit_func_export_entry(buf: %e, name: "trailers-write", idx: core_func + 14)
  let %e = cm_emit_func_export_entry(buf: %e, name: "body-result-new", idx: core_func + 15)
  let %e = cm_emit_func_export_entry(buf: %e, name: "body-read", idx: core_func + 16)
  let %e = cm_emit_func_export_entry(buf: %e, name: "set-method", idx: core_func + 17)
  let %e = cm_emit_func_export_entry(buf: %e, name: "fields-append", idx: core_func + 18)
  let %e = cm_emit_func_export_entry(buf: %e, name: "get-headers", idx: core_func + 19)
  let %e = cm_emit_func_export_entry(buf: %e, name: "fields-copy-all", idx: core_func + 20)
  let %e = cm_emit_func_export_entry(buf: %e, name: "fields-drop", idx: core_func + 21)
  let %e = cm_emit_func_export_entry(buf: %e, name: "body-new", idx: core_func + 22)
  let %e = cm_emit_func_export_entry(buf: %e, name: "body-write", idx: core_func + 23)
  let %e = cm_emit_func_export_entry(buf: %e, name: "body-drop-writable", idx: core_func + 24)
  let %e = cm_emit_func_export_entry(buf: %e, name: "body-drop-readable", idx: core_func + 25)
  let %e = cm_emit_func_export_entry(buf: %e, name: "result-drop-writable", idx: core_func + 26)
  let %e = cm_emit_func_export_entry(buf: %e, name: "result-drop-readable", idx: core_func + 27)
  let %e = cm_emit_func_export_entry(buf: %e, name: "trailers-drop-readable", idx: core_func + 28)
  let %e = cm_emit_func_export_entry(buf: %e, name: "result-write", idx: core_func + 29)
  return cm_emit_func_export_entry(buf: %e, name: "trailers-drop-writable", idx: core_func + 30)
end

/** `(module (import "n" "run" (func (result i32)))
 *          (import "n" "task-return" (func (param i32)))
 *          (func (export "run") (call 1 (call 0))))` */
let shim_module = fn () -> %ByteBuffer do
  return bb.push_bytes(buf: bb.empty(), bytes: [
    0, 97, 115, 109, 1, 0, 0, 0, 1, 12, 3, 96, 0, 1, 127, 96, 1, 127, 0, 96, 0, 0,
    2, 25, 2, 1, 110, 3, 114, 117, 110, 0, 0, 1, 110, 11, 116, 97, 115, 107, 45,
    114, 101, 116, 117, 114, 110, 0, 1, 3, 2, 1, 2, 7, 7, 1, 3, 114, 117, 110, 0,
    2, 10, 8, 1, 6, 0, 16, 0, 16, 1, 11 ])
end

/** Sections after the core instances: alias the nexus run func, define
 *  `result` and `async func() -> result`, `task.return`, the shim module and
 *  its instances, lift the shim's run `async`, and export it as
 *  `wasi:cli/run@0.3.0`.
 *  nexus_inst: core instance index of the nexus module
 *  core_func:  core funcs defined so far (run alias lands here)
 *  core_module: core modules defined so far (shim lands here)
 *  type_idx:   component types defined so far
 *  comp_func / comp_inst: component funcs / instances defined so far */
export let p3_build_tail = fn (
  run_func_export: string,
  nexus_inst: i64,
  core_func: i64,
  core_module: i64,
  type_idx: i64,
  comp_func: i64,
  comp_inst: i64
) -> %ByteBuffer do
  let %a = bb.push_bytes(buf: bb.empty(), bytes: [ 1, 0, 0, 1 ])
  let %a = bb.push_uleb128(buf: %a, val: nexus_inst)
  let %a = push_name(buf: %a, name: run_func_export)
  let %out = push_section(out: bb.empty(), id: wdefs.cm_sec_alias, content: %a)

  let %t = bb.push_bytes(buf: bb.empty(), bytes: [ 2, 106, 0, 0, 67, 0, 0 ])
  let %t = bb.push_uleb128(buf: %t, val: type_idx)
  let %out = push_section(out: %out, id: wdefs.cm_sec_type, content: %t)

  let %r = bb.push_bytes(buf: bb.empty(), bytes: [ 1, 9, 0 ])
  let %r = bb.push_uleb128(buf: %r, val: type_idx)
  let %r = bb.push_byte(buf: %r, byte: 0)
  let %out = push_section(out: %out, id: wdefs.cm_sec_canon, content: %r)

  let %out = push_section(out: %out, id: wdefs.cm_sec_core_module, content: shim_module())

  let %ci = bb.push_bytes(buf: bb.empty(), bytes: [ 2, 1, 2 ])
  let %ci = cm_emit_func_export_entry(buf: %ci, name: "run", idx: core_func)
  let %ci = cm_emit_func_export_entry(buf: %ci, name: "task-return", idx: core_func + 1)
  let %ci = bb.push_byte(buf: %ci, byte: 0)
  let %ci = bb.push_uleb128(buf: %ci, val: core_module)
  let %ci = bb.push_byte(buf: %ci, byte: 1)
  let %ci = push_name(buf: %ci, name: "n")
  let %ci = bb.push_byte(buf: %ci, byte: 18)
  let %ci = bb.push_uleb128(buf: %ci, val: nexus_inst + 1)
  let %out = push_section(out: %out, id: wdefs.cm_sec_core_instance, content: %ci)

  let %a2 = bb.push_bytes(buf: bb.empty(), bytes: [ 1, 0, 0, 1 ])
  let %a2 = bb.push_uleb128(buf: %a2, val: nexus_inst + 2)
  let %a2 = push_name(buf: %a2, name: "run")
  let %out = push_section(out: %out, id: wdefs.cm_sec_alias, content: %a2)

  // canon lift (core func core_func+2) async, type type_idx+1
  let %l = bb.push_bytes(buf: bb.empty(), bytes: [ 1, 0, 0 ])
  let %l = bb.push_uleb128(buf: %l, val: core_func + 2)
  let %l = bb.push_bytes(buf: %l, bytes: [ 1, 6 ])
  let %l = bb.push_uleb128(buf: %l, val: type_idx + 1)
  let %out = push_section(out: %out, id: wdefs.cm_sec_canon, content: %l)

  let %inst = bb.push_bytes(buf: bb.empty(), bytes: [ 1, 1, 1, 0 ])
  let %inst = push_name(buf: %inst, name: "run")
  let %inst = bb.push_byte(buf: %inst, byte: 1)
  let %inst = bb.push_uleb128(buf: %inst, val: comp_func)
  let %out = push_section(out: %out, id: wdefs.cm_sec_instance, content: %inst)

  let %x = bb.push_bytes(buf: bb.empty(), bytes: [ 1, 0 ])
  let %x = push_name(buf: %x, name: "wasi:cli/run@0.3.0")
  let %x = bb.push_byte(buf: %x, byte: 5)
  let %x = bb.push_uleb128(buf: %x, val: comp_inst)
  let %x = bb.push_byte(buf: %x, byte: 0)
  return push_section(out: %out, id: wdefs.cm_sec_export, content: %x)
end
