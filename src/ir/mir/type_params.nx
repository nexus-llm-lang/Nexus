/**
 * type_params: rewrite a function's declared type parameters into type
 * variables.
 *
 * Type parameters are written without a sigil, so after HIR they appear as
 * nullary `TyUserDefined(name)`. Rewriting the names listed in the
 * function's `type_params` to `TyVar(name)` lets later phases tell a value
 * of a type parameter from a value of a user-defined type.
 */
import { Option, Some, None } from "std:option"
import { EnumDef, RecordDef, VariantDef, VariantField } from "src/types/type_expr.nx"
import { TypeExpr, NamedType, TyUserDefined, TyVar, TyArrow, TyRef, TyLinear, TyLazy,
         TyBorrow, TyArray, TyList, TyRecord, TyRow, TyHandler } from "src/types/type_expr.nx"
import {
  MirParam,
  MirFunction,
  MirStmt,
  MirExpr,
  MirCallArg,
  MirNamedExpr,
  MirMatchCase,
  MirStmtLet,
  MirStmtExpr,
  MirStmtReturn,
  MirStmtAssign,
  MirStmtTry,
  MirStmtInjectResume,
  MirBinaryOp,
  MirCall,
  MirConstructor,
  MirRecord,
  MirArray,
  MirIndex,
  MirFieldAccess,
  MirIf,
  MirMatch,
  MirWhile,
  MirRaise,
  MirForce,
  MirMakeClosure,
  MirCallClosure,
  MirSuspend,
  MirResume,
  MirBlock,
  MirInjectValue
} from "src/ir/mir/types.nx"

/** Replace every nullary `TyUserDefined(n)` with `n` in `names` by `TyVar(n)`. */
export let type_params_to_vars = fn (typ: TypeExpr, names: [ string ]) -> TypeExpr do
  match names do
    | [] -> return typ
    | _ -> return rewrite(typ, names)
  end
end

let rewrite = fn (typ: TypeExpr, names: [ string ]) -> TypeExpr do
  match typ do
    | TyUserDefined(name, args: []) ->
      if has_name(names, name) then return TyVar(name) end
      return typ
    | TyUserDefined(name, args) -> return TyUserDefined(name, args: rewrite_list(ts: args, names))
    | TyArrow(params, ret, requires, throw_row) ->
      return TyArrow(
        params: rewrite_named(nts: params, names),
        ret: rewrite(typ: ret, names),
        requires: rewrite(typ: requires, names),
        throw_row: rewrite(typ: throw_row, names)
      )
    | TyRef(inner) -> return TyRef(inner: rewrite(typ: inner, names))
    | TyLinear(inner) -> return TyLinear(inner: rewrite(typ: inner, names))
    | TyLazy(inner, require_row, throw_row) ->
      return TyLazy(
        inner: rewrite(typ: inner, names),
        require_row: rewrite(typ: require_row, names),
        throw_row: rewrite(typ: throw_row, names)
      )
    | TyBorrow(inner) -> return TyBorrow(inner: rewrite(typ: inner, names))
    | TyArray(elem) -> return TyArray(elem: rewrite(typ: elem, names))
    | TyList(elem) -> return TyList(elem: rewrite(typ: elem, names))
    | TyRecord(fields) -> return TyRecord(fields: rewrite_named(nts: fields, names))
    | TyRow(
      types,
      rest
    ) -> return TyRow(types: rewrite_list(ts: types, names), rest: rewrite_opt(t: rest, names))
    | TyHandler(name, requires) -> return TyHandler(name, requires: rewrite(typ: requires, names))
    | _ -> return typ
  end
end

/** `type_params_to_vars` over each parameter's type. */
export let mir_params_to_vars = fn (params: [ MirParam ], names: [ string ]) -> [ MirParam ] do
  match params do
    | [] -> return []
    | MirParam(label, name, typ) :: rest ->
      return MirParam(
        label,
        name,
        typ: type_params_to_vars(typ, names)
      ) :: mir_params_to_vars(params: rest, names)
  end
end

let has_name = fn (names: [ string ], name: string) -> bool do
  match names do
    | [] -> return false
    | n :: rest -> if n == name then return true else return has_name(names: rest, name) end
  end
end

let rewrite_list = fn (ts: [ TypeExpr ], names: [ string ]) -> [ TypeExpr ] do
  match ts do
    | [] -> return []
    | t :: rest -> return rewrite(typ: t, names) :: rewrite_list(ts: rest, names)
  end
end

let rewrite_named = fn (nts: [ NamedType ], names: [ string ]) -> [ NamedType ] do
  match nts do
    | [] -> return []
    | NamedType(name, typ) :: rest ->
      return NamedType(name, typ: rewrite(typ, names)) :: rewrite_named(nts: rest, names)
  end
end

let rewrite_opt = fn (t: Option<TypeExpr>, names: [ string ]) -> Option<TypeExpr> do
  match t do
    | Some(val: inner) -> return Some(val: rewrite(typ: inner, names))
    | None -> return None
  end
end

/** `type_params_to_vars` over a whole MIR function: parameters, return type
 *  and every type carried by statements and expressions in its body. */
export let function_type_params_to_vars = fn (
  func: MirFunction,
  names: [ string ]
) -> MirFunction do
  match names do
    | [] -> return func
    | _ ->
      let MirFunction(name, params, ret_type, body, span) = func
      return MirFunction(
        name,
        params: mir_params_to_vars(params, names),
        ret_type: rewrite(typ: ret_type, names),
        body: stmts_go(stmts: body, names),
        span
      )
  end
end

let stmts_go = fn (stmts: [ MirStmt ], names: [ string ]) -> [ MirStmt ] do
  match stmts do
    | [] -> return []
    | s :: rest -> return stmt_go(stmt: s, names) :: stmts_go(stmts: rest, names)
  end
end

let opt_stmts_go = fn (stmts: Option<[ MirStmt ]>, names: [ string ]) -> Option<[ MirStmt ]> do
  match stmts do
    | Some(val: ss) -> return Some(val: stmts_go(stmts: ss, names))
    | None -> return None
  end
end

let stmt_go = fn (stmt: MirStmt, names: [ string ]) -> MirStmt do
  match stmt do
    | MirStmtLet(name, typ, expr) ->
      return MirStmtLet(name, typ: rewrite(typ, names), expr: expr_go(expr, names))
    | MirStmtExpr(expr) -> return MirStmtExpr(expr: expr_go(expr, names))
    | MirStmtReturn(expr) -> return MirStmtReturn(expr: expr_go(expr, names))
    | MirStmtAssign(target, value) ->
      return MirStmtAssign(target: expr_go(expr: target, names), value: expr_go(expr: value, names))
    | MirStmtTry(body, catch_param, catch_body) ->
      return MirStmtTry(
        body: stmts_go(stmts: body, names),
        catch_param,
        catch_body: stmts_go(stmts: catch_body, names)
      )
    | MirStmtInjectResume(
      body_fn,
      handler_arm_fns,
      handler_arm_tags,
      ret_type,
      handler_arm_cont_binders
    ) ->
      return MirStmtInjectResume(
        body_fn,
        handler_arm_fns,
        handler_arm_tags,
        ret_type: rewrite(typ: ret_type, names),
        handler_arm_cont_binders
      )
  end
end

let exprs_go = fn (exprs: [ MirExpr ], names: [ string ]) -> [ MirExpr ] do
  match exprs do
    | [] -> return []
    | e :: rest -> return expr_go(expr: e, names) :: exprs_go(exprs: rest, names)
  end
end

let args_go = fn (args: [ MirCallArg ], names: [ string ]) -> [ MirCallArg ] do
  match args do
    | [] -> return []
    | MirCallArg(label, value) :: rest ->
      return MirCallArg(label, value: expr_go(expr: value, names)) :: args_go(args: rest, names)
  end
end

let named_go = fn (fields: [ MirNamedExpr ], names: [ string ]) -> [ MirNamedExpr ] do
  match fields do
    | [] -> return []
    | MirNamedExpr(name, value) :: rest ->
      return MirNamedExpr(name, value: expr_go(expr: value, names)) :: named_go(fields: rest, names)
  end
end

let cases_go = fn (cases: [ MirMatchCase ], names: [ string ]) -> [ MirMatchCase ] do
  match cases do
    | [] -> return []
    | MirMatchCase(pattern, body) :: rest ->
      return MirMatchCase(
        pattern,
        body: stmts_go(stmts: body, names)
      ) :: cases_go(cases: rest, names)
  end
end

let expr_go = fn (expr: MirExpr, names: [ string ]) -> MirExpr do
  match expr do
    | MirBinaryOp(left, op, right) ->
      return MirBinaryOp(left: expr_go(expr: left, names), op, right: expr_go(expr: right, names))
    | MirCall(func, args, ret_type) ->
      return MirCall(func, args: args_go(args, names), ret_type: rewrite(typ: ret_type, names))
    | MirConstructor(name, args) -> return MirConstructor(name, args: exprs_go(exprs: args, names))
    | MirRecord(fields) -> return MirRecord(fields: named_go(fields, names))
    | MirArray(elems) -> return MirArray(elems: exprs_go(exprs: elems, names))
    | MirIndex(target, index) ->
      return MirIndex(target: expr_go(expr: target, names), index: expr_go(expr: index, names))
    | MirFieldAccess(
      target,
      field
    ) -> return MirFieldAccess(target: expr_go(expr: target, names), field)
    | MirIf(cond, then_body, else_body) ->
      return MirIf(
        cond: expr_go(expr: cond, names),
        then_body: stmts_go(stmts: then_body, names),
        else_body: opt_stmts_go(stmts: else_body, names)
      )
    | MirMatch(target, cases) ->
      return MirMatch(target: expr_go(expr: target, names), cases: cases_go(cases, names))
    | MirWhile(cond, body) ->
      return MirWhile(cond: expr_go(expr: cond, names), body: stmts_go(stmts: body, names))
    | MirRaise(expr: e) -> return MirRaise(expr: expr_go(expr: e, names))
    | MirForce(expr: e) -> return MirForce(expr: expr_go(expr: e, names))
    | MirMakeClosure(func_name, captures) ->
      return MirMakeClosure(func_name, captures: exprs_go(exprs: captures, names))
    | MirCallClosure(closure, args, ret_type) ->
      return MirCallClosure(
        closure: expr_go(expr: closure, names),
        args: args_go(args, names),
        ret_type: rewrite(typ: ret_type, names)
      )
    | MirSuspend(tag_name, payload, ret_type) ->
      return MirSuspend(
        tag_name,
        payload: expr_go(expr: payload, names),
        ret_type: rewrite(typ: ret_type, names)
      )
    | MirResume(cont_var, value, ret_type) ->
      return MirResume(
        cont_var,
        value: expr_go(expr: value, names),
        ret_type: rewrite(typ: ret_type, names)
      )
    | MirBlock(stmts) -> return MirBlock(stmts: stmts_go(stmts, names))
    | MirInjectValue(stmts, ret_type) ->
      return MirInjectValue(stmts: stmts_go(stmts, names), ret_type: rewrite(typ: ret_type, names))
    | _ -> return expr
  end
end

/** `type_params_to_vars` over an enum's own type parameters, in both
 *  `variants` and `layout_variants`. */
export let enum_def_params_to_vars = fn (def: EnumDef) -> EnumDef do
  let EnumDef(name, is_public, is_opaque, type_params, variants, layout_variants, module) = def
  match type_params do
    | [] -> return def
    | _ ->
      return EnumDef(
        name,
        is_public,
        is_opaque,
        type_params,
        variants: variants_go(vs: variants, names: type_params),
        layout_variants: variants_go(vs: layout_variants, names: type_params),
        module
      )
  end
end

/** `type_params_to_vars` over a record's own type parameters. */
export let record_def_params_to_vars = fn (def: RecordDef) -> RecordDef do
  let RecordDef(name, is_public, type_params, fields) = def
  match type_params do
    | [] -> return def
    | _ -> return RecordDef(
      name,
      is_public,
      type_params,
      fields: rewrite_named(nts: fields, names: type_params)
    )
  end
end

let variants_go = fn (vs: [ VariantDef ], names: [ string ]) -> [ VariantDef ] do
  match vs do
    | [] -> return []
    | VariantDef(name, fields) :: rest ->
      return VariantDef(
        name,
        fields: variant_fields_go(fs: fields, names)
      ) :: variants_go(vs: rest, names)
  end
end

let variant_fields_go = fn (fs: [ VariantField ], names: [ string ]) -> [ VariantField ] do
  match fs do
    | [] -> return []
    | VariantField(name, typ) :: rest ->
      return VariantField(name, typ: rewrite(typ, names)) :: variant_fields_go(fs: rest, names)
  end
end
