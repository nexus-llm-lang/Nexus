/**
 * repr_check: reports LIR bindings that allocate a heap object but record
 * the scalar `i64` as their type instead of `TyPtr`.
 *
 * A binding is reported when its expression is a constructor, a record or a
 * closure allocation and its `LirStmtLet` type, after peeling linear/borrow
 * wrappers, is `TyI64`. Statement bodies nested in `if`, `if`-return, loops
 * and `try`/`catch` are walked.
 */
import * as list from "std:list"
import { TypeExpr, TyI64 } from "src/types/type_expr.nx"
import { peel_linear } from "src/backend/wasm/defs.nx"
import {
  LirProgram,
  LirFunction,
  LirStmt,
  LirExpr,
  LirStmtLet,
  LirStmtIf,
  LirStmtIfReturn,
  LirStmtLoop,
  LirStmtTryCatch,
  LirExprConstructor,
  LirExprRecord,
  LirExprMakeClosure
} from "src/ir/lir/types.nx"

/** One message per heap-allocating binding typed `i64`, in program order. */
export let check_repr = fn (program: LirProgram) -> [ string ] do
  let LirProgram(functions, externals: _) = program
  return list.reverse(xs: check_functions(funcs: functions, acc: []))
end

let check_functions = fn (funcs: [ LirFunction ], acc: [ string ]) -> [ string ] do
  match funcs do
    | [] -> return acc
    | LirFunction(name, params: _, ret_type: _, body, ret: _, span: _) :: rest ->
      return check_functions(funcs: rest, acc: check_stmts(fname: name, stmts: body, acc))
  end
end

let check_stmts = fn (fname: string, stmts: [ LirStmt ], acc: [ string ]) -> [ string ] do
  match stmts do
    | [] -> return acc
    | s :: rest -> return check_stmts(fname, stmts: rest, acc: check_stmt(fname, stmt: s, acc))
  end
end

let check_stmt = fn (fname: string, stmt: LirStmt, acc: [ string ]) -> [ string ] do
  match stmt do
    | LirStmtLet(name, typ, expr) ->
      if allocates(expr) && is_scalar_i64(typ) then
        return (fname ++ ": heap binding '" ++ name ++ "' is typed i64") :: acc
      end
      return acc
    | LirStmtIf(cond: _, then_body, else_body) ->
      return check_stmts(fname, stmts: else_body, acc: check_stmts(fname, stmts: then_body, acc))
    | LirStmtIfReturn(cond: _, then_body, then_ret: _, else_body, else_ret: _, ret_type: _) ->
      return check_stmts(fname, stmts: else_body, acc: check_stmts(fname, stmts: then_body, acc))
    | LirStmtLoop(cond_stmts, cond: _, body) ->
      return check_stmts(fname, stmts: body, acc: check_stmts(fname, stmts: cond_stmts, acc))
    | LirStmtTryCatch(
      body,
      body_ret: _,
      catch_param: _,
      catch_param_typ: _,
      catch_body,
      catch_ret: _
    ) ->
      return check_stmts(fname, stmts: catch_body, acc: check_stmts(fname, stmts: body, acc))
  end
end

let allocates = fn (expr: LirExpr) -> bool do
  match expr do
    | LirExprConstructor(name: _, args: _, typ: _) -> return true
    | LirExprRecord(fields: _, typ: _) -> return true
    | LirExprMakeClosure(func_name: _, captures: _, typ: _) -> return true
    | _ -> return false
  end
end

let is_scalar_i64 = fn (typ: TypeExpr) -> bool do
  match peel_linear(typ) do
    | TyI64 -> return true
    | _ -> return false
  end
end
