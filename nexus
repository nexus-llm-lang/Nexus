exec wasmtime run \
  -W "$W_FLAGS" \
  -S threads \
  --dir=. --dir="${TMPDIR:-/tmp}" \
  ${NEXUS_WASMTIME_ARGS:-} \
  "$PAYLOAD_WASM" "$@"
