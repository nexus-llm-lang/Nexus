exec wasmtime run \
  -W "$W_FLAGS" \
  --dir=. --dir="${TMPDIR:-/tmp}" \
  ${NXLIB_FLAG:+"$NXLIB_FLAG"} \
  ${NEXUS_WASMTIME_ARGS:-} \
  "$PAYLOAD_WASM" "$@"
