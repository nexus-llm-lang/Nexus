// Sends one Net.get to a host under the reserved `.invalid` TLD (which never
// resolves) and ignores the RequestError. A program that calls it reaches Net,
// so `nexus build` emits a component.
import { Net, RequestError } from "std:network"

export let reach_net = fn () -> unit require { Net } do
  try
    let _ignored = Net.get(url: "http://nexus-test.invalid/")
  catch
    | RequestError(url: _) -> ()
  end
  return ()
end
