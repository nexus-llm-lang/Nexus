// expect-fail: E2001
// expect-msg: callee has no throws annotation
// As cap_call_nothrow_in_closed_arm_test.nx, but Ping.ping declares
// throws { Exn }, so the helper may raise and the closed arm rejects it.
cap Ping do
  fn ping() -> unit throws { Exn }
end

cap Work do
  fn run() -> unit
end

let pinger = handler Ping do
  fn ping() -> unit throws { Exn } do
    return ()
  end
end

let helper = fn () -> unit require { Ping } do
  Ping.ping()
  return ()
end

let worker = handler Work require { Ping } do
  fn run() -> unit do
    return helper()
  end
end

let main = fn () -> unit do
  inject pinger do
    inject worker do
      Work.run()
    end
  end
  return ()
end
