// expect-fail: E2001
//
// A top-level value binding denotes its value (`i64` here), not a nullary
// function, so it cannot be passed where `() -> i64` is expected. This used
// to typecheck and emit invalid wasm.

let n = 5

let take = fn (f: () -> i64) -> i64 do
  return f()
end

let main = fn () -> unit do
  let v = take(f: n)
  return ()
end
