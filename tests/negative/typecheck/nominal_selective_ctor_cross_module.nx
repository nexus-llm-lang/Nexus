// expect-fail: E2001
//
// A selectively imported constructor `Ci` builds module b's `Sh`; it is not
// assignable to the annotation `Sh` imported from module a.

import { Sh } from "tests/_fixtures/nominal_ctor_a.nx"
import { Ci } from "tests/_fixtures/nominal_ctor_b.nx"

let main = fn () -> unit do
  let x: Sh = Ci(s: "hello")
  return ()
end
