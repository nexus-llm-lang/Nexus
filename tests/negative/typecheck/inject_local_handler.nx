// expect-fail: E2001
// expect-msg: top-level handler
//
// `inject` takes top-level handler bindings; a handler bound with `let`
// inside a function body is rejected at typecheck (code generation has no
// mapping for it).

cap Calc do
  fn m(x: i64) -> i64
end

let use_calc = fn () -> i64 require { Calc } do
  return Calc.m(x: 1)
end

let mk = fn (v: i64) -> i64 do
  let h = handler Calc do
    fn m(x: i64) -> i64 do return v + x end
  end
  return inject h do use_calc() end
end

let main = fn () -> unit do
  let n = mk(v: 41)
  return ()
end
