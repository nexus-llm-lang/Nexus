// expect-fail: E2001
// expect-msg: type parameter
//
// Two distinct type parameters cannot be identified with each other inside the
// body: returning `y: U` where `T` is expected would let a caller pick `T` and
// `U` independently and read an integer back as a string.

let swap = fn <T, U>(x: T, y: U) -> T do
  return y
end

let main = fn () -> unit do
  let s: string = swap(x: "a", y: 1)
  return ()
end
