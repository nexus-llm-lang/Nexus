// expect-fail: E2001
// expect-msg: duplicate argument label `a`
//
// A call may pass each parameter label at most once. Accepting `a` twice
// previously bound the extra argument to the next parameter (`b`).

let f = fn (a: i64, b: i64) -> i64 do
  return a * 10 + b
end

let main = fn () -> unit do
  let n = f(a: 1, a: 2, b: 3)
  return ()
end
