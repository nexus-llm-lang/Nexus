// expect-fail: E2001
// expect-msg: nested inside a field
//
// `@` forces one level: a thunk type argument that an enum stores inside
// another type (here a list) cannot be reached.
type Bag<T> = Bag(items: [ T ])

let main = fn () -> unit do
  let @a = 1
  let b = @Bag(items: [ a ])
  return ()
end
