// expect-fail: E2001
// expect-msg: type parameter `T`
//
// Inside a handler defined in a generic function body, the function's type
// parameter `T` stays rigid: an arm cannot return a `T` value as `i64`.

cap Calc do
  fn m(x: i64) -> i64
end

let mk = fn <T>(v: T) -> i64 do
  let h = handler Calc do
    fn m(x: i64) -> i64 do return v end
  end
  return 0
end

let main = fn () -> unit do
  let n = mk(v: "s")
  return ()
end
