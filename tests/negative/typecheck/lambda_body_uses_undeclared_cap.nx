// expect-fail: E2001
// expect-msg: requires capability 'Console'
//
// A lambda body is typed under the lambda's own require row (T-Lambda), not
// the row of the function that builds it. `h` declares no require row, so its
// `Console.println` call is rejected even though `mk` itself requires Console.
// Accepting it would let `main` call `h` after the `inject` that supplied
// Console has ended.
import { Console }, * as stdio from "std:stdio"

let mk = fn () -> (() -> unit) require { Console } do
  let h = fn () -> unit do
    Console.println(val: "leaked")
    return ()
  end
  return h
end

let main = fn () -> unit require { PermConsole } do
  let h = inject stdio.system_handler do mk() end
  h()
  return ()
end
