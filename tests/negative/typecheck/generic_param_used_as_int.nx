// expect-fail: E2001
// expect-msg: type parameter `T`
//
// Integer arithmetic on a value of rigid type `T` instantiates `T` to an
// integer type inside the body; it is rejected.

let bump = fn <T>(x: T) -> T do
  return x + 1
end

let main = fn () -> unit do
  let s = bump(x: "s")
  return ()
end
