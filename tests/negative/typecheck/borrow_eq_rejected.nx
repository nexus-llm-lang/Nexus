// expect-fail: E2001
// expect-msg: cannot compare values of type `&
//
// Borrows (`&T`) are views of a binding, not values: `==` between two borrow
// parameters is rejected by the comparable(τ) predicate.

let same = fn (a: &i64, b: &i64) -> bool do
  return a == b
end

let main = fn () -> unit do
  let x: i64 = 1
  let y: i64 = 2
  let r = same(a: &x, b: &y)
  return ()
end
