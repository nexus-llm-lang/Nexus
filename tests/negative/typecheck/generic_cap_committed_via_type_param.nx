// expect-fail: E2001
// expect-msg: element type incompatible with the handler
//
// A polymorphic function with a bare `require { Store }` that passes its own
// type parameter to the cap (`Store.put(x: v)` with `v: U`) publishes
// `Store<U>`. Calling it at `U = string` under an `i64` handler is rejected;
// otherwise the handler's i64 parameter would receive a string.
cap Store<T> do fn put(x: T) -> unit end

let si = handler Store do
  fn put(x: i64) -> unit do return () end
end

let g = fn <U>(v: U) -> unit require { Store } do
  Store.put(x: v)
  return ()
end

let main = fn () -> unit do
  inject si do g(v: "str") end
  return ()
end
