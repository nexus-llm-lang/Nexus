// expect-fail: E2001
// expect-msg: type mismatch
//
// A `return` inside a thunk body returns from the thunk when it is forced, so
// its value is checked against the thunk's value type (`i64` here), not the
// enclosing function's return type (`string`).
import * as str from "std:str"

let f = fn (c: bool) -> string do
  let @t = if c then return "hello" else 1 end
  return str.from_i64(val: @t + 1)
end

let main = fn () -> unit do
  let s = f(c: true)
  return ()
end
