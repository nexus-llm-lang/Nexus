// expect-fail: E2001
//
// `==` between two `@i64` thunks is rejected: it would compare the thunks'
// closure pointers (equal-valued thunks compared unequal), not their values.

let cmp_thunks = fn (@a: @i64, @b: @i64) -> bool do
  return a == b
end

let main = fn () -> unit do
  let @x = 1
  let @y = 2
  cmp_thunks(a: x, b: y)
  return ()
end
