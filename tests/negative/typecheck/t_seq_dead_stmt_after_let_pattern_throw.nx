// expect-fail: E2021
// expect-msg: unreachable code after diverging statement
//
// A destructuring `let p = throw e` diverges, so the statement after it is
// dead code.
exception Boom

let f = fn () -> i64 throws { Exn } do
  let { a: y } = throw Boom
  return 1
end

let main = fn () -> unit do
  return ()
end
