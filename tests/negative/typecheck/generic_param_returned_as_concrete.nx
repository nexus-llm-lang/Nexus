// expect-fail: E2001
// expect-msg: type parameter `T`
//
// A declared type parameter is rigid inside its own function body: `T` cannot
// be instantiated to `i64` there, otherwise `leak(x: "s")` would hand a string
// pointer back as an integer.

let leak = fn <T>(x: T) -> i64 do
  return x
end

let main = fn () -> unit do
  let n = leak(x: "s")
  return ()
end
