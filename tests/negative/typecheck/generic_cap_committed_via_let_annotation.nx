// expect-fail: E2001
// expect-msg: element type incompatible with the handler
//
// A bare `require { Store }` body that commits the generic cap's element type
// through a `let` annotation (`let s: string = Store.get()`) publishes
// `Store<string>`. Running it under an `i64` handler is rejected; otherwise
// the handler's i64 result would be read as a string pointer.
cap Store<T> do fn get() -> T end

let si = handler Store do
  fn get() -> i64 do return 42 end
end

let use_str = fn () -> string require { Store } do
  let s: string = Store.get()
  return s
end

let main = fn () -> unit do
  let r = inject si do use_str() end
  return ()
end
