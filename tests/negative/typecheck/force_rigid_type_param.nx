// expect-fail: E2001
// expect-msg: type parameter `T`
//
// Forcing a parameter of rigid type `T` requires `T` to be a thunk type, which
// instantiates `T` inside its own body. `force(f: 12345)` would otherwise force
// an integer as if it were a closure.

let force = fn <T>(@f: T) -> T do
  return @f
end

let main = fn () -> unit do
  let v = force(f: 12345)
  return ()
end
