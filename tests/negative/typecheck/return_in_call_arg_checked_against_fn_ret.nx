// expect-fail: E2001
// expect-msg: return type mismatch
//
// A `return` nested inside a call argument returns from the enclosing
// function, so its value is checked against that function's return type
// (`i64`), not `unit`.
let id = fn (x: i64) -> i64 do return x end

let f = fn (c: bool) -> i64 do
  let y = id(x: match c do
    | true -> return ()
    | false -> 1
  end)
  return y
end

let main = fn () -> unit do
  let v = f(c: true)
  return ()
end
