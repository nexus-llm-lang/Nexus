// expect-fail: E2024
// expect-msg: undefined variable 'inner'
//
// A binding introduced inside `inject ... do ... end` is not visible after the
// block ends.

import * as fs from "std:fs"

let body = fn () -> i64 require { PermFs } do
  inject fs.system_handler do
    let inner = 42
  end
  // `inner` should not be visible here.
  return inner
end

let main = fn () -> unit require { PermFs } do
  body()
  return ()
end
