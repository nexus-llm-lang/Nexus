// expect-fail: E2001
//
// The body of a handler defined inside a function is typechecked: returning a
// string from an arm declared `-> i64` is rejected.

cap Calc do
  fn m(x: i64) -> i64
end

let mk = fn () -> i64 do
  let h = handler Calc do
    fn m(x: i64) -> i64 do return "not an int" end
  end
  return 0
end

let main = fn () -> unit do
  let n = mk()
  return ()
end
