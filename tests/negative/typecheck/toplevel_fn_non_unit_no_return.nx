// expect-fail: E2001
//
// Negative fixture — T-Lambda premise τ_r ≠ unit ⟹ tail(s†) = ⊥. A top-level
// function declaring `-> bool` that falls off the end without a `return` on
// all paths must be REJECTED. The body here has a unit-result let-binding as
// its last statement, so the tail is unit not bool.
let check = fn (x: i64) -> bool do
  x
end

let main = fn () -> unit do
  check(x: 1)
  return ()
end
