// expect-fail: E2001
//
// A nullary function is a function value, not the value it returns: passing it
// where `i64` is expected used to hand over the closure pointer as an integer.

let k = fn () -> i64 do return 7 end

let show = fn (x: i64) -> i64 do
  return x
end

let main = fn () -> unit do
  let v = show(x: k)
  return ()
end
