// expect-fail: E2001
// expect-msg: requires the cap it provides
// A handler for Greeter that also requires Greeter: its arms' Greeter calls
// would dispatch back to itself, so the binding is rejected.
cap Greeter do
  fn greet(name: string) -> string
end

let base = handler Greeter do
  fn greet(name: string) -> string do
    return "hello " ++ name
  end
end

let wrapper = handler Greeter require { Greeter } do
  fn greet(name: string) -> string do
    return "[" ++ Greeter.greet(name) ++ "]"
  end
end

let main = fn () -> unit do
  inject base do
    inject wrapper do
      let _ignored = Greeter.greet(name: "x")
    end
  end
  return ()
end
