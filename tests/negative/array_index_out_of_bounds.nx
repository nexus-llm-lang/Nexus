// expect-runtime-throw: unreachable
// expect-msg: before index
//
// Reading one past the end of an array traps instead of loading the heap
// word that follows the array.

import { Console, system_handler } from "std:stdio"
import * as str from "std:str"

let main = fn () -> unit require { PermConsole } do
  inject system_handler do
    Console.println(val: "before index")
    let i = 3
    let v = [| 1, 2, 3 |][i]
    Console.println(val: "read " ++ str.from_i64(val: v))
  end
  return ()
end
