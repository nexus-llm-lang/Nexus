// expect-fail: E2007
// expect-msg: never consumed
//
// A function that main never calls is still checked for linearity: `%b` is
// created and never consumed.

import * as bb from "std:bytebuffer"

let leaky = fn () -> unit do
  let %b = bb.empty()
  return ()
end

let main = fn () -> unit do
  return ()
end
