// expect-fail: E2008
// expect-msg: consumed more than once
//
// A record literal holding a linear closure (one that captured `%t`) is a
// linear record. Destructuring it binds the closure field linearly, so
// calling the bound closure twice is rejected.
type Tok = Tok(n: i64)

let eat = fn (%t: Tok) -> i64 do
  let Tok(n) = %t
  return n
end

let main = fn () -> unit do
  let %t = Tok(n: 1)
  let f = fn () -> i64 do return eat(t: %t) end
  let pair = { a: f, b: 1 }
  let { a, b } = pair
  let x = a()
  let y = a()
  return ()
end
