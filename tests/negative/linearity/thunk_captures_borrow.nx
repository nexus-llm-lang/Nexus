// expect-fail: E2001
// expect-msg: thunk captures borrow
//
// A thunk cannot close over a borrow: forcing it after the owner is consumed
// would read the released value.
import * as bb from "std:bytebuffer"

let main = fn () -> unit do
  let %buf = bb.empty()
  let @n = bb.length(buf: &buf)
  bb.free(buf: %buf)
  let v = @n
  return ()
end
