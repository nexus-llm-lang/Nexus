// expect-fail: E2001
// expect-msg: thunk captures borrow
//
// A thunk cannot close over a binding whose type is a borrow either.
import { ByteBuffer }, * as bb from "std:bytebuffer"

let lazy_len = fn (b: &ByteBuffer) -> i64 do
  let @n = bb.length(buf: b)
  return @n
end

let main = fn () -> unit do
  let %buf = bb.empty()
  let n = lazy_len(b: &buf)
  bb.free(buf: %buf)
  return ()
end
