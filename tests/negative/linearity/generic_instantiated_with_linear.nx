// expect-fail: E2001
// expect-msg: a linear value cannot be passed
//
// A function type parameter ranges over sigil-free types: instantiating `T`
// with a linear type would let `dup` copy the resource.
import { ByteBuffer }, * as bb from "std:bytebuffer"

let dup = fn <T>(x: T) -> [ T ] do
  return [ x, x ]
end

let main = fn () -> unit do
  let %buf = bb.empty()
  let xs = dup(x: %buf)
  return ()
end
