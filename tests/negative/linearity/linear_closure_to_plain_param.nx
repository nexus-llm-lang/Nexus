// expect-fail: E2001
// expect-msg: a linear value cannot be passed
//
// A closure that captures a linear binding is itself linear; passing it to a
// parameter of plain function type would let the callee call it twice.
import { ByteBuffer }, * as bb from "std:bytebuffer"

let twice = fn (f: () -> unit) -> unit do
  f()
  f()
  return ()
end

let main = fn () -> unit do
  let %b = bb.empty()
  twice(f: fn () -> unit do bb.free(buf: %b) end)
  return ()
end
