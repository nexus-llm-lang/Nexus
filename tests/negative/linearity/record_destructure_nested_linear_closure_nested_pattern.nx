// expect-fail: E2008
// expect-msg: consumed more than once
//
// A linear closure nested two record levels deep keeps its linearity
// through destructuring (nested pattern), so calling it twice is rejected.
type Tok = Tok(n: i64)

let eat = fn (%t: Tok) -> i64 do
  let Tok(n) = %t
  return n
end

let main = fn () -> unit do
  let %t = Tok(n: 1)
  let f = fn () -> i64 do return eat(t: %t) end
  let outer = { inner: { a: f } }
  let { inner: { a } } = outer
  let x = a()
  let y = a()
  return ()
end
