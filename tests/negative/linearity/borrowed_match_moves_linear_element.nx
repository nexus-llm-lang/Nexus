// expect-fail: E2001
//
// Matching a borrowed list binds its linear elements as borrows, so returning
// one where an owned value is expected is rejected.
import { ByteBuffer }, * as bb from "std:bytebuffer"

let steal = fn (xs: &[ %ByteBuffer ]) -> %ByteBuffer do
  match xs do
    | h :: _ -> return h
    | [] -> return bb.empty()
  end
end

let main = fn () -> unit do
  let xs = [ bb.empty() ]
  bb.free(buf: steal(xs: &xs))
  match xs do
    | h :: t ->
      bb.free(buf: h)
      match t do
        | [] -> ()
        | rest -> bb.free(buf: steal(xs: &rest))
      end
    | [] -> ()
  end
  return ()
end
