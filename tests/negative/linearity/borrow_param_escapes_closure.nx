// expect-fail: E2022
//
// A closure capturing a borrow parameter of a resource type cannot be
// returned: the caller may free the owner (`bb.free(buf: %x)`) and then call
// the closure, which would read the freed buffer.

import * as bb from "std:bytebuffer"

let mk = fn (b: &bb.ByteBuffer) -> () -> i64 do
  return fn () -> i64 do return bb.length(buf: b) end
end

let main = fn () -> unit do
  let %x = bb.empty()
  let g = mk(b: &%x)
  bb.free(buf: %x)
  let n = g()
  return ()
end
