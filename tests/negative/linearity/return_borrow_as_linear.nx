// expect-fail: E2001
// expect-msg: return type mismatch
//
// A borrow cannot be returned where an owned linear value is expected.
import { ByteBuffer }, * as bb from "std:bytebuffer"

let own = fn (b: &ByteBuffer) -> %ByteBuffer do
  return b
end

let main = fn () -> unit do
  let %x = bb.empty()
  let %y = own(b: &x)
  bb.free(buf: %y)
  bb.free(buf: %x)
  return ()
end
