// expect-fail: E2001
// expect-msg: expected linear type
//
// Same as closure_capturing_linear_param_returned_nonlinear.nx, with the
// closure inside a record literal returned under a non-linear field type.
type Tok = Tok(n: i64)

let eat = fn (%t: Tok) -> i64 do
  let Tok(n) = %t
  return n
end

let mk = fn (%t: Tok) -> { a: () -> i64, b: i64 } do
  let f = fn () -> i64 do return eat(t: %t) end
  return { a: f, b: 1 }
end

let main = fn () -> unit do
  let r = mk(t: Tok(n: 1))
  return ()
end
