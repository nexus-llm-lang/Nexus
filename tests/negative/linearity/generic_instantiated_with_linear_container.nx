// expect-fail: E2001
// expect-msg: sigil
//
// The restriction covers types that contain a sigil, not only an outermost
// one: `[ %ByteBuffer ]` cannot instantiate `T` either.
import { ByteBuffer }, * as bb from "std:bytebuffer"

let dup = fn <T>(x: T) -> [ T ] do
  return [ x, x ]
end

let main = fn () -> unit do
  let xs = [ bb.empty() ]
  let ys = dup(x: xs)
  return ()
end
