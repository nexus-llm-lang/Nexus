// expect-fail: E2022
//
// A thunk capturing a borrow parameter of a resource type cannot be returned:
// forcing it after the caller frees the owner would read freed memory.

import * as bb from "std:bytebuffer"

let mk = fn (b: &bb.ByteBuffer) -> @i64 do
  let @t = bb.length(buf: b)
  return t
end

let main = fn () -> unit do
  let %x = bb.empty()
  let @t = mk(b: &%x)
  bb.free(buf: %x)
  let n = @t
  return ()
end
