// expect-fail: E2001
// expect-msg: thunk captures borrow
//
// A thunk cannot capture a borrow (here the borrow parameter `b`, and `&%x` in
// main): forcing it after the owner is freed would read freed memory.

import * as bb from "std:bytebuffer"

let mk = fn (b: &bb.ByteBuffer) -> @i64 do
  let @t = bb.length(buf: b)
  return t
end

let main = fn () -> unit do
  let %x = bb.empty()
  let @t = mk(b: &%x)
  bb.free(buf: %x)
  let n = @t
  return ()
end
