// expect-fail: E2001
// expect-msg: cannot discard linear type
//
// A wildcard arm cannot discard a value whose enum carries a linear field.
import { ByteBuffer }, * as bb from "std:bytebuffer"

type One = One(x: %ByteBuffer)

let main = fn () -> unit do
  let t = One(x: bb.empty())
  match t do
    | _ -> ()
  end
  return ()
end
