// expect-fail: E2001
// expect-msg: cannot discard linear type
//
// `if let` without a matching arm for every variant discards the scrutinee
// when the pattern does not match, which drops the B payload here.
import { ByteBuffer }, * as bb from "std:bytebuffer"

type Two = A(x: %ByteBuffer) | B(y: %ByteBuffer)

let main = fn () -> unit do
  let t = B(y: bb.empty())
  if let A(x) = t then
    bb.free(buf: x)
  end
  return ()
end
