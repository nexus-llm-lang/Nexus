// expect-fail: E2001
// expect-msg: linear
//
// An exception cannot carry a linear value: a catch-all `catch e -> ...` (or
// an uncaught unwind) would drop it without consuming it.

import * as bb from "std:bytebuffer"

exception Carry(b: %bb.ByteBuffer)

let f = fn () -> unit throws { Carry } do
  throw Carry(b: bb.empty())
end

let main = fn () -> unit do
  try
    f()
  catch e -> ()
  end
  return ()
end
