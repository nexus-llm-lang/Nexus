// expect-fail: E2009
//
// T-TryCatch: a diverging catch arm must consume at least what the try
// path consumes. The try path consumes `x`; the catch arm rethrows without
// consuming it, so `x` leaks on the throw path.
exception Boom(code: i64)

type Tok = Tok(n: i64)

let eat = fn (%t: Tok) -> unit do
  let Tok(n: _) = %t
  return ()
end

let risky = fn () -> unit throws { Boom } do
  return ()
end

let f = fn () -> unit throws { Boom } do
  let %x = Tok(n: 1)
  try
    risky()
    eat(t: %x)
  catch e ->
    throw e
  end
  return ()
end

let main = fn () -> unit throws { Exn } do
  f()
  return ()
end
