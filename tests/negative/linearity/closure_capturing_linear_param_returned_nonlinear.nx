// expect-fail: E2001
// expect-msg: expected linear type
//
// A closure that captures a `%` parameter is linear, so it cannot be
// returned under the non-linear type `() -> i64` (the caller could call it
// twice and consume `%t` twice).
type Tok = Tok(n: i64)

let eat = fn (%t: Tok) -> i64 do
  let Tok(n) = %t
  return n
end

let mk = fn (%t: Tok) -> () -> i64 do
  let f = fn () -> i64 do return eat(t: %t) end
  return f
end

let main = fn () -> unit do
  let g = mk(t: Tok(n: 1))
  return ()
end
