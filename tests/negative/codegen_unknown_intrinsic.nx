// expect-fail: E3001
// expect-msg: intrinsic
//
// An external bound to an intrinsic that does not exist fails in codegen;
// the compiler reports E3001 and exits 1.

import external "nexus:intrinsic"
external bogus = "no_such_intrinsic_xyz" : (x: i64) -> i64

let main = fn () -> unit do
  let v = bogus(x: 1)
  return ()
end
