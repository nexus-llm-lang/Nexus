// expect-runtime-throw: RuntimeError: index out of bounds
// expect-msg: before assign
//
// Writing past the end of an array raises a RuntimeError instead of overwriting the heap
// word that follows the array.

import { Console, system_handler } from "std:stdio"

let main = fn () -> unit require { PermConsole } do
  inject system_handler do
    Console.println(val: "before assign")
    let i = 3
    let arr = [| 1, 2, 3 |]
    arr[i] <- 42
    arr
    Console.println(val: "assigned")
  end
  return ()
end
