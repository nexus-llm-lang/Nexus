// expect-fail: E4007
// expect-msg: --p2-component
//
// A core-module build of a program that calls Net fails at compile time:
// the Net externals import `nexus_net`, which only a --p2-component build
// provides.

import { Net }, * as net_mod from "std:network"
import { Console }, * as stdio from "std:stdio"

let main = fn () -> unit require { PermConsole, PermNet } do
  inject net_mod.system_handler, stdio.system_handler do
    try
      Console.println(val: Net.get(url: "https://example.com/"))
    catch _ ->
      Console.println(val: "request failed")
    end
  end
  return ()
end
