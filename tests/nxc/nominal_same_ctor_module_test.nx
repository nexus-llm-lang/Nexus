// A constructor and an annotation that both refer to the same imported `Sh`
// still unify.
import * as test_assert from "std:test/assert"
import { Sh, Sq, get_v } from "tests/_fixtures/nominal_ctor_a.nx"

let main = fn () -> unit throws { Exn } do
  let x: Sh = Sq(v: 7)
  test_assert.assert_eq_i64(actual: get_v(x), expected: 7, label: "same-module Sh")
  return ()
end
