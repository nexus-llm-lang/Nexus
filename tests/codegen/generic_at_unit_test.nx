// A generic function instantiated at `unit` (fold with a unit accumulator)
// produces valid code: the unit argument occupies the erased i64 slot.
import * as test_assert from "std:test/assert"
import * as list from "std:list"

let id = fn <T>(x: T) -> T do
  return x
end

let main = fn () -> unit throws { Exn } do
  list.fold_left(xs: [1, 2, 3], init: (), f: fn (acc: unit, val: i64) -> unit do return () end)
  let u = id(x: ())
  test_assert.assert(cond: true, label: "unit-instantiated generics run")
  return ()
end
