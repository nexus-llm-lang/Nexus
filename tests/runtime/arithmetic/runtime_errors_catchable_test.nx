// Integer division or remainder by zero, i64::MIN / -1, and an out-of-bounds
// array access raise a RuntimeError that try/catch observes.
import * as ta from "std:test/assert"
import * as exn from "std:exn"

let div = fn (a: i64, b: i64) -> i64 do
  return a / b
end

let rem = fn (a: i64, b: i64) -> i64 do
  return a % b
end

let div32 = fn (a: i32, b: i32) -> i32 do
  return a / b
end

let at = fn (i: i64) -> i64 do
  return [| 1, 2, 3 |][i]
end

let caught = fn (f: () -> i64 throws { Exn }) -> string do
  try
    let v = f()
    return "value"
  catch e ->
    return exn.to_string(exn: e)
  end
end

let body = fn () -> unit throws { Exn } do
  let min = 0 - 9223372036854775807 - 1
  ta.assert_eq_string(
    actual: caught(f: fn () -> i64 throws { Exn } do return div(a: 1, b: 0) end),
    expected: "RuntimeError: division by zero",
    label: "div by zero"
  )
  ta.assert_eq_string(
    actual: caught(f: fn () -> i64 throws { Exn } do return rem(a: 1, b: 0) end),
    expected: "RuntimeError: division by zero",
    label: "rem by zero"
  )
  ta.assert_eq_string(
    actual: caught(f: fn () -> i64 throws { Exn } do return div(a: min, b: 0 - 1) end),
    expected: "RuntimeError: integer overflow",
    label: "min / -1"
  )
  ta.assert_eq_string(
    actual: caught(f: fn () -> i64 throws { Exn } do return at(i: 3) end),
    expected: "RuntimeError: index out of bounds",
    label: "array index"
  )
  ta.assert_eq_i64(actual: div(a: 7, b: 2), expected: 3, label: "ordinary division")
  ta.assert_eq_i64(actual: rem(a: min, b: 0 - 1), expected: 0, label: "min % -1")
  ta.assert_true(cond: div32(a: 7, b: 2) == 3, label: "i32 division")
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
