// unit-test
// Dividing by zero where the left operand is read through a `ref(i64)`
// parameter raises the catchable `RuntimeError`, the same as with a plain
// `i64` operand, instead of trapping.
import * as test_assert from "std:test/assert"

let q = fn (r: ref(i64), d: i64) -> i64 do
  return ~r / d
end

let body = fn () -> unit throws { Exn } do
  let ~x = 10
  let ~caught = false
  try
    let z = q(r: x, d: 0)
  catch
    | RuntimeError(val: _) -> ~caught <- true
  end
  test_assert.assert_true(
    cond: ~caught,
    label: "division by zero through a ref operand raises RuntimeError"
  )
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
