// unit-test
// Scalars that pass through type-parameter slots (generic calls, generic
// constructor fields, closures called from generic code) come back with the
// same value: integers, floats, bools, strings, and values compared with
// structural equality.
import * as ta from "std:test/assert"
import * as list from "std:list"
import { Option, Some, None } from "std:option"

type Pair<A, B> = Pair(a: A, b: B)

let first = fn <T>(xs: [ T ], d: T) -> T do
  match xs do
    | [] -> return d
    | v :: _ -> return v
  end
end

let swap = fn <A, B>(p: Pair<A, B>) -> Pair<B, A> do
  let Pair(a, b) = p
  return Pair(a: b, b: a)
end

let body = fn () -> unit throws { Exn } do
  ta.assert_eq_i64(
    actual: first(xs: list.reverse(xs: [ 1, 2, 3 ]), d: 0),
    expected: 3,
    label: "i64 through a generic list"
  )
  ta.assert_eq_i64(
    actual: list.fold_left(
      xs: list.map(xs: [ 1, 2 ], f: fn (val: i64) -> i64 do return val * 10 end),
      init: 0,
      f: fn (acc: i64, val: i64) -> i64 do return acc + val end
    ),
    expected: 30,
    label: "closures over i64 called from generic code"
  )
  ta.assert_true(cond: first(xs: [ 1.5, 2.5 ], d: 0.0) == 1.5, label: "f64 through a generic list")
  ta.assert_eq_string(
    actual: first(xs: [ "x", "y" ], d: "none"),
    expected: "x",
    label: "string through a generic list"
  )
  let Pair(a: s, b: n) = swap(p: Pair(a: 7, b: "seven"))
  ta.assert_eq_string(actual: s, expected: "seven", label: "generic constructor field (string)")
  ta.assert_eq_i64(actual: n, expected: 7, label: "generic constructor field (i64)")
  let flags = list.map(xs: [ 1, 2 ], f: fn (val: i64) -> bool do return val > 1 end)
  ta.assert_true(cond: flags == [ false, true ], label: "bool list equality")
  ta.assert_true(cond: [ 1, 2 ] == [ 1, 2 ], label: "i64 list equality")
  ta.assert_true(cond: Some(val: "a") == Some(val: "a"), label: "Option<string> equality")
  ta.assert_eq_i64_list(
    actual: list.take_b(xs: [ 10, 20, 30 ], n: 2),
    expected: [ 10, 20 ],
    label: "build/foldr with nested closures"
  )
  let @t = 41 + 1
  let forced = @t
  ta.assert_eq_i64(actual: forced, expected: 42, label: "forced thunk result")
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
