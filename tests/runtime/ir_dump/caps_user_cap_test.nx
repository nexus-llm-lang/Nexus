// `nexus caps` credits a user-declared cap (`cap Log`) whose method a function
// calls, alongside the built-in capability names.
import * as test_assert from "std:test/assert"
import { compute_caps_closure, closure_capabilities } from "src/tools/dump/caps_dump.nx"
import { HirProgram, HirCap } from "src/ir/hir/types.nx"
import { mk_function, call_stmt } from "tests/_fixtures/hir_programs.nx"

let main = fn () -> unit throws { Exn } do
  let f = mk_function(
    name: "fixture_nx#via_log",
    body_stmts: [ call_stmt(func: "fixture_nx#Log.log") ]
  )
  let prog = HirProgram(
    caps: [ HirCap(name: "fixture_nx#Log", type_params: [], methods: []) ],
    functions: [ f ],
    externals: [],
    handler_bindings: [],
    enum_defs: [],
    exception_groups: [],
    value_binding_names: [],
    type_defs: [],
    visible_enum_names: [],
    ext_wasm_deps: []
  )
  let caps = closure_capabilities(cl: compute_caps_closure(prog, symbol: "via_log"))
  test_assert.assert_eq_i64(actual: list_len(xs: caps), expected: 1, label: "one capability")
  match caps do
    | [ c ] -> test_assert.assert_eq_string(
      actual: c,
      expected: "Log",
      label: "user cap Log credited"
    )
    | _ -> ()
  end
  return ()
end

let list_len = fn (xs: [ string ]) -> i64 do
  match xs do
    | [] -> return 0
    | _ :: rest -> return 1 + list_len(xs: rest)
  end
end
