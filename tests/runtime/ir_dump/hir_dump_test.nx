// HIR dump (`nexus hir <file> --format=json|text`).
// Updated for the V2 envelope: each HirFunction record's
// `body_pp` string field is replaced by a structured `body` JSON tree.
//
// Exercises `hir_to_text` / `hir_to_json` directly rather than spawning a
// `nexus hir` subprocess. Rationale matches json_format_test.nx and
// mcp_smoke_test.nx: `Proc.exec` returns -1 under WASI preview1 (the
// test harness's runtime), so subprocess invocations never reach actual
// driver code. Direct calls into the dump helpers cover the same code
// path the driver invokes per request.
//
// Coverage:
//   1. Text dump starts with the "=== HIR dump" banner.
//   2. JSON dump parses through std:json and exposes a top-level
//      `{kind: "hir", functions: [...]}` object.
//   3. A non-empty fixture program produces at least one HirFunction
//      record carrying the expected fields (`name`, `params`, `ret_type`,
//      `body`); body is `{kind: "EagerBody", stmts: [...]}` and the
//      single statement is a Return wrapping a literal-42 child.

import * as test_assert from "std:test/assert"
import * as str from "std:str"
import * as list from "std:list"
import * as ir_dump from "src/tools/dump/ir_dump.nx"
import * as json from "std:json"
import { JsonValue, JsonInt } from "std:json"
import { None } from "std:option"
import { HirProgram, HirFunction, EagerBody } from "src/ir/hir/types.nx"
import { LitInt, TyI64, TyUnit, TyRow } from "src/syntax/ast.nx"
import { mk_hir_expr, mk_hir_stmt, empty_hir } from "tests/_fixtures/hir_programs.nx"
import { dummy_span } from "tests/_fixtures/span.nx"
import {
  expect_object, expect_array, expect_string, require_field
} from "tests/_fixtures/json_helpers.nx"

// ─── Fixture: synthesise a minimal HIR program ──────────────────────────────

let synth_program = fn () -> HirProgram do
  // body: return 42
  let lit_expr = mk_hir_expr(node: Literal(lit: LitInt(val: 42)))
  let ret_stmt = mk_hir_stmt(node: Return(expr: lit_expr))
  let body = EagerBody(stmts: [ ret_stmt ])
  let f = HirFunction(
    name: "fortytwo",
    type_params: [],
    params: [],
    ret_type: TyI64,
    throw_row: TyUnit,
    body,
    span: dummy_span(),
    file: "<synth>",
    requires: TyRow(types: [], rest: None)
  )
  return empty_hir(fs: [ f ], exts: [])
end

// ─── Test 1: text dump banner ──────────────────────────────────────────────

let test_text_banner = fn () -> unit throws { Exn } do
  let prog = synth_program()
  let out = ir_dump.hir_to_text(prog)
  let starts_with_banner = str.starts_with(s: out, prefix: "=== HIR dump")
  test_assert.assert_eq_bool(
    actual: starts_with_banner,
    expected: true,
    label: "HIR text dump starts with banner"
  )
  return ()
end

// ─── Test 2: JSON dump shape ───────────────────────────────────────────────

let test_json_shape = fn () -> unit throws { Exn } do
  let prog = synth_program()
  let out = ir_dump.hir_to_json(prog)
  let starts_with_brace = str.starts_with(s: out, prefix: "{")
  test_assert.assert_eq_bool(
    actual: starts_with_brace,
    expected: true,
    label: "HIR JSON output starts with '{'"
  )
  let obj = json.parse(s: out)
  let kind_v = require_field(obj, key: "kind", label: "hir json")
  let kind = expect_string(v: kind_v, label: "hir kind")
  test_assert.assert_eq_string(actual: kind, expected: "hir", label: "kind = hir")
  let funcs_v = require_field(obj, key: "functions", label: "hir json")
  let funcs = expect_array(v: funcs_v, label: "hir functions")
  let n = list.length(xs: funcs)
  test_assert.assert_eq_i64(actual: n, expected: 1, label: "1 synthesised function")
  // Inspect the single function record.
  match funcs do
    | [] -> throw RuntimeError(val: "expected one function")
    | f :: _ ->
      let name_v = require_field(obj: f, key: "name", label: "hir func")
      let name = expect_string(v: name_v, label: "hir func name")
      test_assert.assert_eq_string(actual: name, expected: "fortytwo", label: "name round-trips")
      let ret_v = require_field(obj: f, key: "ret_type", label: "hir func")
      let ret = expect_string(v: ret_v, label: "hir ret_type")
      test_assert.assert_eq_string(actual: ret, expected: "i64", label: "ret_type = i64")
      // params is a JsonArray (empty for this fixture).
      let params_v = require_field(obj: f, key: "params", label: "hir func")
      let params = expect_array(v: params_v, label: "hir params")
      let np = list.length(xs: params)
      test_assert.assert_eq_i64(actual: np, expected: 0, label: "0 params")
      // V2: body is a structured JSON tree, not a stringified pp.
      let body_v = require_field(obj: f, key: "body", label: "hir func")
      let body_kind_v = require_field(obj: body_v, key: "kind", label: "hir body")
      let body_kind = expect_string(v: body_kind_v, label: "hir body kind")
      test_assert.assert_eq_string(
        actual: body_kind,
        expected: "EagerBody",
        label: "body.kind = EagerBody"
      )
      let stmts_v = require_field(obj: body_v, key: "stmts", label: "hir body")
      let stmts = expect_array(v: stmts_v, label: "hir stmts")
      let ns = list.length(xs: stmts)
      test_assert.assert_eq_i64(actual: ns, expected: 1, label: "1 stmt in body")
      // The single stmt is a Return wrapping a Literal(Int, 42).
      match stmts do
        | [] -> throw RuntimeError(val: "expected 1 stmt")
        | stmt :: _ ->
          let stmt_kind_v = require_field(obj: stmt, key: "kind", label: "hir stmt")
          let stmt_kind = expect_string(v: stmt_kind_v, label: "hir stmt kind")
          test_assert.assert_eq_string(
            actual: stmt_kind,
            expected: "Return",
            label: "stmt.kind = Return"
          )
          let children_v = require_field(obj: stmt, key: "children", label: "hir stmt")
          let children = expect_array(v: children_v, label: "hir stmt children")
          let nc = list.length(xs: children)
          test_assert.assert_eq_i64(actual: nc, expected: 1, label: "Return has 1 child")
          match children do
            | [] -> throw RuntimeError(val: "expected 1 child")
            | child :: _ ->
              let ck_v = require_field(obj: child, key: "kind", label: "hir child")
              let ck = expect_string(v: ck_v, label: "hir child kind")
              test_assert.assert_eq_string(
                actual: ck,
                expected: "Literal",
                label: "child.kind = Literal"
              )
              let lk_v = require_field(obj: child, key: "lit_kind", label: "hir child")
              let lk = expect_string(v: lk_v, label: "hir lit_kind")
              test_assert.assert_eq_string(actual: lk, expected: "Int", label: "lit_kind = Int")
              let val_v = require_field(obj: child, key: "value", label: "hir child")
              match val_v do
                | JsonInt(val: n) -> test_assert.assert_eq_i64(
                  actual: n,
                  expected: 42,
                  label: "lit value = 42"
                )
                | _ -> throw RuntimeError(val: "expected JsonInt for literal value")
              end
          end
      end
  end
  return ()
end

let main = fn () -> unit throws { Exn } do
  test_text_banner()
  test_json_shape()
  return ()
end
