// `build_run_cmd` renders the `wasmtime run` hint printed by
// `nexus build --explain-capabilities wasmtime`, per build target.

import * as test_assert from "std:test/assert"
import {
  RunCore,
  RunP2Component,
  RunP3Component,
  build_run_cmd,
  run_target
} from "src/cli/format.nx"

let core_w = "-W tail-call=y -W exceptions=y -W function-references=y -W stack-switching=y -W threads=y"

let body = fn () -> unit throws { Exn } do
  test_assert.assert_eq_string(
    actual: build_run_cmd(output_name: "a.wasm", caps: [ "Console" ], target: RunCore),
    expected: "wasmtime run " ++ core_w ++ " a.wasm",
    label: "core, no flagged caps"
  )
  test_assert.assert_eq_string(
    actual: build_run_cmd(output_name: "a.wasm", caps: [ "Console", "Fs" ], target: RunCore),
    expected: "wasmtime run " ++ core_w ++ " --dir . a.wasm",
    label: "core, Fs preopens cwd"
  )
  test_assert.assert_eq_string(
    actual: build_run_cmd(output_name: "a.wasm", caps: [ "Net" ], target: RunCore),
    expected: "wasmtime run " ++ core_w ++ " a.wasm",
    label: "core, Net has no core flag"
  )
  test_assert.assert_eq_string(
    actual: build_run_cmd(output_name: "a.wasm", caps: [ "Net" ], target: RunP2Component),
    expected: "wasmtime run -W component-model=y -W exceptions=y -S http -S inherit-network a.wasm",
    label: "p2 component, Net"
  )
  test_assert.assert_eq_string(
    actual: build_run_cmd(output_name: "a.wasm", caps: [], target: RunP3Component),
    expected: "wasmtime run -W component-model=y -W component-model-async=y -W exceptions=y -S p3=y a.wasm",
    label: "p3 component"
  )
  test_assert.assert_eq_string(
    actual: build_run_cmd(
      output_name: "a.wasm",
      caps: [],
      target: run_target(p2_component: true, p3_component: true)
    ),
    expected: "wasmtime run -W component-model=y -W component-model-async=y -W exceptions=y -S p3=y a.wasm",
    label: "run_target prefers p3"
  )
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
