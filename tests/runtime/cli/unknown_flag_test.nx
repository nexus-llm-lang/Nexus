// `first_unknown_flag` finds a flag the global parse left among the
// positionals of a subcommand that has no parser of its own.

import * as test_assert from "std:test/assert"
import { Some, None } from "std:option"
import { first_unknown_flag, parse_global_args } from "src/cli/args.nx"
import { InvalidUsage } from "src/diagnostics/error.nx"

let shown = fn (xs: [ string ]) -> string do
  return shown_with(xs, known: [])
end

let shown_with = fn (xs: [ string ], known: [ string ]) -> string do
  match first_unknown_flag(xs, known) do
    | Some(val) -> return val
    | None -> return "<none>"
  end
end

let after_dashdash_rejected = fn (args: [ string ]) -> bool do
  try
    let _flags = parse_global_args(args)
    return false
  catch
    | InvalidUsage(detail: _) -> return true
  end
end

let body = fn () -> unit throws { Exn } do
  test_assert.assert_eq_string(
    actual: shown(xs: [ "build", "main.nx", "--p2-component" ]),
    expected: "--p2-component",
    label: "long flag"
  )
  test_assert.assert_eq_string(
    actual: shown(xs: [ "build", "-x", "main.nx" ]),
    expected: "-x",
    label: "short flag"
  )
  test_assert.assert_eq_string(
    actual: shown(xs: [ "build", "main.nx", "out.wasm" ]),
    expected: "<none>",
    label: "no flag"
  )
  test_assert.assert_eq_string(
    actual: shown(xs: [ "build", "-" ]),
    expected: "<none>",
    label: "bare dash"
  )
  test_assert.assert_eq_string(
    actual: shown_with(xs: [ "types", "main.nx", "--transitive" ], known: [ "--transitive" ]),
    expected: "<none>",
    label: "subcommand-known flag"
  )
  test_assert.assert_eq_string(
    actual: shown_with(xs: [ "types", "--transitive", "--bogus" ], known: [ "--transitive" ]),
    expected: "--bogus",
    label: "unknown flag after a known one"
  )
  test_assert.assert_true(
    cond: after_dashdash_rejected(args: [ "nexus", "build", "main.nx", "--", "a" ]),
    label: "arguments after --"
  )
  test_assert.assert_true(
    cond: !after_dashdash_rejected(args: [ "nexus", "build", "main.nx" ]),
    label: "no arguments after --"
  )
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
