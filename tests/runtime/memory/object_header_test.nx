// unit-test
// A heap object is preceded by a header word: reference count 1 in bits
// 0-23, the object's word count in bits 24-31, and a mask of the words that
// hold pointers in bits 32-63.
import * as ta from "std:test/assert"
import * as mem from "std:runtime/mem"
import { value_to_i64 } from "std:runtime/lazy"

type Cell = Cell(n: i64, rest: [ i64 ])

let header_of = fn (c: Cell) -> i64 do
  let p = value_to_i64(a_x: c) & 4294967295
  return mem.load_i64(addr: p - 8)
end

let body = fn () -> unit throws { Exn } do
  let h = header_of(c: Cell(n: 5, rest: [ 1 ]))
  ta.assert_eq_i64(actual: h & 16777215, expected: 1, label: "reference count")
  ta.assert_eq_i64(actual: (h >> 24) & 255, expected: 3, label: "word count: tag + 2 fields")
  // Fields sit in name order (n, rest), so `rest` is word 2.
  ta.assert_eq_i64(actual: h >> 32, expected: 4, label: "pointer mask: word 2")
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
