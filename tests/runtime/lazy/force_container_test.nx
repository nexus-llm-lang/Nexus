// `@e` on a container of thunks forces every thunk one level deep and yields
// the container of forced values: `[@T]` → `[T]`, `[| @T |]` → `[| T |]`,
// a record's `@T` fields → `T` (other fields pass through), and an enum's
// fields typed by a thunk type argument → the forced value.
import * as ta from "std:test/assert"
import * as list from "std:list"
import { Option, Some, None } from "std:option"

exception Boom

type Pair<A, B> = Pair(left: A, right: B)

let one = fn () -> i64 do return 1 end
let two = fn () -> i64 do return 2 end
let half = fn () -> float do return 0.5 end

let sum = fn (xs: [ i64 ]) -> i64 do
  return list.fold_left(xs, init: 0, f: fn (acc: i64, val: i64) -> i64 do return acc + val end)
end

let forced_list = fn () -> i64 do
  let @a = one()
  let @b = two()
  let @c = one() + two()
  let xs = @[ a, b, c ]
  return sum(xs) * 10 + list.length(xs)
end

let forced_list_var = fn () -> i64 do
  let @a = one()
  let @b = two()
  let ts = [ a, b ]
  let xs = @ts
  match xs do
    | x :: y :: [] -> return x * 10 + y
    | _ -> return 0
  end
end

let forced_array = fn () -> i64 do
  let @a = one()
  let @b = two()
  let arr = @[| a, b |]
  return arr[1]
end

let forced_record = fn () -> i64 do
  let @x = one()
  let @y = two()
  let r = @{ a: x, b: y, c: 7 }
  return r.a * 100 + r.b * 10 + r.c
end

let forced_punned = fn () -> i64 do
  let @a = one()
  let @b = two()
  let { a: va, b: vb } = @{ a, b }
  return va + vb
end

let forced_option = fn () -> i64 do
  let @a = two()
  match @Some(val: a) do
    | Some(val: v) -> return v
    | None -> return 0
  end
end

let forced_pair = fn () -> i64 do
  let @l = one()
  let Pair(left: x, right: y) = @Pair(left: l, right: 5)
  return x * 10 + y
end

let forced_float = fn () -> float do
  let @h = half()
  match @[ h ] do
    | f :: [] -> return f
    | _ -> return 0.0
  end
end

let throwing = fn () -> i64 throws { Exn } do
  let @a = one()
  let @b = throw Boom
  let xs = @[ a, b ]
  return sum(xs)
end

let caught = fn () -> i64 do
  try
    return throwing()
  catch _ ->
    return 0 - 1
  end
end

let body = fn () -> unit throws { Exn } do
  ta.assert_eq_i64(actual: forced_list(), expected: 63, label: "list literal")
  ta.assert_eq_i64(actual: forced_list_var(), expected: 12, label: "list variable")
  ta.assert_eq_i64(actual: forced_array(), expected: 2, label: "array")
  ta.assert_eq_i64(actual: forced_record(), expected: 127, label: "record with a plain field")
  ta.assert_eq_i64(actual: forced_punned(), expected: 3, label: "punned record")
  ta.assert_eq_i64(actual: forced_option(), expected: 2, label: "Option payload")
  ta.assert_eq_i64(actual: forced_pair(), expected: 15, label: "user enum payload")
  ta.assert_true(cond: forced_float() == 0.5, label: "float element")
  ta.assert_eq_i64(actual: caught(), expected: -1, label: "exception surfaces at the force")
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
