// Pins that importing std:lazy without calling any of its functions builds a
// module that instantiates and runs.
import * as lazy from "std:lazy"
import * as ta from "std:test/assert"

let main = fn () -> unit throws { Exn } do
  ta.assert_eq_i64(label: "g6qr_smoke", expected: 42, actual: 42)
  return ()
end
