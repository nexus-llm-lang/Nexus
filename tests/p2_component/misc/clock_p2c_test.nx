// Smoke-test: clock_time_get → wasi:clocks/monotonic-clock now in a component build.
// Calls now_ms which invokes clock_time_get; succeeds (returns >= 0) and prints a
// fixed message so the test harness can verify a clean run.
// p2c-http
import { Console, system_handler as console_handler } from "std:stdio"
import * as clock from "std:clock"
import * as net_mod from "std:network"
import { reach_net } from "tests/_fixtures/reach_net.nx"

let main = fn () -> unit require { PermConsole, PermNet } do
  inject net_mod.system_handler do
    reach_net()
  end
  let t = clock.now_ms()
  inject console_handler do
    Console.println(val: "clock ok")
  end
  return ()
end
