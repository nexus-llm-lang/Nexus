// Smoke-test: proc_exit → wasi:cli/exit in a component build.
// Calls proc_exit(0) which maps to wasi:cli/exit; a clean exit (code 0)
// means wasmtime reports success and the test harness records PASS.
// p2c-http
import { Console, system_handler } from "std:stdio"
import external "wasi_snapshot_preview1"
external w_proc_exit = "proc_exit" : (code: i32) -> unit
import * as cast from "std:runtime/cast"
import * as net_mod from "std:network"
import { reach_net } from "tests/_fixtures/reach_net.nx"

let main = fn () -> unit require { PermConsole, PermNet } do
  inject net_mod.system_handler do
    reach_net()
  end
  inject system_handler do
    Console.println(val: "proc_exit ok")
  end
  w_proc_exit(code: cast.i32_of(x: 0))
  return ()
end
