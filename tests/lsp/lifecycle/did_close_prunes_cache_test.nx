// on_did_close evicts the URI's diagnostics-cache entry.
//
// didOpen publishes through a spawned task and does not touch the cache, so
// the test fills the cache with didSave (which publishes synchronously).
//
// Pins:
//   1. After didOpen + didSave, the cache has an entry for the URI.
//   2. After didClose, the cache entry for the URI is gone.

import { dispatch_message } from "src/tools/lsp/handlers.nx"
import { StepContinue, StepExit } from "src/tools/lsp/handlers.nx"
import {
  ServerState, empty_state, with_lifecycle_running,
  state_cache, cache_lookup
} from "src/tools/lsp/state/server_state.nx"
import { Notification } from "std:jsonrpc"
import {
  JsonValue, JsonNull, JsonObject, JsonField, JsonString, JsonInt, JsonArray
} from "std:json"
import { Option, Some, None } from "std:option"
import * as test_assert from "std:test/assert"
import { Console } from "std:stdio"
import { Fs } from "std:fs"
import * as stdio from "std:stdio"
import * as fs_mod from "std:fs"
import { scheduler } from "std:concurrency/coop"

let running_state = fn () -> ServerState do
  return with_lifecycle_running(state: empty_state())
end

let make_did_open_params = fn (uri: string, text: string) -> JsonValue do
  return JsonObject(fields: [
    JsonField(key: "textDocument", value: JsonObject(fields: [
      JsonField(key: "uri",        value: JsonString(val: uri)),
      JsonField(key: "languageId", value: JsonString(val: "nexus")),
      JsonField(key: "version",    value: JsonInt(val: 1)),
      JsonField(key: "text",       value: JsonString(val: text))
    ]))
  ])
end

let make_uri_params = fn (uri: string) -> JsonValue do
  return JsonObject(fields: [
    JsonField(key: "textDocument", value: JsonObject(fields: [
      JsonField(key: "uri", value: JsonString(val: uri))
    ]))
  ])
end

let body = fn () -> unit require { Fs, Console, Coop } throws { Exn } do
  let uri = "buffer://did_close_prunes_cache_cache_prune_test.nx"
  let version = 1
  let source = "let x = fn () -> i64 do return 42 end\n"

  // Step 1: didOpen stores the buffer.
  let open_step = dispatch_message(
    state: running_state(),
    msg: Notification(
      method: "textDocument/didOpen",
      params: make_did_open_params(uri, text: source)
    )
  )
  let state_after_open_only = match open_step do
    | StepContinue(state, response: _, notifications: _) | StepExit(state) -> state
  end

  // didSave republishes synchronously and fills the diagnostics cache.
  let save_step = dispatch_message(
    state: state_after_open_only,
    msg: Notification(method: "textDocument/didSave", params: make_uri_params(uri))
  )
  let state_after_open = match save_step do
    | StepContinue(state, response: _, notifications: _) | StepExit(state) -> state
  end

  // Verify the cache has an entry for (uri, version=1).
  let cache_after_open = state_cache(state: state_after_open)
  match cache_lookup(cache: cache_after_open, uri, version) do
    | None ->
      throw RuntimeError(val: "cache should have entry for (uri,1) after didSave")
    | Some(val: _) ->
      // Correct: cache was populated.
      ()
  end

  // Step 2: didClose must evict the cache entry.
  let close_step = dispatch_message(
    state: state_after_open,
    msg: Notification(method: "textDocument/didClose", params: make_uri_params(uri))
  )
  let state_after_close = match close_step do
    | StepContinue(state, response: _, notifications: _) | StepExit(state) -> state
  end

  // (3) Cache entry for the URI is gone after close.
  let cache_after_close = state_cache(state: state_after_close)
  match cache_lookup(cache: cache_after_close, uri, version) do
    | Some(val: _) ->
      throw RuntimeError(val: "cache entry must be evicted after didClose")
    | None ->
      // Correct: cache eviction happened.
      test_assert.assert_eq_i64(actual: 1, expected: 1, label: "cache entry evicted after didClose")
  end

  return ()
end

let safe_run = fn () -> i64 require { Fs, Console, Coop } do
  try
    body()
    return 1
  catch _ ->
    return 0
  end
end

let main = fn () -> unit require { PermFs, PermConsole } do
  inject stdio.system_handler, fs_mod.system_handler, scheduler do
    let ok = safe_run()
    1 / ok
    return ()
  end
end
