// unit-test
// `src/backend/wasm/defs.nx::type_to_valtype` on `TyAny`: a value in the
// generic value channel travels in the wasm i64 valtype.
import * as test_assert from "std:test/assert"
import { TyAny, TyLinear } from "src/types/type_expr.nx"
import { type_to_valtype, vt_i64 } from "src/backend/wasm/defs.nx"

let body = fn () -> unit throws { Exn } do
  test_assert.assert_eq_i64(actual: type_to_valtype(typ: TyAny), expected: vt_i64, label: "TyAny")
  test_assert.assert_eq_i64(
    actual: type_to_valtype(typ: TyLinear(inner: TyAny)),
    expected: vt_i64,
    label: "linear TyAny"
  )
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
