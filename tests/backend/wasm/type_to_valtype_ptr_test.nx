// unit-test
// `src/backend/wasm/defs.nx::type_to_valtype` on `TyPtr`: a heap object
// pointer travels in the wasm i64 valtype, also under a linear wrapper.
import * as test_assert from "std:test/assert"
import { TyPtr, TyLinear } from "src/types/type_expr.nx"
import { type_to_valtype, vt_i64 } from "src/backend/wasm/defs.nx"

let body = fn () -> unit throws { Exn } do
  test_assert.assert_eq_i64(actual: type_to_valtype(typ: TyPtr), expected: vt_i64, label: "TyPtr")
  test_assert.assert_eq_i64(
    actual: type_to_valtype(typ: TyLinear(inner: TyPtr)),
    expected: vt_i64,
    label: "linear TyPtr"
  )
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
