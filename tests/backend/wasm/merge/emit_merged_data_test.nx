// merge.section_emit.emit_merged_data: the merged data section (id 11) holds
// the dep's segments verbatim, then the main module's segments with each
// active segment's `i32.const` offset moved by `reloc` (flag 0, or flag 2 with
// an explicit memory index). A passive segment (flag 1, no offset expression)
// is copied unchanged.
import * as test_assert from "std:test/assert"
import * as bb from "std:bytebuffer"
import { ByteBuffer } from "std:bytebuffer"
import { emit_merged_data, find_data_end } from "src/backend/wasm/merge/section_emit.nx"
import { pack } from "src/backend/wasm/read.nx"

let bytes_of = fn (buf: &ByteBuffer) -> [ i64 ] do
  return bytes_go(buf, idx: bb.length(buf) - 1, acc: [])
end
let bytes_go = fn (buf: &ByteBuffer, idx: i64, acc: [ i64 ]) -> [ i64 ] do
  if idx < 0 then return acc end
  return bytes_go(buf, idx: idx - 1, acc: bb.get_byte(buf, idx) :: acc)
end
let buf_of = fn (xs: [ i64 ]) -> %ByteBuffer do
  return bb.push_bytes(buf: bb.empty(), bytes: xs)
end
let len_of = fn (xs: [ i64 ]) -> i64 do
  match xs do
    | [] -> return 0
    | _ :: rest -> return 1 + len_of(xs: rest)
  end
end

/** Merge section bodies `d` and `m` (each starting with its segment count at
 *  offset 0) and return the emitted section bytes. */
let merged = fn (d: [ i64 ], m: [ i64 ], reloc: i64) -> [ i64 ] do
  let %db = buf_of(xs: d)
  let %mb = buf_of(xs: m)
  let d_sec = if len_of(xs: d) == 0 then 0 else pack(val: 0, p: len_of(xs: d)) end
  let m_sec = if len_of(xs: m) == 0 then 0 else pack(val: 0, p: len_of(xs: m)) end
  let %out = emit_merged_data(out: bb.empty(), m_buf: &mb, m_sec, d_buf: &db, d_sec, reloc)
  let r = bytes_of(buf: &out)
  bb.free(buf: %out)
  bb.free(buf: %db)
  bb.free(buf: %mb)
  return r
end

let body = fn () -> unit throws { Exn } do
  // dep: one active segment at offset 8 holding [1, 2]
  // main: one active segment at offset 0 holding [9]; reloc 16
  test_assert.assert_eq_i64_list(
    actual: merged(d: [ 1, 0, 65, 8, 11, 2, 1, 2 ], m: [ 1, 0, 65, 0, 11, 1, 9 ], reloc: 16),
    expected: [ 11, 14, 2, 0, 65, 8, 11, 2, 1, 2, 0, 65, 16, 11, 1, 9 ],
    label: "active segments: dep verbatim, main offset 0 -> 16"
  )
  // main: one passive segment holding [5, 6] is copied unchanged
  test_assert.assert_eq_i64_list(
    actual: merged(d: [], m: [ 1, 1, 2, 5, 6 ], reloc: 16),
    expected: [ 11, 5, 1, 1, 2, 5, 6 ],
    label: "passive segment copied unchanged"
  )
  // main: an active then a passive segment
  test_assert.assert_eq_i64_list(
    actual: merged(d: [], m: [ 2, 0, 65, 4, 11, 1, 7, 1, 1, 8 ], reloc: 100),
    expected: [ 11, 11, 2, 0, 65, 232, 0, 11, 1, 7, 1, 1, 8 ],
    label: "active (offset 4 -> 104, two-byte sleb) then passive"
  )
  // main: an active segment with an explicit memory index (flag 2, memidx 0)
  test_assert.assert_eq_i64_list(
    actual: merged(d: [], m: [ 1, 2, 0, 65, 3, 11, 1, 7 ], reloc: 10),
    expected: [ 11, 8, 1, 2, 0, 65, 13, 11, 1, 7 ],
    label: "active segment with explicit memidx relocated"
  )
  // find_data_end: the end of the last active segment; passive segments have
  // no address and are skipped
  let %fb = buf_of(xs: [ 3, 0, 65, 8, 11, 2, 1, 2, 1, 3, 9, 9, 9, 2, 0, 65, 20, 11, 1, 4 ])
  let data_end = find_data_end(buf: &fb, sec_pk: pack(val: 0, p: 20))
  bb.free(buf: %fb)
  test_assert.assert_eq_i64(actual: data_end, expected: 21, label: "find_data_end skips passive")
  // neither module has a data section: nothing is emitted
  test_assert.assert_eq_i64_list(actual: merged(d: [], m: [], reloc: 16), expected: [], label: "no data sections")
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
