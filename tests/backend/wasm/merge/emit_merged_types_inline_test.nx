// merge.section_emit.emit_merged_types_inline: the merged type section (id 1)
// holds the main module's entries verbatim, then the dep's entries with every
// type index they mention (cont type targets, `ref <idx>` valtypes) shifted by
// the main module's type count.
import * as test_assert from "std:test/assert"
import * as bb from "std:bytebuffer"
import { ByteBuffer } from "std:bytebuffer"
import { emit_merged_types_inline } from "src/backend/wasm/merge/section_emit.nx"
import { pack } from "src/backend/wasm/read.nx"

let bytes_of = fn (buf: &ByteBuffer) -> [ i64 ] do
  return bytes_go(buf, idx: bb.length(buf) - 1, acc: [])
end
let bytes_go = fn (buf: &ByteBuffer, idx: i64, acc: [ i64 ]) -> [ i64 ] do
  if idx < 0 then return acc end
  return bytes_go(buf, idx: idx - 1, acc: bb.get_byte(buf, idx) :: acc)
end
let len_of = fn (xs: [ i64 ]) -> i64 do
  match xs do
    | [] -> return 0
    | _ :: rest -> return 1 + len_of(xs: rest)
  end
end

/** Merge type-section bodies `d` and `m` (each starting with its entry count
 *  at offset 0; `[]` means the section is absent) and return the emitted bytes. */
let merged = fn (d: [ i64 ], m: [ i64 ]) -> [ i64 ] do
  let %db = bb.push_bytes(buf: bb.empty(), bytes: d)
  let %mb = bb.push_bytes(buf: bb.empty(), bytes: m)
  let d_sec = if len_of(xs: d) == 0 then 0 else pack(val: 0, p: len_of(xs: d)) end
  let m_sec = if len_of(xs: m) == 0 then 0 else pack(val: 0, p: len_of(xs: m)) end
  let %out = emit_merged_types_inline(d_buf: &db, d_sec, m_buf: &mb, m_sec, out: bb.empty())
  let r = bytes_of(buf: &out)
  bb.free(buf: %out)
  bb.free(buf: %db)
  bb.free(buf: %mb)
  return r
end

let body = fn () -> unit throws { Exn } do
  // main: [() -> ()]; dep: [(i64) -> i64, (ref 0) -> (), cont 0]
  test_assert.assert_eq_i64_list(
    actual: merged(d: [ 3, 96, 1, 126, 1, 126, 96, 1, 100, 0, 0, 93, 0 ], m: [ 1, 96, 0, 0 ]),
    expected: [ 1, 16, 4, 96, 0, 0, 96, 1, 126, 1, 126, 96, 1, 100, 1, 0, 93, 1 ],
    label: "dep entries appended with type indices shifted by main count"
  )
  test_assert.assert_eq_i64_list(
    actual: merged(d: [], m: [ 1, 96, 0, 0 ]),
    expected: [ 1, 4, 1, 96, 0, 0 ],
    label: "no dep type section: main entries only"
  )
  test_assert.assert_eq_i64_list(
    actual: merged(d: [ 1, 96, 0, 1, 127 ], m: []),
    expected: [ 1, 5, 1, 96, 0, 1, 127 ],
    label: "no main type section: dep entries unshifted"
  )
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
