// merge.section_emit section helpers: count_sec / sec_body / sec_sz read a
// packed section locator, copy_raw_sec re-emits a section unchanged, and
// emit_preserved_customs passes a non-"name" custom section through verbatim.
import * as test_assert from "std:test/assert"
import * as bb from "std:bytebuffer"
import * as sm from "std:stringmap"
import { ByteBuffer } from "std:bytebuffer"
import {
  copy_raw_sec,
  count_sec,
  emit_preserved_customs,
  scan_custom_secs,
  sec_body,
  sec_sz
} from "src/backend/wasm/merge/section_emit.nx"
import { pack } from "src/backend/wasm/read.nx"

let bytes_of = fn (buf: &ByteBuffer) -> [ i64 ] do
  return bytes_go(buf, idx: bb.length(buf) - 1, acc: [])
end
let bytes_go = fn (buf: &ByteBuffer, idx: i64, acc: [ i64 ]) -> [ i64 ] do
  if idx < 0 then return acc end
  return bytes_go(buf, idx: idx - 1, acc: bb.get_byte(buf, idx) :: acc)
end

let body = fn () -> unit throws { Exn } do
  // section content at offset 2, size 4: count 2 then two body bytes
  let %b = bb.push_bytes(buf: bb.empty(), bytes: [ 9, 9, 2, 7, 8, 9 ])
  let pk = pack(val: 2, p: 4)
  let n = count_sec(buf: &b, sec_pk: pk)
  let start = sec_body(buf: &b, sec_pk: pk)
  let absent_n = count_sec(buf: &b, sec_pk: 0)
  let absent_start = sec_body(buf: &b, sec_pk: 0)
  let %raw = copy_raw_sec(out: bb.empty(), src: &b, sec_pk: pk, sec_id: 5)
  let raw_bytes = bytes_of(buf: &raw)
  let %none = copy_raw_sec(out: bb.empty(), src: &b, sec_pk: 0, sec_id: 5)
  let none_len = bb.length(buf: &none)
  bb.free(buf: %raw)
  bb.free(buf: %none)
  bb.free(buf: %b)
  test_assert.assert_eq_i64(actual: n, expected: 2, label: "count_sec")
  test_assert.assert_eq_i64(actual: start, expected: 3, label: "sec_body")
  test_assert.assert_eq_i64(actual: sec_sz(pk), expected: 4, label: "sec_sz")
  test_assert.assert_eq_i64(actual: absent_n, expected: 0, label: "count_sec absent")
  test_assert.assert_eq_i64(actual: absent_start, expected: 0, label: "sec_body absent")
  test_assert.assert_eq_i64_list(actual: raw_bytes, expected: [ 5, 4, 2, 7, 8, 9 ], label: "copy_raw_sec")
  test_assert.assert_eq_i64(actual: none_len, expected: 0, label: "copy_raw_sec absent")

  // wasm header + custom "foo" with payload [42, 7]
  let %w = bb.push_bytes(buf: bb.empty(), bytes: [ 0, 97, 115, 109, 1, 0, 0, 0, 0, 6, 3, 102, 111, 111, 42, 7 ])
  let %customs = scan_custom_secs(buf: &w)
  let %remap = bb.empty()
  let %out = emit_preserved_customs(
    out: bb.empty(),
    buf: &w,
    customs: &customs,
    remap: &remap,
    remap_size: 0,
    type_off: 3,
    tbl_off: 3,
    glo_off: 3
  )
  let customs_out = bytes_of(buf: &out)
  bb.free(buf: %out)
  bb.free(buf: %remap)
  sm.free(map: %customs)
  bb.free(buf: %w)
  test_assert.assert_eq_i64_list(
    actual: customs_out,
    expected: [ 0, 6, 3, 102, 111, 111, 42, 7 ],
    label: "non-name custom passes through"
  )
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
