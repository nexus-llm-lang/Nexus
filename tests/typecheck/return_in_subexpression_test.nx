// A `return` nested inside a subexpression (the right-hand side of a
// destructuring `let`, a call argument, a binary operand) returns from the
// enclosing function and is checked against its return type.
import * as test_assert from "std:test/assert"

type P = P(a: i64, b: i64)

let id = fn (x: i64) -> i64 do return x end

let via_let_pattern = fn (x: i64) -> i64 do
  let P(a, b) = match x do
    | 0 -> return 99
    | _ -> P(a: x, b: x)
  end
  return a + b
end

let via_call_arg = fn (x: i64) -> i64 do
  return id(x: match x do
    | 0 -> return 7
    | _ -> x
  end) + 1
end

let via_operand = fn (x: i64) -> i64 do
  return (if x == 0 then return 5 else x end) * 2
end

let body = fn () -> unit throws { Exn } do
  test_assert.assert_eq_i64(
    actual: via_let_pattern(x: 0),
    expected: 99,
    label: "let-pattern rhs return"
  )
  test_assert.assert_eq_i64(
    actual: via_let_pattern(x: 3),
    expected: 6,
    label: "let-pattern rhs value"
  )
  test_assert.assert_eq_i64(actual: via_call_arg(x: 0), expected: 7, label: "call-arg return")
  test_assert.assert_eq_i64(actual: via_call_arg(x: 4), expected: 5, label: "call-arg value")
  test_assert.assert_eq_i64(actual: via_operand(x: 0), expected: 5, label: "operand return")
  test_assert.assert_eq_i64(actual: via_operand(x: 3), expected: 6, label: "operand value")
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
