// A block whose last statement is `let x = throw e` or a destructuring
// `let p = throw e` has tail ⊥, so a match arm ending that way unifies with
// any other arm type. The destructuring form skips exhaustiveness on the
// throw's fresh type.
import * as ta from "std:test/assert"

exception NotFound(path: string)

let single = fn (xs: [ i64 ]) -> i64 throws { Exn } do
  let r = match xs do
    | [] -> let y = throw NotFound(path: "single")
    | x :: _ -> x
  end
  return r
end

let destructure = fn (xs: [ i64 ]) -> i64 throws { Exn } do
  let r = match xs do
    | [] -> let { a: y } = throw NotFound(path: "record")
    | x :: _ -> x + 1
  end
  return r
end

let refutable = fn (xs: [ i64 ]) -> i64 throws { Exn } do
  let r = match xs do
    | [] -> let Some(val: y) = throw NotFound(path: "ctor")
    | x :: _ -> x + 2
  end
  return r
end

let caught = fn (f: () -> i64 throws { Exn }) -> i64 do
  try
    return f()
  catch _ ->
    return 0 - 1
  end
end

let body = fn () -> unit throws { Exn } do
  ta.assert_eq_i64(actual: single(xs: [ 4 ]), expected: 4, label: "single binder, live arm")
  ta.assert_eq_i64(actual: destructure(xs: [ 4 ]), expected: 5, label: "record pattern, live arm")
  ta.assert_eq_i64(actual: refutable(xs: [ 4 ]), expected: 6, label: "ctor pattern, live arm")
  ta.assert_eq_i64(
    actual: caught(f: fn () -> i64 throws { Exn } do return single(xs: []) end),
    expected: -1,
    label: "single binder throws"
  )
  ta.assert_eq_i64(
    actual: caught(f: fn () -> i64 throws { Exn } do return destructure(xs: []) end),
    expected: -1,
    label: "record pattern throws"
  )
  ta.assert_eq_i64(
    actual: caught(f: fn () -> i64 throws { Exn } do return refutable(xs: []) end),
    expected: -1,
    label: "ctor pattern throws"
  )
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
