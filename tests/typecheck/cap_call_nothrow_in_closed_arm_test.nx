// A handler arm whose cap method declares no throws runs under a closed
// throws row. It may call an unannotated helper whose body only calls another
// cap's method that declares no throws: that method cannot raise, so the
// helper cannot either.
cap Ping do
  fn ping() -> unit
end

cap Work do
  fn run() -> unit
end

let pinger = handler Ping do
  fn ping() -> unit do
    return ()
  end
end

let helper = fn () -> unit require { Ping } do
  Ping.ping()
  return ()
end

let worker = handler Work require { Ping } do
  fn run() -> unit do
    return helper()
  end
end

let main = fn () -> unit do
  inject pinger do
    inject worker do
      Work.run()
    end
  end
  return ()
end
