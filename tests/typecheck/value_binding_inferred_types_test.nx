/**
 * Top-level value bindings without an annotation take the type of their
 * initializer, whatever its shape: scalar call results, closures, structured
 * values. A reference denotes the value itself, so it can be matched,
 * destructured, field-accessed and compared like any local of that type.
 */
import * as test_assert from "std:test/assert"
import * as math from "std:math"
import * as str from "std:str"

let is_pos = fn (n: i64) -> bool do return n > 0 end
let make_adder = fn (n: i64) -> (x: i64) -> i64 do
  return fn (x: i64) -> i64 do return x + n end
end

let root2 = math.sqrt(val: 4.0)
let flag = is_pos(n: 3)
let add1 = make_adder(n: 1)
let greeting = "ab" ++ "cd"
let opt = Some(val: 7)
let none_str: Option<string> = None
let point = { x: 3, y: 4 }
let word = "abc"
let empty = []
let doubled = root2 *. 2.0

let main = fn () -> unit throws { Exn } do
  test_assert.assert(cond: doubled ==. 4.0, label: "f64 call result")
  test_assert.assert(cond: flag, label: "bool call result")
  test_assert.assert_eq_i64(actual: add1(x: 41), expected: 42, label: "closure result")
  test_assert.assert_eq_string(actual: greeting ++ "!", expected: "abcd!", label: "string concat")
  match opt do
    | Some(val) -> test_assert.assert_eq_i64(actual: val, expected: 7, label: "match Some")
    | None -> test_assert.assert(cond: false, label: "match Some arm")
  end
  match none_str do
    | Some(val) -> test_assert.assert_eq_string(actual: val, expected: "", label: "match None arm")
    | None -> ()
  end
  let { x, y } = point
  test_assert.assert_eq_i64(actual: x * 10 + y, expected: 34, label: "record destructure")
  test_assert.assert_eq_i64(actual: point.x + point.y, expected: 7, label: "record field")
  match word do
    | "abc" -> ()
    | _ -> test_assert.assert(cond: false, label: "string literal match")
  end
  test_assert.assert_eq_i64(actual: str.length(s: word), expected: 3, label: "string arg")
  let ints = 1 :: empty
  let strs = "s" :: empty
  test_assert.assert_eq_i64(
    actual: list_len_i(xs: ints) + list_len_s(xs: strs),
    expected: 2,
    label: "polymorphic empty list"
  )
  return ()
end

let list_len_i = fn (xs: [ i64 ]) -> i64 do
  match xs do
    | [] -> return 0
    | _ :: rest -> return 1 + list_len_i(xs: rest)
  end
end

let list_len_s = fn (xs: [ string ]) -> i64 do
  match xs do
    | [] -> return 0
    | _ :: rest -> return 1 + list_len_s(xs: rest)
  end
end
