// T-TryCatch: a catch arm that diverges may consume more outer linears than
// the try path, as long as it consumes at least what the try path consumes.
// Here the try path consumes `x` and leaves `y` for after the try; the catch
// arm consumes both and rethrows.
import * as test_assert from "std:test/assert"

exception Boom(code: i64)

type Tok = Tok(n: i64)

let eat = fn (%t: Tok) -> i64 do
  let Tok(n) = %t
  return n
end

let risky = fn (fail: bool) -> unit throws { Boom } do
  if fail then throw Boom(code: 1) end
  return ()
end

let f = fn (fail: bool) -> i64 throws { Boom } do
  let %x = Tok(n: 1)
  let %y = Tok(n: 2)
  let ~sum = 0
  try
    risky(fail)
    ~sum <- ~sum + eat(t: %x)
  catch e ->
    let a = eat(t: %x)
    let b = eat(t: %y)
    throw e
  end
  return ~sum + eat(t: %y)
end

let probe = fn (fail: bool) -> i64 do
  try
    return f(fail)
  catch _ -> return -1
  end
end

let body = fn () -> unit throws { Exn } do
  test_assert.assert_eq_i64(
    actual: probe(fail: false),
    expected: 3,
    label: "try path consumes x, then y"
  )
  test_assert.assert_eq_i64(
    actual: probe(fail: true),
    expected: -1,
    label: "catch consumes x and y, rethrows"
  )
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
