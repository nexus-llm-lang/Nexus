// Matching a borrowed list of linear buffers binds each element as a borrow,
// which can be passed where a borrow is expected; plain components stay values.
import * as ta from "std:test/assert"
import { ByteBuffer }, * as bb from "std:bytebuffer"

let head_len = fn (xs: &[ %ByteBuffer ]) -> i64 do
  match xs do
    | h :: _ -> return bb.length(buf: h)
    | [] -> return 0 - 1
  end
end

let first_int = fn (xs: &[ i64 ]) -> i64 do
  match xs do
    | h :: _ -> return h + 1
    | [] -> return 0
  end
end

let free_all = fn (xs: [ %ByteBuffer ]) -> unit do
  match xs do
    | [] -> return ()
    | h :: t ->
      bb.free(buf: h)
      return free_all(xs: t)
  end
end

let body = fn () -> unit throws { Exn } do
  let xs = [ bb.push_bytes(buf: bb.empty(), bytes: [ 1, 2 ]) ]
  let n = head_len(xs: &xs)
  free_all(xs)
  let ys = [ 41 ]
  ta.assert_eq_i64(actual: n, expected: 2, label: "borrowed linear element")
  ta.assert_eq_i64(actual: first_int(xs: &ys), expected: 42, label: "plain element stays a value")
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
