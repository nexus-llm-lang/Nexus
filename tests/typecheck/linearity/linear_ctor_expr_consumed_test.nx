// A linear constructor value is consumed by destructuring it; its fields are
// then linear, and a scalar field may be discarded.
import * as ta from "std:test/assert"
import * as list from "std:list"

type Box = Box(val: i64)
type Wrap = Wrap(items: [ i64 ], tag: i64)

let body = fn () -> unit throws { Exn } do
  let x = %Box(val: 7)
  let Box(val: v) = x
  let w = %Wrap(items: [ 1, 2 ], tag: 3)
  let Wrap(items, tag: _) = w
  ta.assert_eq_i64(
    actual: v + list.length(xs: items),
    expected: 9,
    label: "destructured linear ctor"
  )
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
