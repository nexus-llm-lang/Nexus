// A single consume of a linear binding is accepted (no LinearReuse false
// positive).
import * as test_assert from "std:test/assert"

type Box = Box(val: i64)

let consume_box = fn (%b: Box) -> i64 do
  let Box(val: v) = b
  return v
end

let body = fn () -> unit throws { Exn } do
  let %b = Box(val: 42)
  let v = consume_box(%b)
  test_assert.assert_eq_i64(actual: v, expected: 42, label: "single consume passes")
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
