// Destructuring a record literal that holds a linear closure: the closure
// field is bound linearly and called once; the scalar field is unrestricted.
import * as test_assert from "std:test/assert"

type Tok = Tok(n: i64)

let eat = fn (%t: Tok) -> i64 do
  let Tok(n) = %t
  return n
end

let run = fn () -> i64 do
  let %t = Tok(n: 4)
  let f = fn () -> i64 do return eat(t: %t) end
  let pair = { a: f, b: 10 }
  let { a, b } = pair
  return a() + b + b
end

let body = fn () -> unit throws { Exn } do
  test_assert.assert_eq_i64(actual: run(), expected: 24, label: "linear closure field called once")
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
