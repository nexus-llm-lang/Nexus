// A wildcard arm after the arm that consumes the only linear variant discards
// just scalar payloads, so it is accepted.
import * as ta from "std:test/assert"
import { ByteBuffer }, * as bb from "std:bytebuffer"

type Value = Num(n: i64) | Buf(b: %ByteBuffer) | Flag(f: bool)

let size = fn (v: Value) -> i64 do
  match v do
    | Buf(b) ->
      let n = bb.length(buf: &b)
      bb.free(buf: b)
      return n
    | _ -> return 0
  end
end

let body = fn () -> unit throws { Exn } do
  ta.assert_eq_i64(actual: size(v: Num(n: 3)), expected: 0, label: "scalar variant dropped")
  ta.assert_eq_i64(
    actual: size(v: Buf(b: bb.push_bytes(buf: bb.empty(), bytes: [ 1, 2 ]))),
    expected: 2,
    label: "linear variant consumed"
  )
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
