// A `return` inside a thunk body supplies the thunk's value when forced.
import * as test_assert from "std:test/assert"

let f = fn (c: bool) -> i64 do
  let @t = if c then return 5 else 1 end
  return @t + 100
end

let body = fn () -> unit throws { Exn } do
  test_assert.assert_eq_i64(
    actual: f(c: true),
    expected: 105,
    label: "return in thunk yields thunk value"
  )
  test_assert.assert_eq_i64(
    actual: f(c: false),
    expected: 101,
    label: "thunk falls through to else"
  )
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
