// A function may call a method of a cap that no top-level handler in the
// program implements yet (a library declaring a cap for its users); the call
// is typed from the cap declaration.
import * as test_assert from "std:test/assert"

cap Counter do
  fn next(step: i64) -> i64
end

let twice = fn () -> i64 require { Counter } do
  return Counter.next(step: 1) + Counter.next(step: 2)
end

let main = fn () -> unit throws { Exn } do
  test_assert.assert(cond: true, label: "cap method typed from its declaration")
  return ()
end
