/**
 * `==` / `!=` on enum values compare structurally: same constructor and equal
 * payload fields.
 */
import * as test_assert from "std:test/assert"

type Shape = Circle(radius: i64) | Square(side: i64)
type Color = Red | Green | Blue

let main = fn () -> unit throws { Exn } do
  test_assert.assert(cond: Circle(radius: 3) == Circle(radius: 3), label: "same ctor, same payload")
  test_assert.assert(
    cond: Circle(radius: 3) != Circle(radius: 4),
    label: "same ctor, different payload"
  )
  test_assert.assert(cond: Circle(radius: 3) != Square(side: 3), label: "different ctor")
  let a: Color = Red
  let b: Color = Green
  test_assert.assert(cond: a != b, label: "different nullary ctors")
  test_assert.assert(cond: a == Red, label: "same nullary ctor")
  return ()
end
