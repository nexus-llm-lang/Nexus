// A `return` inside a thunk body returns from the thunk when it is forced, so
// it is checked against the thunk's value type, not the enclosing function's
// return type. Both thunks below have value type i64.
import * as test_assert from "std:test/assert"

let thunk_early_guard = fn (flag: bool) -> i64 do
  let @t = if flag then return 99 else 7 end
  return @t
end

let force_outer_ret = fn (flag: bool) -> string do
  let @t = if flag then return 42 else 1 end
  if @t == 42 then return "early" end
  return "late"
end

let force_basic = fn (n: i64) -> i64 do
  let @t = n + 1
  return @t
end

let body = fn () -> unit throws { Exn } do
  test_assert.assert_eq_i64(actual: force_basic(n: 3), expected: 4, label: "force basic n+1")
  test_assert.assert_eq_i64(
    actual: thunk_early_guard(flag: true),
    expected: 99,
    label: "thunk return flag=true"
  )
  test_assert.assert_eq_i64(
    actual: thunk_early_guard(flag: false),
    expected: 7,
    label: "thunk value flag=false"
  )
  test_assert.assert(
    cond: force_outer_ret(flag: true) == "early",
    label: "thunk return under a string function"
  )
  test_assert.assert(
    cond: force_outer_ret(flag: false) == "late",
    label: "thunk value under a string function"
  )
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
