// A lambda body is typed under the lambda's own require row (T-Lambda). `h`
// declares `require { Log }`, so its `Log.log` call type-checks even though
// `run` itself has no Log in scope; the call `h()` is made inside an inject
// that supplies Log.
import * as test_assert from "std:test/assert"

cap Log do fn log(msg: string) -> unit end

let collect = handler Log do
  fn log(msg: string) -> unit do
    return ()
  end
end

let run = fn () -> i64 do
  let h = fn () -> i64 require { Log } do
    Log.log(msg: "x")
    return 7
  end
  let r = inject collect do h() end
  return r
end

let body = fn () -> unit throws { Exn } do
  test_assert.assert_eq_i64(
    actual: run(),
    expected: 7,
    label: "lambda with declared require row runs under inject"
  )
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
