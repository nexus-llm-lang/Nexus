// `test_assert.assert_raises` accepts a body that uses capabilities: the
// body's require row flows into the call's require row.
import * as test_assert from "std:test/assert"

cap Log do fn log(msg: string) -> unit end

exception Boom(code: i64)

let quiet = handler Log do
  fn log(msg: string) -> unit do
    return ()
  end
end

let body = fn () -> unit require { Log } throws { Exn } do
  test_assert.assert_raises(
    label: "cap-using body that throws",
    body: fn () -> bool require { Log } throws { Exn } do
      Log.log(msg: "about to throw")
      throw Boom(code: 1)
    end
  )
  test_assert.assert_raises(
    label: "cap-free body still accepted",
    body: fn () -> bool throws { Exn } do
      throw Boom(code: 2)
    end
  )
  return ()
end

let main = fn () -> unit throws { Exn } do
  inject quiet do body() end
  return ()
end
