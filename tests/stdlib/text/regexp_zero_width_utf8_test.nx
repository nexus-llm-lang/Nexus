/**
 * Zero-width matches advance by one UTF-8 scalar, never into the middle of a
 * multi-byte character, so gsub / gsub_with / split keep the output valid
 * UTF-8, and find_all reports each empty match once at a character
 * boundary. split skips an empty match at the start of the current segment, so
 * an anchor-only pattern does not split the first character off.
 */
import * as test_assert from "std:test/assert"
import * as re from "std:regexp"
import * as str from "std:str"
import * as list from "std:list"

let main = fn () -> unit throws { Exn } do
  let star = re.from_string(src: "x*")
  test_assert.assert_eq_string(
    actual: re.gsub(re: star, s: "é", repl: "-"),
    expected: "-é-",
    label: "gsub zero-width around a 2-byte char"
  )
  test_assert.assert_eq_string(
    actual: re.gsub_with(re: star, s: "日本", f: fn (m: re.Match) -> string do return "|" end),
    expected: "|日|本|",
    label: "gsub_with zero-width around 3-byte chars"
  )
  test_assert.assert_eq_string(
    actual: str.join(xs: re.split(re: star, s: "日本"), sep: ","),
    expected: "日,本",
    label: "split zero-width on 3-byte chars"
  )
  test_assert.assert_eq_string(
    actual: str.join(xs: re.split(re: star, s: "abc"), sep: ","),
    expected: "a,b,c",
    label: "split zero-width on ascii"
  )
  let caret = re.from_string(src: "^")
  test_assert.assert_eq_string(
    actual: str.join(xs: re.split(re: caret, s: "abc"), sep: ","),
    expected: "abc",
    label: "split on ^ keeps the input whole"
  )
  let a_star = re.from_string(src: "a*")
  test_assert.assert_eq_string(
    actual: str.join(xs: re.split(re: a_star, s: "baaac"), sep: ","),
    expected: "b,c",
    label: "split a* skips the empty matches next to a non-empty one"
  )
  let dollar = re.from_string(src: "$")
  test_assert.assert_eq_i64(
    actual: list.length(xs: re.find_all(re: dollar, s: "abc")),
    expected: 1,
    label: "find_all on $ reports the end-of-input match once"
  )
  let starts = list.map(xs: re.find_all(re: star, s: "é"), f: fn (val: re.Match) -> i64 do
    let re.Match(start, end_pos: _, text: _, groups: _) = val
    return start
  end)
  test_assert.assert_eq_i64_list(
    actual: starts,
    expected: [ 0, 2 ],
    label: "find_all x* on a 2-byte char"
  )
  return ()
end
