/**
 * substring / byte_substring return the part of [start, start + len) that
 * lies inside the string: a negative start shortens the result instead of
 * being moved to 0 with the full length.
 */
import * as test_assert from "std:test/assert"
import * as str from "std:str"

let main = fn () -> unit throws { Exn } do
  test_assert.assert_eq_string(
    actual: str.substring(s: "abc", start: 0 - 1, len: 2),
    expected: "a",
    label: "substring -1,2"
  )
  test_assert.assert_eq_string(
    actual: str.substring(s: "abc", start: 0 - 5, len: 2),
    expected: "",
    label: "substring entirely before"
  )
  test_assert.assert_eq_string(
    actual: str.substring(s: "héllo", start: 0 - 1, len: 3),
    expected: "hé",
    label: "substring utf8"
  )
  test_assert.assert_eq_string(
    actual: str.substring(s: "abc", start: 1, len: 10),
    expected: "bc",
    label: "substring past end"
  )
  test_assert.assert_eq_string(
    actual: str.byte_substring(s: "abc", start: 0 - 2, len: 3),
    expected: "a",
    label: "byte_substring -2,3"
  )
  test_assert.assert_eq_string(
    actual: str.byte_substring(s: "abc", start: 1, len: 1),
    expected: "b",
    label: "byte_substring in range"
  )
  return ()
end
