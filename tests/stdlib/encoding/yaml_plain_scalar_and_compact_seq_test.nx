/**
 * Block-context plain scalars may contain flow indicators (`a,b`, `a]b`);
 * a compact nested sequence (`- - 2`) nests; and serialize quotes strings
 * that would otherwise re-parse as something else.
 */
import * as test_assert from "std:test/assert"
import * as yaml from "std:yaml"
import { YamlValue, YamlString, YamlMap, YamlField, YamlSeq, YamlInt } from "std:yaml"

let roundtrip_string = fn (s: string) -> bool throws { Exn } do
  let out = yaml.serialize(v: YamlMap(fields: [ YamlField(key: YamlString(val: "k"), value: YamlString(val: s)) ]))
  match yaml.parse(s: out) do
    | YamlMap(fields: [ YamlField(key: _, value: YamlString(val: back)) ]) -> return back == s
    | _ -> return false
  end
end

let main = fn () -> unit throws { Exn } do
  test_assert.assert_eq_string(actual: yaml.serialize(v: yaml.parse(s: "k: a,b")), expected: "k: \"a,b\"\n", label: "plain scalar with comma")
  test_assert.assert(cond: yaml.parse(s: "k: a]b") == YamlMap(fields: [ YamlField(key: YamlString(val: "k"), value: YamlString(val: "a]b")) ]), label: "plain scalar with ]")
  test_assert.assert(cond: yaml.parse(s: "k: a, b}") == YamlMap(fields: [ YamlField(key: YamlString(val: "k"), value: YamlString(val: "a, b}")) ]), label: "plain scalar with , and }")
  test_assert.assert(
    cond: yaml.parse(s: "- - 2\n  - 3\n- 4") == YamlSeq(items: [ YamlSeq(items: [ YamlInt(val: 2), YamlInt(val: 3) ]), YamlInt(val: 4) ]),
    label: "compact nested sequence"
  )
  test_assert.assert(
    cond: yaml.parse(s: "- - - x") == YamlSeq(items: [ YamlSeq(items: [ YamlSeq(items: [ YamlString(val: "x") ]) ]) ]),
    label: "doubly nested compact sequence"
  )
  test_assert.assert(cond: roundtrip_string(s: "[x"), label: "roundtrip [x")
  test_assert.assert(cond: roundtrip_string(s: "{y"), label: "roundtrip {y")
  test_assert.assert(cond: roundtrip_string(s: "'q"), label: "roundtrip 'q")
  test_assert.assert(cond: roundtrip_string(s: "\"dq"), label: "roundtrip \"dq")
  test_assert.assert(cond: roundtrip_string(s: "|"), label: "roundtrip |")
  test_assert.assert(cond: roundtrip_string(s: ">"), label: "roundtrip >")
  test_assert.assert(cond: roundtrip_string(s: "a,b"), label: "roundtrip a,b")
  test_assert.assert(cond: roundtrip_string(s: "- x"), label: "roundtrip - x")
  test_assert.assert(cond: roundtrip_string(s: "*alias"), label: "roundtrip *alias")
  test_assert.assert(cond: roundtrip_string(s: "plain words"), label: "roundtrip plain")
  return ()
end
