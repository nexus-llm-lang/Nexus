/**
 * An attribute value that is an expression rather than a primitive (a
 * reference like `var.x`, an operator expression like `1 + 2`) is kept as
 * HTemplate with its raw source text; a duplicate attribute in one body is
 * rejected.
 */
import * as test_assert from "std:test/assert"
import * as hcl from "std:hcl"
import { HclBody, Attribute, HclAttr, HTemplate, HNumber } from "std:hcl"

let only_value = fn (src: string) -> string throws { Exn } do
  match hcl.parse(s: src) do
    | HclBody(items: [ Attribute(attr: HclAttr(name: _, value: HTemplate(raw))) ]) -> return raw
    | _ -> return "<not a template>"
  end
end

let main = fn () -> unit throws { Exn } do
  test_assert.assert_eq_string(actual: only_value(src: "a = var.x"), expected: "var.x", label: "reference")
  test_assert.assert_eq_string(actual: only_value(src: "a = 1 + 2 # sum"), expected: "1 + 2", label: "operator expression")
  test_assert.assert_eq_string(actual: only_value(src: "a = upper(\"x\")\n"), expected: "upper(\"x\")", label: "function call")
  match hcl.parse(s: "a = 1") do
    | HclBody(items: [ Attribute(attr: HclAttr(name: _, value: HNumber(val))) ]) -> test_assert.assert(cond: val ==. 1.0, label: "number stays a number")
    | _ -> test_assert.assert(cond: false, label: "number stays a number")
  end
  try
    let b = hcl.parse(s: "a = 1\na = 2")
    test_assert.assert(cond: false, label: "duplicate attribute rejected")
  catch e -> ()
  end
  try
    let b = hcl.parse(s: "a = \"unterminated")
    test_assert.assert(cond: false, label: "unterminated string still rejected")
  catch e -> ()
  end
  return ()
end
