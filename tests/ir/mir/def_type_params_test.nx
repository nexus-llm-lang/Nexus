// unit-test
// `src/ir/mir/type_params.nx::enum_def_params_to_vars` and
// `record_def_params_to_vars` rewrite a type definition's own type
// parameters to `TyVar` in its field types (`variants` and
// `layout_variants` for enums). Definitions without type parameters are
// returned unchanged.
import * as test_assert from "std:test/assert"
import { TypeExpr, TyUserDefined, TyVar, TyI64, EnumDef, VariantDef, VariantField, RecordDef,
         NamedType } from "src/types/type_expr.nx"
import { Some } from "std:option"
import { type_eq } from "src/typecheck/subst.nx"
import { enum_def_params_to_vars, record_def_params_to_vars } from "src/ir/mir/type_params.nx"

let a = fn () -> TypeExpr do
  return TyUserDefined(name: "A", args: [])
end

let first_field_type = fn (vs: [ VariantDef ]) -> TypeExpr do
  match vs do
    | VariantDef(name: _, fields: VariantField(name: _, typ) :: _) :: _ -> return typ
    | _ -> return TyI64
  end
end

let body = fn () -> unit throws { Exn } do
  let wrap = VariantDef(name: "Wrap", fields: [ VariantField(name: Some(val: "val"), typ: a()) ])
  let e = EnumDef(
    name: "Wrap",
    is_public: true,
    is_opaque: false,
    type_params: [ "A" ],
    variants: [ wrap ],
    layout_variants: [ wrap ],
    module: ""
  )
  let EnumDef(
    name: _,
    is_public: _,
    is_opaque: _,
    type_params: _,
    variants,
    layout_variants,
    module: _
  ) = enum_def_params_to_vars(def: e)
  test_assert.assert_true(
    cond: type_eq(a: first_field_type(vs: variants), b: TyVar(name: "A")),
    label: "enum variant field"
  )
  test_assert.assert_true(
    cond: type_eq(a: first_field_type(vs: layout_variants), b: TyVar(name: "A")),
    label: "enum layout field"
  )
  let r = RecordDef(
    name: "Box",
    is_public: true,
    type_params: [ "A" ],
    fields: [ NamedType(name: "x", typ: a()) ]
  )
  let RecordDef(name: _, is_public: _, type_params: _, fields) = record_def_params_to_vars(def: r)
  let ok = match fields do
    | NamedType(name: _, typ) :: _ -> type_eq(a: typ, b: TyVar(name: "A"))
    | [] -> false
  end
  test_assert.assert_true(cond: ok, label: "record field")
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
