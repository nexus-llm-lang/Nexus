// unit-test
// `src/ir/mir/type_params.nx::type_params_to_vars` rewrites a function's
// declared type parameters, which reach the IR as nullary
// `TyUserDefined(name)`, into `TyVar(name)`, also when nested. Other
// user-defined types and parameterised applications are left alone.
import * as test_assert from "std:test/assert"
import { TypeExpr, NamedType, TyUserDefined, TyVar, TyList, TyArrow, TyI64,
         TyRow } from "src/types/type_expr.nx"
import { None } from "std:option"
import { type_eq } from "src/typecheck/subst.nx"
import { type_params_to_vars } from "src/ir/mir/type_params.nx"

let t = fn () -> TypeExpr do
  return TyUserDefined(name: "T", args: [])
end

let empty_row = fn () -> TypeExpr do
  return TyRow(types: [], rest: None)
end

let check = fn (input: TypeExpr, expected: TypeExpr, label: string) -> unit throws { Exn } do
  let got = type_params_to_vars(typ: input, names: [ "T" ])
  test_assert.assert_true(cond: type_eq(a: got, b: expected), label)
  return ()
end

let body = fn () -> unit throws { Exn } do
  check(input: t(), expected: TyVar(name: "T"), label: "bare param")
  check(input: TyList(elem: t()), expected: TyList(elem: TyVar(name: "T")), label: "list of param")
  check(
    input: TyArrow(
      params: [ NamedType(name: "x", typ: t()) ],
      ret: t(),
      requires: empty_row(),
      throw_row: empty_row()
    ),
    expected: TyArrow(
      params: [ NamedType(name: "x", typ: TyVar(name: "T")) ],
      ret: TyVar(name: "T"),
      requires: empty_row(),
      throw_row: empty_row()
    ),
    label: "arrow over param"
  )
  check(
    input: TyUserDefined(name: "Box", args: [ t() ]),
    expected: TyUserDefined(name: "Box", args: [ TyVar(name: "T") ]),
    label: "param as type argument"
  )
  check(
    input: TyUserDefined(name: "Box", args: []),
    expected: TyUserDefined(name: "Box", args: []),
    label: "other user type untouched"
  )
  check(input: TyI64, expected: TyI64, label: "scalar untouched")
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
