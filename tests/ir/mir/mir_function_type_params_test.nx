// unit-test
// `src/ir/mir/type_params.nx::function_type_params_to_vars` rewrites type
// parameters everywhere a MIR function carries a type: parameters, return
// type, `let` annotations and call result types, including statements
// nested in `if` bodies.
import * as test_assert from "std:test/assert"
import { TypeExpr, TyUserDefined, TyVar } from "src/types/type_expr.nx"
import { Literal, LitBool } from "src/types/vocab.nx"
import { Some } from "std:option"
import { MirFunction, MirParam, MirStmt, MirStmtLet, MirStmtExpr, MirExpr, MirCall, MirIf,
         MirVariable, MirLiteral } from "src/ir/mir/types.nx"
import { Span } from "src/types/span.nx"
import { type_eq } from "src/typecheck/subst.nx"
import { function_type_params_to_vars } from "src/ir/mir/type_params.nx"

let t = fn () -> TypeExpr do
  return TyUserDefined(name: "T", args: [])
end

let is_var_t = fn (typ: TypeExpr) -> bool do
  return type_eq(a: typ, b: TyVar(name: "T"))
end

let first_param_is_var = fn (params: [ MirParam ]) -> bool do
  match params do
    | MirParam(label: _, name: _, typ) :: _ -> return is_var_t(typ)
    | [] -> return false
  end
end

let nested_let_is_var = fn (stmts: [ MirStmt ]) -> bool do
  match stmts do
    | MirStmtExpr(expr: MirIf(cond: _, then_body: MirStmtLet(name: _, typ, expr: MirCall(func: _, args: _, ret_type)) :: _, else_body: _)) :: _ ->
      return is_var_t(typ) && is_var_t(typ: ret_type)
    | _ -> return false
  end
end

let body = fn () -> unit throws { Exn } do
  let call = MirCall(func: "g", args: [], ret_type: t())
  let inner = MirStmtLet(name: "y", typ: t(), expr: call)
  let f = MirFunction(
    name: "f",
    params: [ MirParam(label: "x", name: "x", typ: t()) ],
    ret_type: t(),
    body: [
      MirStmtExpr(expr: MirIf(cond: MirLiteral(lit: LitBool(val: true)), then_body: [ inner ], else_body: Some(val: [])))
    ],
    span: Span(offset: 0, line: 1, col: 1)
  )
  let MirFunction(
    name: _,
    params,
    ret_type,
    body: stmts,
    span: _
  ) = function_type_params_to_vars(func: f, names: [ "T" ])
  test_assert.assert_true(cond: first_param_is_var(params), label: "param")
  test_assert.assert_true(cond: is_var_t(typ: ret_type), label: "return type")
  test_assert.assert_true(
    cond: nested_let_is_var(stmts),
    label: "nested let annotation and call result"
  )
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
