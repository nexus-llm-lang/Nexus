// unit-test
// `src/ir/lir/context.nx::wasm_type` types heap values as `TyPtr`.
// Lists, user-defined types, records, closures and lazy values are object
// pointers; linear and borrow wrappers unwrap to the same
// pointer. Mutable refs travel as their inner value. Type variables,
// strings and scalars keep their own types.
import * as test_assert from "std:test/assert"
import { TypeExpr, NamedType, TyPtr, TyI64, TyString, TyUnit, TyList, TyUserDefined, TyRecord,
         TyArrow, TyLazy, TyRef, TyArray, TyLinear, TyBorrow, TyVar,
         TyRow } from "src/types/type_expr.nx"
import { None } from "std:option"
import { wasm_type } from "src/ir/lir/context.nx"
import { type_eq } from "src/typecheck/subst.nx"

let empty_row = fn () -> TypeExpr do
  return TyRow(types: [], rest: None)
end

let check = fn (input: TypeExpr, expected: TypeExpr, label: string) -> unit throws { Exn } do
  test_assert.assert_true(cond: type_eq(a: wasm_type(typ: input), b: expected), label)
  return ()
end

let body = fn () -> unit throws { Exn } do
  check(input: TyList(elem: TyI64), expected: TyPtr, label: "list")
  check(input: TyUserDefined(name: "Box", args: []), expected: TyPtr, label: "user-defined")
  check(
    input: TyRecord(fields: [ NamedType(name: "a", typ: TyI64) ]),
    expected: TyPtr,
    label: "record"
  )
  check(
    input: TyArrow(params: [], ret: TyI64, requires: empty_row(), throw_row: empty_row()),
    expected: TyPtr,
    label: "closure"
  )
  check(
    input: TyLazy(inner: TyI64, require_row: empty_row(), throw_row: empty_row()),
    expected: TyPtr,
    label: "lazy"
  )
  check(input: TyRef(inner: TyI64), expected: TyI64, label: "ref is passed by value")
  check(input: TyArray(elem: TyI64), expected: TyPtr, label: "array")
  check(input: TyLinear(inner: TyList(elem: TyI64)), expected: TyPtr, label: "linear list")
  check(input: TyBorrow(inner: TyRecord(fields: [])), expected: TyPtr, label: "borrowed record")
  check(input: TyVar(name: "T"), expected: TyI64, label: "type variable")
  check(input: TyString, expected: TyString, label: "string")
  check(input: TyI64, expected: TyI64, label: "i64")
  check(input: TyUnit, expected: TyUnit, label: "unit")
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
