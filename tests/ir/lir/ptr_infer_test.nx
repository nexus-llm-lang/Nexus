// unit-test
// `src/ir/lir/ptr_infer.nx::infer_ptr_locals` retypes a local `let` as
// `TyPtr` when its value is read as an object (field or tag read), and
// propagates that through plain copies in both directions. Uses of the
// retyped names carry `TyPtr`. Scalars and parameters are left alone.
import * as test_assert from "std:test/assert"
import { TyI64, TyPtr, TypeExpr } from "src/types/type_expr.nx"
import { LirFunction, LirStmt, LirStmtLet, LirExprAtom, LirExprCall, LirExprObjectTag,
         LirExprBinary, LirAtom, LirAtomVar, LirAtomInt, LirParam } from "src/ir/lir/types.nx"
import { OpAdd } from "src/types/vocab.nx"
import { Span } from "src/types/span.nx"
import { type_eq } from "src/typecheck/subst.nx"
import { infer_ptr_locals } from "src/ir/lir/ptr_infer.nx"

let v = fn (name: string) -> LirAtom do
  return LirAtomVar(name, typ: TyI64)
end

let let_type = fn (stmts: [ LirStmt ], name: string) -> TypeExpr do
  match stmts do
    | [] -> return TyI64
    | LirStmtLet(name: n, typ, expr: _) :: rest ->
      if n == name then return typ end
      return let_type(stmts: rest, name)
    | _ :: rest -> return let_type(stmts: rest, name)
  end
end

let tag_target_type = fn (stmts: [ LirStmt ]) -> TypeExpr do
  match stmts do
    | [] -> return TyI64
    | LirStmtLet(
      name: _,
      typ: _,
      expr: LirExprObjectTag(value: LirAtomVar(name: _, typ), typ: _)
    ) :: _ ->
      return typ
    | _ :: rest -> return tag_target_type(stmts: rest)
  end
end

let is_ptr = fn (t: TypeExpr) -> bool do
  return type_eq(a: t, b: TyPtr)
end

let body = fn () -> unit throws { Exn } do
  let f = LirFunction(
    name: "f",
    params: [ LirParam(label: "p", name: "p", typ: TyI64) ],
    ret_type: TyI64,
    body: [
      LirStmtLet(name: "x", typ: TyI64, expr: LirExprCall(func: "g", args: [], typ: TyI64)),
      LirStmtLet(name: "y", typ: TyI64, expr: LirExprAtom(atom: v(name: "x"))),
      LirStmtLet(name: "z", typ: TyI64, expr: LirExprAtom(atom: v(name: "y"))),
      LirStmtLet(name: "t", typ: TyI64, expr: LirExprObjectTag(value: v(name: "y"), typ: TyI64)),
      LirStmtLet(
        name: "n",
        typ: TyI64,
        expr: LirExprBinary(op: OpAdd, lhs: v(name: "p"), rhs: LirAtomInt(val: 1), typ: TyI64)
      )
    ],
    ret: v(name: "t"),
    span: Span(offset: 0, line: 1, col: 1)
  )
  let LirFunction(
    name: _,
    params: _,
    ret_type: _,
    body: stmts,
    ret: _,
    span: _
  ) = infer_ptr_locals(func: f)
  test_assert.assert_true(cond: is_ptr(t: let_type(stmts, name: "y")), label: "read object")
  test_assert.assert_true(cond: is_ptr(t: let_type(stmts, name: "x")), label: "copied from")
  test_assert.assert_true(cond: is_ptr(t: let_type(stmts, name: "z")), label: "copied to")
  test_assert.assert_true(cond: is_ptr(t: tag_target_type(stmts)), label: "use site atom")
  test_assert.assert_false(
    cond: is_ptr(t: let_type(stmts, name: "t")),
    label: "tag result stays scalar"
  )
  test_assert.assert_false(
    cond: is_ptr(t: let_type(stmts, name: "n")),
    label: "arithmetic stays scalar"
  )
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
