// unit-test
// `src/ir/lir/repr_check.nx::check_repr` reports heap-allocating LIR
// bindings whose recorded type is the scalar `i64` instead of `TyPtr`,
// including bindings nested inside `if` bodies.
import * as test_assert from "std:test/assert"
import * as list from "std:list"
import { TyI64, TyPtr, TypeExpr } from "src/types/type_expr.nx"
import { LirProgram, LirFunction, LirStmt, LirStmtLet, LirStmtIf, LirExprRecord,
         LirExprAtom, LirAtomBool, LirAtomInt, LirAtomUnit } from "src/ir/lir/types.nx"
import { Span } from "src/types/span.nx"
import { check_repr } from "src/ir/lir/repr_check.nx"

let program_of = fn (stmts: [ LirStmt ]) -> LirProgram do
  let f = LirFunction(
    name: "f",
    params: [],
    ret_type: TyI64,
    body: stmts,
    ret: LirAtomUnit,
    span: Span(offset: 0, line: 1, col: 1)
  )
  return LirProgram(functions: [ f ], externals: [])
end

let record_let = fn (typ: TypeExpr) -> LirStmt do
  return LirStmtLet(name: "x", typ, expr: LirExprRecord(fields: [], typ))
end

let body = fn () -> unit throws { Exn } do
  test_assert.assert_eq_i64(
    actual: list.length(xs: check_repr(program: program_of(stmts: [ record_let(typ: TyI64) ]))),
    expected: 1,
    label: "record typed i64 is reported"
  )
  test_assert.assert_eq_i64(
    actual: list.length(xs: check_repr(program: program_of(stmts: [ record_let(typ: TyPtr) ]))),
    expected: 0,
    label: "record typed ptr is clean"
  )
  let nested = LirStmtIf(
    cond: LirAtomBool(val: true),
    then_body: [ record_let(typ: TyI64) ],
    else_body: []
  )
  test_assert.assert_eq_i64(
    actual: list.length(xs: check_repr(program: program_of(stmts: [ nested ]))),
    expected: 1,
    label: "nested record typed i64 is reported"
  )
  let scalar = LirStmtLet(name: "n", typ: TyI64, expr: LirExprAtom(atom: LirAtomInt(val: 1)))
  test_assert.assert_eq_i64(
    actual: list.length(xs: check_repr(program: program_of(stmts: [ scalar ]))),
    expected: 0,
    label: "scalar i64 is clean"
  )
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
