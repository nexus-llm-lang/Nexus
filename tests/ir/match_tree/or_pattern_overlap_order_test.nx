// An or-pattern arm whose later alternative overlaps a later arm keeps its
// source position: `U(name: "List")` takes the first arm.
import * as ta from "std:test/assert"

type T = U(name: string) | L(e: i64)

let classify = fn (t: T) -> i64 do
  match t do
    | L(_) | U(name: "List") -> return 1
    | U(name: _) -> return 2
  end
end

let body = fn () -> unit throws { Exn } do
  ta.assert_eq_i64(
    actual: classify(t: U(name: "List")),
    expected: 1,
    label: "or-pattern alternative wins"
  )
  ta.assert_eq_i64(actual: classify(t: U(name: "Other")), expected: 2, label: "later arm")
  ta.assert_eq_i64(actual: classify(t: L(e: 0)), expected: 1, label: "first alternative")
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
