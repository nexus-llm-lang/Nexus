// Runtime fixture for `src/ir/lir/match_tree.nx`: string-literal switch,
// record fields mixing a literal and a binder, a pair nested inside an enum
// payload, a wildcard-only match, and several constructors sharing one
// default arm.
import * as ta from "std:test/assert"
import { Pair } from "std:tuple"

type Shape = Circle(r: i64) | Square(s: i64) | Tri(
  a: i64,
  b: i64
) | Dot | Wrapped(p: Pair<i64, i64>)

let keyword = fn (s: string) -> i64 do
  match s do
    | "let" -> return 1
    | "fn" -> return 2
    | "" -> return 3
    | "let " -> return 4
    | _ -> return 0
  end
end

let pick = fn (r: { x: i64, y: i64 }) -> i64 do
  match r do
    | { x: 1, y } -> return y
    | { x: 2, y: 5 } -> return 100
    | { x, y: _ } -> return 0 - x
  end
end

let area = fn (sh: Shape) -> i64 do
  match sh do
    | Square(s) -> return s * s
    | Wrapped(p: Pair(left: 0, right)) -> return right
    | Wrapped(p: Pair(left, right: _)) -> return left
    | _ -> return 0 - 1
  end
end

let always = fn (sh: Shape) -> i64 do
  match sh do
    | _ -> return 7
  end
end

let body = fn () -> unit throws { Exn } do
  ta.assert_eq_i64(actual: keyword(s: "let"), expected: 1, label: "str let")
  ta.assert_eq_i64(actual: keyword(s: "fn"), expected: 2, label: "str fn")
  ta.assert_eq_i64(actual: keyword(s: ""), expected: 3, label: "str empty")
  ta.assert_eq_i64(actual: keyword(s: "let "), expected: 4, label: "str prefix-distinct")
  ta.assert_eq_i64(actual: keyword(s: "le"), expected: 0, label: "str default")
  ta.assert_eq_i64(actual: pick(r: { x: 1, y: 9 }), expected: 9, label: "record lit+binder")
  ta.assert_eq_i64(actual: pick(r: { x: 2, y: 5 }), expected: 100, label: "record two lits")
  ta.assert_eq_i64(
    actual: pick(r: { x: 2, y: 6 }),
    expected: -2,
    label: "record lit miss falls to binder"
  )
  ta.assert_eq_i64(actual: area(sh: Square(s: 3)), expected: 9, label: "ctor arm")
  ta.assert_eq_i64(
    actual: area(sh: Wrapped(p: Pair(left: 0, right: 8))),
    expected: 8,
    label: "pair in enum lit"
  )
  ta.assert_eq_i64(
    actual: area(sh: Wrapped(p: Pair(left: 4, right: 8))),
    expected: 4,
    label: "pair in enum binder"
  )
  ta.assert_eq_i64(actual: area(sh: Circle(r: 2)), expected: -1, label: "shared default circle")
  ta.assert_eq_i64(actual: area(sh: Tri(a: 1, b: 2)), expected: -1, label: "shared default tri")
  ta.assert_eq_i64(actual: area(sh: Dot), expected: -1, label: "shared default nullary")
  ta.assert_eq_i64(actual: always(sh: Dot), expected: 7, label: "wildcard only")
  return ()
end

let main = fn () -> unit throws { Exn } do
  body()
  return ()
end
