// std:concurrency/async_io.force_all in a --p3-component build forces each
// thunk in its own cooperative task: three thunks that each Clock.sleep(600)
// under clock_handler finish together (well under 1800 ms), and the results
// keep input order.
import { Clock }, * as clock from "std:clock"
import { scheduler } from "std:concurrency/coop"
import * as aio from "std:concurrency/async_io"
import * as test_assert from "std:test/assert"

let nap = fn (v: i64) -> i64 require { Clock } do
  Clock.sleep(ms: 600)
  return v
end

let main = fn () -> unit require { PermClock } throws { Exn } do
  inject clock.system_handler do
    let t0 = Clock.now()
    let xs = inject scheduler do
      inject aio.clock_handler do
        let @a = nap(v: 1)
        let @b = nap(v: 2)
        let @c = nap(v: 3)
        aio.force_all(tasks: [ a, b, c ])
      end
    end
    let elapsed = Clock.now() - t0
    test_assert.assert_eq_i64_list(actual: xs, expected: [ 1, 2, 3 ], label: "input order")
    1 / (if elapsed >= 600 && elapsed < 1500 then 1 else 0 end)
  end
  return ()
end
