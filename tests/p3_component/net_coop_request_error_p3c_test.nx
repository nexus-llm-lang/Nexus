// p3c-http
// Requests through std:network.coop_handler in a p3 component build, from
// two cooperative tasks, to a host under the reserved `.invalid` TLD (which
// never resolves): the request is built (method, headers, body stream), sent
// through wasi:http/client@0.3.0, and each task observes RequestError.
import { Header, Net, RequestError }, * as net_mod from "std:network"
import { scheduler, spawn } from "std:concurrency/coop"

let get_fails = fn () -> i64 require { Net } do
  try
    let _ignored = Net.get(url: "http://nexus-test.invalid/")
    return 0
  catch
    | RequestError(url: _) -> return 1
  end
end

let post_fails = fn () -> i64 require { Net } do
  try
    let _ignored = Net.request(
      method: "POST",
      url: "https://nexus-test.invalid/post",
      headers: [ Header(name: "x-nexus", value: "p3") ],
      body: "payload"
    )
    return 0
  catch
    | RequestError(url: _) -> return 1
  end
end

let main = fn () -> unit require { PermNet } do
  inject scheduler do
    inject net_mod.coop_handler do
      spawn(task: fn () -> unit require { Net } do
        1 / get_fails()
        return ()
      end)
      1 / post_fails()
    end
  end
  return ()
end
