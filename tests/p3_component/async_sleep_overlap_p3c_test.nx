// Two cooperative tasks each sleep 1000 ms with std:concurrency/async_io in a
// --p3-component build; the sleeps overlap, so both finish in well under 2000 ms.
import { Clock }, * as clock from "std:clock"
import { Coop, scheduler, spawn } from "std:concurrency/coop"
import * as aio from "std:concurrency/async_io"

let body = fn () -> i64 require { Clock } do
  let t0 = Clock.now()
  inject scheduler do
    spawn(task: fn () -> unit require { Coop } do
      aio.sleep(ms: 1000)
      return ()
    end)
    aio.sleep(ms: 1000)
  end
  return Clock.now() - t0
end

let main = fn () -> unit require { PermClock } do
  inject clock.system_handler do
    let elapsed = body()
    1 / (if elapsed >= 1000 && elapsed < 1800 then 1 else 0 end)
  end
  return ()
end
