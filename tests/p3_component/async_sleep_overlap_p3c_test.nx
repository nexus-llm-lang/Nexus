// Two cooperative tasks each call Clock.sleep(1000) under
// std:concurrency/async_io's clock_handler in a p3 component build; the
// sleeps overlap, so both finish in well under 2000 ms.
import { Clock }, * as clock from "std:clock"
import { scheduler, spawn } from "std:concurrency/coop"
import * as aio from "std:concurrency/async_io"

let main = fn () -> unit require { PermClock } do
  inject clock.system_handler do
    let t0 = Clock.now()
    inject scheduler do
      inject aio.clock_handler do
        spawn(task: fn () -> unit require { Clock } do
          Clock.sleep(ms: 1000)
          return ()
        end)
        Clock.sleep(ms: 1000)
      end
    end
    let elapsed = Clock.now() - t0
    1 / (if elapsed >= 1000 && elapsed < 1800 then 1 else 0 end)
  end
  return ()
end
